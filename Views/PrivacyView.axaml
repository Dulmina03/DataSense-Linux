<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.PrivacyView"
             x:DataType="vm:PrivacyViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="🛡️ Privacy &amp; Data Lifecycle Management" Classes="PageTitle"/>
                <TextBlock Text="DataSense keeps network telemetry strictly on this computer." Classes="BodySecondary"/>
            </StackPanel>

            <!-- 1. Local Data Policy -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="🔒 Local-First Policy &amp; Storage" Classes="SectionTitle" Foreground="{DynamicResource Brush.Download}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <TextBlock Text="Your network usage history is stored locally in the DataSense SQLite database. DataSense operates 100% locally without cloud synchronization, remote tracking, account systems, or telemetry uploads." Classes="Caption" TextWrapping="Wrap"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Database Path" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DbPath}" Classes="Caption" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                            <TextBlock Text="Database Size" Classes="Caption" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding DbSizeText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. External Network Access Transparency -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="🌐 External Network Access Transparency" Classes="SectionTitle" Foreground="{DynamicResource Brush.Warning}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <TextBlock Text="DataSense contacts only external endpoints explicitly initiated by you for speed testing:" Classes="Caption"/>

                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12">
                        <Grid ColumnDefinitions="140,*,180">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Service" Classes="Caption" FontWeight="Bold"/>
                                <TextBlock Text="Cloudflare CDN" Classes="Body" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Purpose" Classes="Caption" FontWeight="Bold"/>
                                <TextBlock Text="Internet speed testing (latency, download, upload)" Classes="Caption"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock Text="When Used" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="Only when you click 'Start Test'" Classes="Caption" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. System Privileges & Security -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="🔑 System Privileges &amp; Elevated Access" Classes="SectionTitle" Foreground="{DynamicResource Brush.Accent}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
                            <TextBlock Text="Interface &amp; Session Monitoring" Classes="Body" FontWeight="SemiBold"/>
                            <TextBlock Text="Reads system counters from /proc/net/dev and /proc/net/route. Runs under standard user permissions without root." Classes="Caption" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0">
                            <TextBlock Text="Per-Process Traffic Monitoring (nethogs)" Classes="Body" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProcessCapabilityNotice}" Classes="Caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3.5 Session Timeline Storage -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="⏱️ Session Timeline &amp; Intelligence" Classes="SectionTitle" Foreground="{DynamicResource Brush.Download}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <TextBlock Text="{Binding SessionTimelineDisclosure}" Classes="Caption" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 3.6 Application Intelligence -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="🧠 Application Historical Intelligence" Classes="SectionTitle" Foreground="{DynamicResource Brush.Upload}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <TextBlock Text="{Binding ApplicationIntelligenceDisclosure}" Classes="Caption" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 4. Data Lifecycle & Retention -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="🧹 Data Lifecycle &amp; Retention Settings" Classes="SectionTitle" Foreground="{DynamicResource Brush.Danger}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Automatic Purge Threshold (Days)" Classes="Body" FontWeight="SemiBold"/>
                            <TextBlock Text="Remove raw telemetry records older than the selected retention period." Classes="Caption"/>
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Value="{Binding RetentionDays}" Minimum="7" Maximum="365" Increment="7" Width="140" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Purge Old Telemetry Now" Command="{Binding PurgeOldDataCommand}" IsEnabled="{Binding !IsPurging}" Classes="Primary" Background="{DynamicResource Brush.Danger}" Foreground="{DynamicResource Brush.Surface}"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" Classes="Caption" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
