<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             xmlns:m="using:DataSense.Models"
             x:Class="DataSense.Views.UnifiedIntelligenceView"
             x:DataType="vm:UnifiedIntelligenceViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- Header -->
            <Border Classes="CardElevated">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.SM}">
                        <TextBlock Text="Unified Intelligence Center" Classes="PageTitle"/>
                        <TextBlock Text="Cross-domain deterministic correlations across your applications and networks." Classes="BodySecondary"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh Analysis" Command="{Binding RefreshDataCommand}" Classes="Secondary" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Loading State -->
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" Margin="0,10" Foreground="{DynamicResource Brush.Accent}"/>

            <!-- System Summary -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="Current System Status" Classes="SectionTitle"/>
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Intelligence Engine" Classes="Caption"/>
                            <TextBlock Text="{Binding SystemSummary.OverallIntelligenceStatus}" Classes="Body" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Today's Top App" Classes="Caption"/>
                            <TextBlock Text="{Binding SystemSummary.TodayTopApplication}" Classes="Body" Foreground="{DynamicResource Brush.Download}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Current Network" Classes="Caption"/>
                            <TextBlock Text="{Binding SystemSummary.CurrentNetwork}" Classes="Body" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Total Usage Today" Classes="Caption"/>
                            <TextBlock Text="{Binding SystemSummary.TodayTotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Filters -->
            <Border Classes="Card">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Category" Classes="Caption"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Width="150"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Severity" Classes="Caption"/>
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding SeverityFilter}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding FilteredInsights.Count, StringFormat='{}{0} Insights Found'}" Classes="Caption" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Insights List -->
            <ItemsControl ItemsSource="{Binding FilteredInsights}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="Card" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Severity Indicator -->
                                <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0" Background="{Binding Severity, Converter={x:Static conv:UnifiedInsightSeverityColorConverter.Instance}}"/>
                                
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <!-- Title & Meta -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="Bold"/>
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                    
                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}" Classes="Caption" TextWrapping="Wrap"/>
                                    
                                    <!-- Evidence Box -->
                                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12" Margin="0,4,0,0" IsVisible="{Binding Evidence.Count}">
                                        <StackPanel>
                                            <TextBlock Text="Supporting Evidence" Classes="Caption" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Classes="Caption" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Recommended Action -->
                                <StackPanel Grid.Column="2" MaxWidth="250" Margin="16,0,0,0" Spacing="4">
                                    <TextBlock Text="Recommended Action" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RecommendedAction}" Classes="Caption" Foreground="{DynamicResource Brush.Success}" TextWrapping="Wrap" HorizontalAlignment="Right" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding Confidence, StringFormat='{}Confidence: {0}'}" Classes="Caption" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- Empty State -->
            <StackPanel Classes="EmptyState" IsVisible="{Binding !FilteredInsights.Count}">
                <TextBlock Text="No insights found matching the current filters." Classes="EmptyStateTitle"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
