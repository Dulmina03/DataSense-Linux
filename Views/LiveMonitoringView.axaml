<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:m="using:DataSense.Models"
             xmlns:s="using:DataSense.Services"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.LiveMonitoringView"
             x:DataType="vm:LiveMonitoringViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER & NAVIGATION TITLE ──────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <TextBlock Text="Live Network Traffic" Classes="PageTitle"/>
                        <TextBlock Text="Real-time interface bandwidth, socket processes, and link statistics." Classes="BodySecondary"/>
                    </StackPanel>

                    <!-- Status & Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                        <Border Classes="StatusPill" Padding="12,8" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MonitoringStatusText}" Classes="Caption" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding TogglePauseResumeCommand}" Classes="Secondary">
                            <TextBlock Text="{Binding IsPaused, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='Pause'}"/>
                        </Button>
                        <Button Command="{Binding ExportSnapshotCommand}" Classes="Ghost" Content="Export Snapshot" />
                    </StackPanel>
                </Grid>

                <!-- ── REAL-TIME NETWORK OVERVIEW ────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">

                        <!-- Row 0: Network Info -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" Margin="0,0,0,32">
                            <TextBlock Text="{Binding CurrentNetworkName}" Classes="PageTitle" TextTrimming="CharacterEllipsis"/>
                            <Border Classes="StatusPill" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionType}" Classes="Caption" Foreground="{DynamicResource Brush.Download}" FontWeight="Bold"/>
                            </Border>
                            <Border Classes="StatusPill" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InterfaceName}" Classes="Caption" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Row 1: Metrics -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,48,0">
                            <TextBlock Text="COMBINED BANDWIDTH" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CombinedSpeed}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Accent}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,48,0">
                            <TextBlock Text="LIVE DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LiveDownloadSpeed}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,48,0">
                            <TextBlock Text="LIVE UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LiveUploadSpeed}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="PACKET HEALTH" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="{Binding PacketErrorRateText, StringFormat='Err: {0}'}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Danger}"/>
                                <TextBlock Text="{Binding PacketDropRateText, StringFormat='Drop: {0}'}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Warning}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── PROCESS BREAKDOWN & DETAIL GRID ─────────────────────────────────── -->
                <Grid ColumnDefinitions="3*,48,2*">

                    <!-- Left: Process Traffic Ranking Table -->
                    <Border Grid.Column="0" Classes="AnalyticsSurface" Padding="0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16">
                                <TextBlock Grid.Column="0" Text="TOP PROCESS CONSUMERS" Classes="PanelTitle" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestTotal" Classes="Ghost" Content="Total" />
                                    <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestDownload" Classes="Ghost" Content="↓ DL" />
                                    <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestUpload" Classes="Ghost" Content="↑ UL" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                                <Grid ColumnDefinitions="2*,70,*,*,*,70">
                                    <TextBlock Grid.Column="0" Text="PROCESS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="PID" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="2" Text="DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="TOTAL" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="SHARE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" Height="340" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RankedProcesses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="s:LiveProcessRankItem">
                                            <Button Command="{Binding $parent[UserControl].((vm:LiveMonitoringViewModel)DataContext).SelectProcessCommand}" CommandParameter="{Binding}" Classes="Ghost" HorizontalAlignment="Stretch" Padding="0">
                                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                                    <Grid ColumnDefinitions="2*,70,*,*,*,70">
                                                        <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Pid}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding DownloadRateText}" Classes="Body" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding UploadRateText}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CombinedRateText}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding PercentageOfTotalTraffic, StringFormat='{}{0:F1}%'}" Classes="BodySecondary" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Process Traffic Detail Card -->
                    <Border Grid.Column="2" Classes="MetricSurface" VerticalAlignment="Top">
                        <StackPanel Spacing="{DynamicResource Spacing.LG}">
                            <TextBlock Text="PROCESS DETAILS" Classes="PanelTitle" />

                            <StackPanel Spacing="4" Margin="0,0,0,16">
                                <TextBlock Text="{Binding DetailProcessName}" Classes="Metric" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{Binding DetailPidText, StringFormat='PID: {0}'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailExePath}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="User:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailUser}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Data Source:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailDataSource}" Classes="Body" Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Today:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailTodayUsage}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="7 Days:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail7DayUsage}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="30 Days:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail30DayUsage}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── INTERFACE COMPARISON & QUALITY DATA TABLE ───────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <TextBlock Text="NETWORK INTERFACES" Classes="PanelTitle" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                            <Grid ColumnDefinitions="120,100,80,130,150,100,100,80,80">
                                <TextBlock Grid.Column="0" Text="INTERFACE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="TYPE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="STATE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="3" Text="IPv4" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="4" Text="MAC" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="5" Text="ERRORS (RX/TX)" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="DROPS (RX/TX)" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="ERR RATE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="DROP RATE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" Height="180" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllInterfaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="s:NetworkInterfaceStats">
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                            <Grid ColumnDefinitions="120,100,80,130,150,100,100,80,80">
                                                <TextBlock Grid.Column="0" Text="{Binding InterfaceName}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding State}" Classes="Body" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding IPv4Address}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding MacAddress}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding RxErrors, StringFormat='{}{0}'}" Classes="Body" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="6" Text="{Binding RxDropped, StringFormat='{}{0}'}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="7" Text="{Binding PacketErrorRatePercentage, StringFormat='{}{0:F2}%'}" Classes="Body" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="8" Text="{Binding PacketDropRatePercentage, StringFormat='{}{0:F2}%'}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
