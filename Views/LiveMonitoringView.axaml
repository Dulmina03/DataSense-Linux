<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:m="using:DataSense.Models"
             xmlns:s="using:DataSense.Services"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.LiveMonitoringView"
             x:DataType="vm:LiveMonitoringViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">

            <!-- ── HEADER & NAVIGATION TITLE ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.SM}">
                    <TextBlock Text="Live Network Traffic" Classes="PageTitle"/>
                    <TextBlock Text="Real-time interface bandwidth, socket processes, and link statistics" Classes="BodySecondary"/>
                </StackPanel>

                <!-- Status & Pause/Resume Control -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                    <Border Classes="Badge">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitoringStatusText}" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding TogglePauseResumeCommand}" Classes="Primary">
                        <TextBlock Text="{Binding IsPaused, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue='Pause'}"/>
                    </Button>
                    <Button Command="{Binding ExportSnapshotCommand}" Classes="Secondary" Content="📷 Snapshot" />
                </StackPanel>
            </Grid>

            <!-- ── REAL-TIME NETWORK OVERVIEW CARDS ────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Card 1: Network & Connection -->
                <Border Grid.Column="0" Classes="CardElevated" Margin="0,0,16,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Current Network" Classes="Caption" />
                        <TextBlock Text="{Binding CurrentNetworkName}" Classes="MetricSmall" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="Badge">
                                <TextBlock Text="{Binding ConnectionType}" />
                            </Border>
                            <Border Classes="Badge">
                                <TextBlock Text="{Binding InterfaceName}" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Live Download -->
                <Border Grid.Column="1" Classes="Card" Margin="0,0,16,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="↓ Live Download" Classes="Caption" Foreground="{DynamicResource Brush.Download}" />
                        <TextBlock Text="{Binding LiveDownloadSpeed}" Classes="MetricLarge" Foreground="{DynamicResource Brush.Download}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Live Upload -->
                <Border Grid.Column="2" Classes="Card" Margin="0,0,16,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="↑ Live Upload" Classes="Caption" Foreground="{DynamicResource Brush.Upload}" />
                        <TextBlock Text="{Binding LiveUploadSpeed}" Classes="MetricLarge" Foreground="{DynamicResource Brush.Upload}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Combined Speed & Packets -->
                <Border Grid.Column="3" Classes="Card">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="⚡ Combined Bandwidth" Classes="Caption" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding CombinedSpeed}" Classes="MetricLarge"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding PacketErrorRateText, StringFormat='Err: {0}'}" Classes="Caption" Foreground="{DynamicResource Brush.Danger}"/>
                            <TextBlock Text="{Binding PacketDropRateText, StringFormat='Drop: {0}'}" Classes="Caption" Foreground="{DynamicResource Brush.Warning}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── PROCESS BREAKDOWN & DETAIL GRID ─────────────────────────────────── -->
            <Grid ColumnDefinitions="2*,*">
                <!-- Left: Process Traffic Ranking Table -->
                <Border Grid.Column="0" Classes="Card" Margin="0,0,16,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Top Process Data Consumers" Classes="SectionTitle" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestTotal" Classes="Secondary" Content="Total" />
                                <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestDownload" Classes="Secondary" Content="↓ DL" />
                                <Button Command="{Binding SelectSortModeCommand}" CommandParameter="HighestUpload" Classes="Secondary" Content="↑ UL" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8">
                            <Grid ColumnDefinitions="2*,70,*,*,*,70">
                                <TextBlock Grid.Column="0" Text="Process Name" Classes="Caption" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="PID" Classes="Caption" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="↓ Download" Classes="Caption" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="↑ Upload" Classes="Caption" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Total" Classes="Caption" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="5" Text="Share" Classes="Caption" FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RankedProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="s:LiveProcessRankItem">
                                        <Button Command="{Binding $parent[UserControl].((vm:LiveMonitoringViewModel)DataContext).SelectProcessCommand}" CommandParameter="{Binding}" Classes="Icon" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                                                <Grid ColumnDefinitions="2*,70,*,*,*,70">
                                                    <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Pid}" Classes="Caption" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DownloadRateText}" Classes="Body" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding UploadRateText}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding CombinedRateText}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding PercentageOfTotalTraffic, StringFormat='{}{0:F1}%'}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Right: Selected Process Traffic Detail Card -->
                <Border Grid.Column="1" Classes="Card">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Process Details" Classes="SectionTitle" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding DetailProcessName}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{Binding DetailPidText, StringFormat='PID: {0}'}" Classes="Caption" />
                        </StackPanel>
                        <Separator Background="{DynamicResource Brush.Border}" Margin="0,8"/>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Executable:" Classes="Caption" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailExePath}" Classes="Body" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="User:" Classes="Caption" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailUser}" Classes="Body" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Data Source:" Classes="Caption" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailDataSource}" Classes="Body" Foreground="{DynamicResource Brush.Success}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Today:" Classes="Caption" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailTodayUsage}" Classes="Body" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="7 Days:" Classes="Caption" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Detail7DayUsage}" Classes="Body" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="30 Days:" Classes="Caption" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Detail30DayUsage}" Classes="Body"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── INTERFACE COMPARISON & QUALITY DATA TABLE ───────────────────────── -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="Network Interfaces" Classes="SectionTitle" />
                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8">
                        <Grid ColumnDefinitions="120,100,80,130,150,100,100,80,80">
                            <TextBlock Grid.Column="0" Text="Interface" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Type" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="State" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="IPv4 Address" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="MAC Address" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Errors (RX/TX)" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="6" Text="Drops (RX/TX)" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="7" Text="Err Rate" Classes="Caption" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="8" Text="Drop Rate" Classes="Caption" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllInterfaces}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="s:NetworkInterfaceStats">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="120,100,80,130,150,100,100,80,80">
                                            <TextBlock Grid.Column="0" Text="{Binding InterfaceName}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding State}" Classes="Body" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding IPv4Address}" Classes="Body" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding MacAddress}" Classes="Caption" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding RxErrors, StringFormat='{}{0}'}" Classes="Body" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="{Binding RxDropped, StringFormat='{}{0}'}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="7" Text="{Binding PacketErrorRatePercentage, StringFormat='{}{0:F2}%'}" Classes="Body" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="8" Text="{Binding PacketDropRatePercentage, StringFormat='{}{0:F2}%'}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
