<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
    <!-- Use Margin on Grid instead of Padding (Grid does not have Padding) -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16" Background="#121212">
        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Spacing="12" Grid.Row="0">
            <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedPreset}" Width="150"/>
            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" Width="150"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <!-- Summary Cards -->
        <StackPanel Orientation="Horizontal" Spacing="24" Grid.Row="1" Margin="0,16,0,8">
            <Border Background="#1A1A1A" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Downloaded" Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding TotalDownloadedText}" FontSize="14" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
            <Border Background="#1A1A1A" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Total Uploaded" Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding TotalUploadedText}" FontSize="14" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
            <Border Background="#1A1A1A" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Peak Download Speed" Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding PeakDownloadSpeedText}" FontSize="14" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
            <Border Background="#1A1A1A" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="Samples" Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding SampleCountText}" FontSize="14" Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Data List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- ItemsControl can bind to an ObservableCollection via the Items property -->
            <ItemsControl ItemsSource="{Binding Records}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:HistoryItemViewModel">
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="8" Margin="0,4,0,4">
                            <Grid ColumnDefinitions="200,100,100,100,100,100">
                                <TextBlock Text="{Binding TimestampText}" Grid.Column="0" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding InterfaceName}" Grid.Column="1" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding DownloadSpeedText}" Grid.Column="2" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding UploadSpeedText}" Grid.Column="3" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding TotalDownloadedText}" Grid.Column="4" Foreground="#CCCCCC"/>
                                <TextBlock Text="{Binding TotalUploadedText}" Grid.Column="5" Foreground="#CCCCCC"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading overlay -->
        <Border Background="#80000000" IsVisible="{Binding IsLoading}" Grid.RowSpan="3">
            <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16"/>
        </Border>
    </Grid>
</UserControl>
