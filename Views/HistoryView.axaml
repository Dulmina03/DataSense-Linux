<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             Background="{DynamicResource Brush.AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.AppBackground}">
        <StackPanel Spacing="28" Margin="24">

            <!-- ── 1. PAGE HEADER & GLOBAL CONTROLS ──────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Usage History" Classes="PageTitle"/>
                    <TextBlock Text="Historical network usage &amp; application insights" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>

                <!-- Right: Search Box, Interface Filter, and Refresh -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <!-- Search Box -->
                    <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <TextBox Width="200"
                                 Classes="Secondary"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Watermark="Search apps or networks…"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Border>

                    <!-- Interface Filter -->
                    <ComboBox ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface}"
                              MinWidth="110"
                              Classes="Secondary"
                              VerticalAlignment="Center"/>

                    <!-- Refresh Button -->
                    <Button Command="{Binding RefreshCommand}"
                            Classes="Secondary"
                            Padding="10,6"
                            ToolTip.Tip="Refresh historical telemetry"
                            VerticalAlignment="Center">
                        <TextBlock Text="⟳" Classes="Body" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── 2. GLOBAL PERIOD CONTROL ([TODAY] [7 DAYS] [MONTH ▾]) ─────────────────── -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="8,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Segmented Period Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <Button Classes="Segment"
                                Classes.active="{Binding IsTodayActive}"
                                Command="{Binding SelectTodayCommand}"
                                Padding="20,10"
                                CornerRadius="8">
                            <TextBlock Text="TODAY" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>

                        <Button Classes="Segment"
                                Classes.active="{Binding Is7DaysActive}"
                                Command="{Binding SelectLast7DaysCommand}"
                                Padding="20,10"
                                CornerRadius="8">
                            <TextBlock Text="7 DAYS" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>

                        <Button Classes="Segment"
                                Classes.active="{Binding IsMonthActive}"
                                Command="{Binding SelectMonthCommand}"
                                Padding="20,10"
                                CornerRadius="8">
                            <TextBlock Text="MONTH ▾" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Month Selection Dropdown (Only shown when MONTH is active) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsMonthActive}">
                        <TextBlock Text="Select Month:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  MinWidth="180"
                                  Classes="Secondary"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 3. USAGE OVERVIEW (4 CLEAN METRIC SURFACES) ────────────────────────────── -->
            <StackPanel Spacing="12">
                <TextBlock Text="USAGE OVERVIEW" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>

                <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                    <!-- 1. TOTAL USAGE (Ambient Purple Glow Card) -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.HeroUsageGradient}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="TOTAL USAGE" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="PERIOD" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TotalUsageText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,2"/>

                            <TextBlock Text="{Binding TotalUsageTrendText}" Classes="Caption" FontWeight="SemiBold" Foreground="{Binding TotalUsageTrendColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. DOWNLOAD (Electric Violet Glow Card) -->
                    <Border Grid.Column="2" Background="{DynamicResource Brush.HeroDownloadGradient}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Path Data="M 7 2 L 7 9 M 4 6.5 L 7 9.5 L 10 6.5 M 2.5 10.5 L 2.5 12 C 2.5 12.5 3 13 3.5 13 L 10.5 13 C 11 13 11.5 12.5 11.5 12 L 11.5 10.5" Width="13" Height="13" Stroke="{DynamicResource Brush.Download}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                    <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="DOWN" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TotalDownloadedText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" Margin="0,2"/>

                            <TextBlock Text="{Binding DownloadShareText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. UPLOAD (Electric Cyan Glow Card) -->
                    <Border Grid.Column="4" Background="{DynamicResource Brush.HeroUploadGradient}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Path Data="M 7 9.5 L 7 2.5 M 4 5 L 7 2 L 10 5 M 2.5 10.5 L 2.5 12 C 2.5 12.5 3 13 3.5 13 L 10.5 13 C 11 13 11.5 12.5 11.5 12 L 11.5 10.5" Width="13" Height="13" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                    <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="UP" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding TotalUploadedText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" Margin="0,2"/>

                            <TextBlock Text="{Binding UploadShareText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. AVG / DAY OR AVG / HOUR -->
                    <Border Grid.Column="6" Classes="AnalyticsSurface" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding AverageUsageLabel}" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="AVG" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding AverageUsageText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" Margin="0,2"/>

                            <TextBlock Text="{Binding AverageUsageTrendText}" Classes="Caption" FontWeight="SemiBold" Foreground="{Binding AverageUsageTrendColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ── 4. CHART #1: SELECTED PERIOD NETWORK USAGE (LARGE GROUPED BAR CHART) ──── -->
            <Border Classes="AnalyticsSurface" Padding="24">
                <StackPanel Spacing="20">
                    <!-- Header with Title, Subtitle, and Legend Badges -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Network Usage" Classes="PanelTitle"/>
                            <TextBlock Text="Download &amp; upload usage for the selected period" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>

                        <!-- Legend Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    <TextBlock Text="↓ DOWNLOAD" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="↑ UPLOAD" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Large Chart Canvas Area with 5-Level Dynamic Y-Axis (380px Height) -->
                    <Grid Height="350">
                        <!-- Dynamic Y-Axis Labels (5 Levels) -->
                        <Grid VerticalAlignment="Top" Height="300" HorizontalAlignment="Left" Width="76" RowDefinitions="Auto,*,*,*,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding YAxisMidHighText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMidText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding YAxisMidLowText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="{Binding YAxisMinText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Chart Container -->
                        <Border Grid.Column="0" Margin="84,0,0,0" ClipToBounds="True" Background="Transparent"
                                PointerMoved="HistoricalGraph_PointerMoved"
                                PointerExited="HistoricalGraph_PointerExited"
                                SizeChanged="HistoricalChart_SizeChanged">
                            <Grid>
                                <!-- Horizontal Background Gridlines (5 Levels across 300px Content Height) -->
                                <Canvas Height="300" VerticalAlignment="Top">
                                    <Line StartPoint="0,5"   EndPoint="2000,5"   Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.12"/>
                                    <Line StartPoint="0,80"  EndPoint="2000,80"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,155" EndPoint="2000,155" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,230" EndPoint="2000,230" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,300" EndPoint="2000,300" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.20"/>
                                </Canvas>

                                <!-- Loading State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" IsVisible="{Binding IsLoading}">
                                    <ProgressBar IsIndeterminate="True" Width="180" Height="6" CornerRadius="3" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="Loading network usage…" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- Empty State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsEmpty}">
                                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center">
                                        <TextBlock Text="📊" Classes="SectionTitle" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No network usage recorded" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="Usage data will appear here once DataSense records network activity." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- Grouped Bar Chart ItemsControl with Centered Labels -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding HistoricalChartPoints}" IsVisible="{Binding HasHistoricalGraphData}" Height="340" VerticalAlignment="Top" MinWidth="700">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" VerticalAlignment="Bottom" Height="340"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:HistoricalGraphSample">
                                                <Grid RowDefinitions="300,Auto" VerticalAlignment="Bottom" Height="340" Background="Transparent" Margin="2,0">
                                                    <!-- Bar Pair -->
                                                    <StackPanel Grid.Row="0" Height="300" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                                Spacing="{Binding ((vm:HistoryViewModel)DataContext).BarGap, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <!-- Download Bar -->
                                                        <Border Height="{Binding DownloadBarHeight}"
                                                                Width="{Binding ((vm:HistoryViewModel)DataContext).DownloadBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Background="{DynamicResource Brush.DownloadBarGradient}"
                                                                VerticalAlignment="Bottom"
                                                                CornerRadius="4,4,0,0">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                                </Transitions>
                                                            </Border.Transitions>
                                                        </Border>
                                                        <!-- Upload Bar -->
                                                        <Border Height="{Binding UploadBarHeight}"
                                                                Width="{Binding ((vm:HistoryViewModel)DataContext).UploadBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Background="{DynamicResource Brush.UploadBarGradient}"
                                                                VerticalAlignment="Bottom"
                                                                CornerRadius="4,4,0,0">
                                                            <Border.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                                </Transitions>
                                                            </Border.Transitions>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- X-Axis Label Centered Under Bar Group -->
                                                    <TextBlock Grid.Row="1" Text="{Binding Label}" Classes="Caption" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Interactive Elevated Tooltip Box -->
                                <Canvas IsHitTestVisible="False" IsVisible="{Binding IsHoverActive}">
                                    <Line StartPoint="{Binding HoverX, StringFormat='{}{0},0'}"
                                          EndPoint="{Binding HoverX, StringFormat='{}{0},300'}"
                                          Stroke="{DynamicResource Brush.BorderStrong}"
                                          StrokeThickness="1"
                                          StrokeDashArray="4,4"
                                          Opacity="0.7"/>

                                    <Border Canvas.Left="{Binding HoverX}"
                                            Canvas.Top="{Binding HoverY}"
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            BoxShadow="0 8 20 0 #50000000">
                                        <StackPanel Spacing="8" MinWidth="130">
                                            <TextBlock Text="{Binding HoverTimestampText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}" Opacity="0.6"/>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="↓ Download" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding HoverDownloadText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>

                                                <TextBlock Text="↑ Upload" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding HoverUploadText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>

                                                <Border Height="1" Background="{DynamicResource Brush.Border}" Opacity="0.6" Margin="0,4"/>
                                                <TextBlock Text="Total" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding HoverTotalText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 5. CHART #2: MONTHLY USAGE BREAKDOWN (12 CALENDAR MONTHS) ─────────────── -->
            <Border Classes="AnalyticsSurface" Padding="24">
                <StackPanel Spacing="20">
                    <!-- Header with Title, Subtitle, and Legend Badges -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Monthly Usage Breakdown" Classes="PanelTitle"/>
                            <TextBlock Text="Total network usage by calendar month" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>

                        <!-- Legend Badges -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    <TextBlock Text="↓ DOWNLOAD" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="↑ UPLOAD" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Large Chart Canvas Area with 5-Level Dynamic Y-Axis (340px Height) -->
                    <Grid Height="330">
                        <!-- Dynamic Y-Axis Labels (5 Levels) -->
                        <Grid VerticalAlignment="Top" Height="280" HorizontalAlignment="Left" Width="76" RowDefinitions="Auto,*,*,*,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding TwelveMonthYAxisTopText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding TwelveMonthYAxisMidHighText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding TwelveMonthYAxisMidText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding TwelveMonthYAxisMidLowText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="4" Text="{Binding TwelveMonthYAxisMinText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Chart Container -->
                        <Border Grid.Column="0" Margin="84,0,0,0" ClipToBounds="True" Background="Transparent"
                                PointerMoved="TwelveMonthGraph_PointerMoved"
                                PointerExited="TwelveMonthGraph_PointerExited">
                            <Grid>
                                <!-- Horizontal Background Gridlines (5 Levels across 280px Content Height) -->
                                <Canvas Height="280" VerticalAlignment="Top">
                                    <Line StartPoint="0,5"   EndPoint="2000,5"   Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.12"/>
                                    <Line StartPoint="0,75"  EndPoint="2000,75"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,145" EndPoint="2000,145" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,215" EndPoint="2000,215" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.08"/>
                                    <Line StartPoint="0,280" EndPoint="2000,280" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.20"/>
                                </Canvas>

                                <!-- 12 Months Grouped Bar Chart ItemsControl -->
                                <ItemsControl ItemsSource="{Binding TwelveMonthChartPoints}" Height="320" VerticalAlignment="Top">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" VerticalAlignment="Bottom" Height="320"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:HistoricalGraphSample">
                                            <Grid RowDefinitions="280,Auto" VerticalAlignment="Bottom" Height="320" Background="Transparent" Margin="3,0">
                                                <!-- Bar Pair -->
                                                <StackPanel Grid.Row="0" Height="280" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                            Spacing="{Binding ((vm:HistoryViewModel)DataContext).TwelveMonthBarGap, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <!-- Download Bar -->
                                                    <Border Height="{Binding DownloadBarHeight}"
                                                            Width="{Binding ((vm:HistoryViewModel)DataContext).TwelveMonthDownloadBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Background="{DynamicResource Brush.DownloadBarGradient}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="4,4,0,0">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                            </Transitions>
                                                        </Border.Transitions>
                                                    </Border>
                                                    <!-- Upload Bar -->
                                                    <Border Height="{Binding UploadBarHeight}"
                                                            Width="{Binding ((vm:HistoryViewModel)DataContext).TwelveMonthUploadBarWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Background="{DynamicResource Brush.UploadBarGradient}"
                                                            VerticalAlignment="Bottom"
                                                            CornerRadius="4,4,0,0">
                                                        <Border.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                            </Transitions>
                                                        </Border.Transitions>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Month Label Centered Under Bar Group -->
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" Classes="Caption" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Interactive Elevated Tooltip Box -->
                                <Canvas IsHitTestVisible="False" IsVisible="{Binding IsTwelveMonthHoverActive}">
                                    <Line StartPoint="{Binding TwelveMonthHoverX, StringFormat='{}{0},0'}"
                                          EndPoint="{Binding TwelveMonthHoverX, StringFormat='{}{0},280'}"
                                          Stroke="{DynamicResource Brush.BorderStrong}"
                                          StrokeThickness="1"
                                          StrokeDashArray="4,4"
                                          Opacity="0.7"/>

                                    <Border Canvas.Left="{Binding TwelveMonthHoverX}"
                                            Canvas.Top="{Binding TwelveMonthHoverY}"
                                            Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12"
                                            BoxShadow="0 8 20 0 #50000000">
                                        <StackPanel Spacing="8" MinWidth="130">
                                            <TextBlock Text="{Binding TwelveMonthHoverTimestampText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}" Opacity="0.6"/>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="↓ Download" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding TwelveMonthHoverDownloadText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>

                                                <TextBlock Text="↑ Upload" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding TwelveMonthHoverUploadText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>

                                                <Border Height="1" Background="{DynamicResource Brush.Border}" Opacity="0.6" Margin="0,4"/>
                                                <TextBlock Text="Total" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding TwelveMonthHoverTotalText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 6. CHART #3: APPLICATION USAGE BREAKDOWN (HORIZONTAL BAR CHART) ───────── -->
            <Border Classes="AnalyticsSurface" Padding="24">
                <StackPanel Spacing="20">
                    <!-- Header with Title and Subtitle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Application Usage Breakdown" Classes="PanelTitle"/>
                            <TextBlock Text="{Binding ApplicationBreakdownSubtitle}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,24" IsVisible="{Binding !HasApplications}">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center">
                            <TextBlock Text="🏛️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No application activity recorded" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Text="Usage data will appear here once DataSense records network activity." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>

                    <!-- Large Horizontal Bars for Top Applications -->
                    <ItemsControl ItemsSource="{Binding ApplicationBreakdownItems}" IsVisible="{Binding HasApplications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                <Border Margin="0,0,0,16" Background="Transparent" ToolTip.Tip="{Binding TooltipSummary}">
                                    <StackPanel Spacing="8">
                                        <!-- Top Row: App Icon + Name on Left, Download/Upload/Total/Share on Right -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding ApplicationIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EffectiveDisplayName}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Text="{Binding ProcessName}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding ProcessName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                                <!-- Download -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="↓" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedDownloadText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Upload -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="↑" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedUploadText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Total -->
                                                <TextBlock Text="{Binding FormattedTotalText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>

                                                <!-- Share Pill -->
                                                <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Classes="Caption" FontWeight="Bold" Foreground="{Binding Converter={x:Static conv:ProcessIndexColorConverter.Instance}}" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Bottom Row: Thick 12px Rounded Horizontal Bar -->
                                        <Grid Height="12">
                                            <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="6" Height="12"/>
                                            <ProgressBar Value="{Binding PercentageOfTotal}"
                                                         Minimum="0" Maximum="100"
                                                         Height="12"
                                                         CornerRadius="6"
                                                         Foreground="{Binding Converter={x:Static conv:ProcessIndexColorConverter.Instance}}"
                                                         Background="Transparent"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── 7. LOWER SECTION: NETWORK SESSIONS + USAGE EXPLORER ─────────────────────── -->
            <Grid ColumnDefinitions="*,16,*">

                <!-- LEFT: NETWORK SESSIONS -->
                <Border Grid.Column="0" Classes="AnalyticsSurface" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="NETWORK SESSIONS" Classes="PanelTitle"/>
                                <TextBlock Text="Active &amp; recent network connections" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NetworkSessions.Count, StringFormat='{}{0} Sessions'}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </Border>
                        </Grid>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,32" IsVisible="{Binding !HasNetworkSessions}">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center">
                                <TextBlock Text="📡" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No active network sessions" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="Sessions will appear when network interfaces connect." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Sessions List -->
                        <ItemsControl ItemsSource="{Binding FilteredNetworkSessions}" IsVisible="{Binding HasNetworkSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HistoricalSessionViewModel">
                                    <Border Classes="SessionRow">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="📶" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{Binding SubtitleText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DownloadedText, StringFormat='{}↓ {0}'}" Classes="Caption" Foreground="{DynamicResource Brush.Download}"/>
                                                    <TextBlock Text="{Binding UploadedText, StringFormat='{}↑ {0}'}" Classes="Caption" Foreground="{DynamicResource Brush.Upload}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RIGHT: USAGE EXPLORER (APPLICATION ANALYTICS) -->
                <Border Grid.Column="2" Classes="AnalyticsSurface" Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Header with Sort Control -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="USAGE EXPLORER" Classes="PanelTitle"/>
                                <TextBlock Text="{Binding UsageExplorerSubtitle}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Sort:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption}"
                                          MinWidth="130"
                                          Classes="Secondary"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Table Column Headers -->
                        <Grid ColumnDefinitions="*,110,110,110,65" Margin="12,0,12,0" IsVisible="{Binding HasApplications}">
                            <TextBlock Grid.Column="0" Text="PROCESS" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="TOTAL" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="SHARE" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Grid>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,32" IsVisible="{Binding !HasApplications}">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" HorizontalAlignment="Center">
                                <TextBlock Text="🏛️" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No application activity recorded" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="Monitored processes will appear as network activity is detected." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Applications List -->
                        <ItemsControl ItemsSource="{Binding FilteredApplications}" IsVisible="{Binding HasApplications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                    <Border Classes="ProcessRow" ToolTip.Tip="{Binding TooltipSummary}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,110,110,110,65" VerticalAlignment="Center">
                                                <!-- Process Column: Multi-color Dot + [Icon] Application Name -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{Binding Converter={x:Static conv:ProcessIndexColorConverter.Instance}}"
                                                             VerticalAlignment="Center"/>

                                                    <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Source="{Binding ApplicationIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                                    </Border>

                                                    <TextBlock Text="{Binding EffectiveDisplayName}"
                                                               Classes="Body" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Download Column -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↓" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedDownloadText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Upload Column -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="↑" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedUploadText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Total Column -->
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedTotalText}"
                                                           Classes="Body" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>

                                                <!-- Share Percentage Column -->
                                                <TextBlock Grid.Column="4" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}"
                                                           Classes="Body" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Multi-Color Distribution Progress Bar -->
                                            <ProgressBar Value="{Binding PercentageOfTotal}"
                                                         Minimum="0" Maximum="100"
                                                         Height="3"
                                                         CornerRadius="2"
                                                         Foreground="{Binding Converter={x:Static conv:ProcessIndexColorConverter.Instance}}"
                                                         Background="{DynamicResource Brush.Surface}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
