<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <UserControl.Resources>
        <conv:HistoryPresetConverter    x:Key="PresetConverter"/>
        <conv:HistoryPresetIsCustomConverter x:Key="IsCustomConverter"/>
    </UserControl.Resources>

    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource Brush.AppBackground}">

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">

                    <!-- Date Range ComboBox with human-readable labels -->
                    <ComboBox ItemsSource="{Binding DatePresets}"
                              SelectedItem="{Binding SelectedPreset}"
                              MinWidth="160"
                              Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" Foreground="{DynamicResource Brush.TextPrimary}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource PresetConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Interface ComboBox -->
                    <ComboBox ItemsSource="{Binding Interfaces}"
                              SelectedItem="{Binding SelectedInterface}"
                              MinWidth="150"
                              Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" Foreground="{DynamicResource Brush.TextPrimary}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Day count badge -->
                <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                        CornerRadius="20" Padding="12,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Days:" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"/>
                        <TextBlock Text="{Binding DayCountText}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── Custom date pickers (only visible for Custom preset) ── -->
        <Border Grid.Row="1"
                IsVisible="{Binding SelectedPreset, Converter={StaticResource IsCustomConverter}}"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="From:" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding CustomStart}"
                                    Background="{DynamicResource Brush.SurfaceElevated}" Foreground="{DynamicResource Brush.TextPrimary}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"/>
                <TextBlock Text="To:" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding CustomEnd}"
                                    Background="{DynamicResource Brush.SurfaceElevated}" Foreground="{DynamicResource Brush.TextPrimary}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"/>
            </StackPanel>
        </Border>

        <!-- ── Summary Cards ── -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.AppBackground}" Padding="20,14">
            <UniformGrid Columns="4" Rows="1">
                <!-- Total usage (hero) -->
                <Border Classes="Card" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Accent}" Margin="0,0,12,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="🌐  Total Usage" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                        <TextBlock Text="{Binding TotalUsageText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="for selected period" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <!-- Downloaded -->
                <Border Classes="Card" Margin="0,0,12,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="⬇  Downloaded" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding TotalDownloadedText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                    </StackPanel>
                </Border>
                <!-- Uploaded -->
                <Border Classes="Card" Margin="0,0,12,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="⬆  Uploaded" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding TotalUploadedText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                    </StackPanel>
                </Border>
                <!-- Avg / day -->
                <Border Classes="Card">
                    <StackPanel Spacing="5">
                        <TextBlock Text="📈  Avg / Day" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                        <TextBlock Text="{Binding AvgDailyText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="active days only" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ── Daily Breakdown / States ── -->
        <Grid Grid.Row="3">

            <!-- Loading state -->
            <StackPanel IsVisible="{Binding IsLoading}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
                <TextBlock Text="Loading…" Foreground="{DynamicResource Brush.Accent}" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error state -->
            <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource Brush.DangerSurface}" CornerRadius="10" Margin="20" Padding="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="⚠️  Error" Foreground="{DynamicResource Brush.Danger}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="13"
                               TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="500"/>
                </StackPanel>
            </Border>

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="No data for this period" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="15" HorizontalAlignment="Center"/>
                <TextBlock Text="Try a wider date range or a different interface filter."
                           Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Daily breakdown + Sessions list -->
            <ScrollViewer IsVisible="{Binding IsDataState}" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel Spacing="24" MaxWidth="1400">

                    <!-- ── Daily Usage ── -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Daily Breakdown" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <!-- Column headers -->
                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="14,8">
                            <Grid ColumnDefinitions="Auto,*,120,120,120">
                                <TextBlock Grid.Column="0" Text="Day"        Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" Width="40"/>
                                <TextBlock Grid.Column="1" Text="Date"       Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Downloaded" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Uploaded"   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Total"      Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DailyUsage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DailyUsageViewModel">
                                    <Border Classes="Card">
                                        <Grid ColumnDefinitions="Auto,*,120,120,120">
                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeekLabel}"
                                                       Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" FontWeight="SemiBold"
                                                       Width="40" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DayLabel}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding DayFull}"  Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadedText}"
                                                       Foreground="{DynamicResource Brush.Download}" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadedText}"
                                                       Foreground="{DynamicResource Brush.Upload}" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalText}"
                                                       Foreground="{DynamicResource Brush.Accent}" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ── Network Sessions ── -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Network Sessions" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="6" Padding="14,8">
                            <Grid ColumnDefinitions="*,100,170,170,110,110">
                                <TextBlock Grid.Column="0" Text="Network"    Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Type"       Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="Started"    Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="Ended"      Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="4" Text="Downloaded" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Uploaded"   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding NetworkSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="Card">
                                        <Grid ColumnDefinitions="*,100,170,170,110,110">
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NetworkName}" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding InterfaceName}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StartTime, StringFormat='MMM dd, HH:mm'}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EndTime, StringFormat='MMM dd, HH:mm', FallbackValue='Active'}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding BytesDownloaded, Converter={x:Static conv:ByteFormatConverter.Instance}}"
                                                       Foreground="{DynamicResource Brush.Download}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding BytesUploaded, Converter={x:Static conv:ByteFormatConverter.Instance}}"
                                                       Foreground="{DynamicResource Brush.Upload}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No sessions recorded for this period."
                                   IsVisible="{Binding !NetworkSessions.Count}"
                                   Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" Margin="0,8" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
