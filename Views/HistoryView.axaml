<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <UserControl.Resources>
        <conv:HistoryPresetConverter    x:Key="PresetConverter"/>
        <conv:HistoryPresetIsCustomConverter x:Key="IsCustomConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <TextBlock Text="Historical Analytics" Classes="PageTitle" />
                        <TextBlock Text="Aggregated daily data usage and network session history." Classes="BodySecondary" />
                    </StackPanel>

                    <Border Grid.Column="1" Classes="StatusPill" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Days Active:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="{Binding DayCountText}" Classes="Caption" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── FILTER BAR ──────────────────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="{DynamicResource Padding.Medium}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" Margin="0,0,24,8" VerticalAlignment="Center">
                            <TextBlock Text="Period:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding DatePresets}"
                                      SelectedItem="{Binding SelectedPreset}"
                                      MinWidth="160" Classes="Secondary">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PresetConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Custom Date Pickers -->
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" Margin="0,0,24,8" VerticalAlignment="Center"
                                    IsVisible="{Binding SelectedPreset, Converter={StaticResource IsCustomConverter}}">
                            <TextBlock Text="From:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            <CalendarDatePicker SelectedDate="{Binding CustomStart}" />

                            <TextBlock Text="To:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <CalendarDatePicker SelectedDate="{Binding CustomEnd}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Interface:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Interfaces}"
                                      SelectedItem="{Binding SelectedInterface}"
                                      MinWidth="150" Classes="Secondary">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </WrapPanel>
                </Border>

                <!-- ── SUMMARY HERO ─────────────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Total Usage -->
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="TOTAL USAGE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalUsageText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="for selected period" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Downloaded -->
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="DOWNLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalDownloadedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                        </StackPanel>

                        <!-- Uploaded -->
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="UPLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalUploadedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                        </StackPanel>

                        <!-- Avg / Day -->
                        <StackPanel Grid.Column="3" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="AVG / DAY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AvgDailyText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="active days only" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── CONTENT AREA ────────────────────────────────────────────────────── -->
                <Grid>

                    <!-- Loading state -->
                    <StackPanel Classes="EmptyState" IsVisible="{Binding IsLoading}" Margin="0,40">
                        <ProgressBar IsIndeterminate="True" Width="160" Height="4" Margin="0,0,0,16" Foreground="{DynamicResource Brush.Accent}"/>
                        <TextBlock Text="Loading history…" Classes="BodySecondary" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Error state -->
                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource Brush.DangerSurface}" CornerRadius="{DynamicResource Radius.Medium}" Padding="{DynamicResource Padding.Large}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="Error" Classes="PanelTitle" Foreground="{DynamicResource Brush.Danger}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Classes="Body"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="500"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel Classes="EmptyState" IsVisible="{Binding IsEmpty}" Margin="0,40">
                        <TextBlock Text="No data for this period" Classes="PanelTitle" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a wider date range or a different interface filter."
                                   Classes="BodySecondary" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Data Content -->
                    <StackPanel Spacing="{DynamicResource Spacing.XXL}" IsVisible="{Binding IsDataState}">

                        <!-- ── Daily Breakdown Table ── -->
                        <Border Classes="AnalyticsSurface" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid Grid.Row="0" Margin="20,16">
                                    <TextBlock Text="DAILY BREAKDOWN" Classes="PanelTitle" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                                    <Grid ColumnDefinitions="60,*,120,120,120">
                                        <TextBlock Grid.Column="0" Text="DAY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="1" Text="DATE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="2" Text="DOWNLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="UPLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="TOTAL" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding DailyUsage}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DailyUsageViewModel">
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="60,*,120,120,120">
                                                    <TextBlock Grid.Column="0" Text="{Binding DayOfWeekLabel}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DayLabel}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                        <TextBlock Text="{Binding DayFull}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DownloadedText}" Classes="Body" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding UploadedText}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- ── Network Sessions Table ── -->
                        <Border Classes="AnalyticsSurface" Padding="0">
                            <Grid RowDefinitions="Auto,Auto,*">
                                <Grid Grid.Row="0" Margin="20,16">
                                    <TextBlock Text="NETWORK SESSIONS" Classes="PanelTitle" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                                    <Grid ColumnDefinitions="*,100,170,170,110,110">
                                        <TextBlock Grid.Column="0" Text="NETWORK" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="1" Text="TYPE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="2" Text="STARTED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="3" Text="ENDED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                        <TextBlock Grid.Column="4" Text="DOWNLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="5" Text="UPLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !NetworkSessions.Count}" Margin="0,32">
                                    <TextBlock Text="No sessions recorded for this period." Classes="BodySecondary" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding NetworkSessions}" IsVisible="{Binding NetworkSessions.Count}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                                <Grid ColumnDefinitions="*,100,170,170,110,110">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NetworkName}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                        <TextBlock Text="{Binding InterfaceName}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding StartTime, StringFormat='MMM dd, HH:mm'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EndTime, StringFormat='MMM dd, HH:mm', FallbackValue='Active'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding BytesDownloaded, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding BytesUploaded, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Grid>
            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
