<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             xmlns:conv="using:DataSense.Converters"
             x:DataType="vm:DashboardViewModel"
             x:Class="DataSense.Views.DashboardView"
             Background="{DynamicResource Brush.AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.AppBackground}">
        <StackPanel Spacing="20" Margin="24">

            <!-- ── 1. HEADER BAR ───────────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard" Classes="PageTitle"/>
                    <TextBlock Text="Network usage &amp; application analytics" Classes="Caption"/>
                </StackPanel>

                <!-- Right: Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Live Connection Status Pill -->
                    <Border CornerRadius="16" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="Live connection" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Name Pill -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📶" Classes="Body" VerticalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi/network" Classes="Caption" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WifiSsid}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── 2. LARGE HERO NETWORK ANALYTICS SURFACE ─────────────────────────────────── -->
            <Border Classes="HeroSurface" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Hero Header Label -->
                    <TextBlock Text="HERO NETWORK ANALYTICS" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5"/>

                    <!-- 3 Major Metric Columns -->
                    <Grid ColumnDefinitions="*,12,*,12,*">
                        <!-- DOWNLOAD (Electric Cyan) -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LIVE DOWNLOAD RATE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="↓" Classes="Caption" Foreground="{DynamicResource Brush.Download}"/>
                                </Grid>
                                <TextBlock Text="{Binding DownloadSpeedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                                <Path Data="M 0 15 Q 30 0 60 10 T 120 5 L 120 20 L 0 20 Z" Fill="{DynamicResource Brush.Download}" Opacity="0.12" Stroke="{DynamicResource Brush.Download}" StrokeThickness="1.5" Height="20" Stretch="Fill"/>
                            </StackPanel>
                        </Border>

                        <!-- UPLOAD (Violet / Purple) -->
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LIVE UPLOAD RATE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="↑" Classes="Caption" Foreground="{DynamicResource Brush.Upload}"/>
                                </Grid>
                                <TextBlock Text="{Binding UploadSpeedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                                <Path Data="M 0 15 Q 30 5 60 15 T 120 8 L 120 20 L 0 20 Z" Fill="{DynamicResource Brush.Upload}" Opacity="0.12" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="1.5" Height="20" Stretch="Fill"/>
                            </StackPanel>
                        </Border>

                        <!-- TODAY'S USAGE (Neutral / High Contrast) -->
                        <Border Grid.Column="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="TODAY'S USAGE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="📊" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Grid>
                                <TextBlock Text="{Binding TodayTotalText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding TodayVsYesterdayText}" Classes="Caption"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── 3. FOUR SECONDARY METRICS SURFACES ────────────────────────────── -->
                    <Grid ColumnDefinitions="*,8,*,8,*,8,*" Margin="0,4,0,0">
                        <Border Grid.Column="0" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MONTH DOWNLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding MonthDownloadedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MONTH UPLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding MonthUploadedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CURRENT SESSION" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding CurrentSessionTotal}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="PROJECTED MONTH-END" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding ForecastProjectedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 4. PREMIUM LIVE NETWORK THROUGHPUT GRAPH (60-SECOND ROLLING WINDOW) ─────── -->
            <Border Classes="AnalyticsSurface" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with Title, Subtitle, Live Indicator, and Live Speed Indicators -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left: Title, Subtitle, and Live Status Badge -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Network Traffic" Classes="PanelTitle"/>
                                <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                        <TextBlock Text="{Binding LiveGraphStatusText}" Classes="Caption" FontWeight="Bold" Foreground="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Live network throughput" Classes="Caption"/>
                        </StackPanel>

                        <!-- Right: Live Speed Telemetry Indicators (Electric Cyan Download / Violet Upload) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <!-- Live Download Speed Indicator -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="↓" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding CurrentLiveDownloadSpeedText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Download}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live Upload Speed Indicator -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="↑" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding CurrentLiveUploadSpeedText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Upload}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Graph Canvas Area -->
                    <Grid Height="210">
                        <!-- Dynamic Y-Axis Labels -->
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="72" RowDefinitions="Auto,*,*,*,*,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopText}" Classes="Caption" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding YAxisMidHighText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMidText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding YAxisMidLowText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Text="{Binding YAxisMinText}" Classes="Caption" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Graph Canvas Container -->
                        <Border Grid.Column="0" Margin="78,0,0,0" ClipToBounds="True" Background="Transparent" 
                                PointerMoved="RealtimeGraph_PointerMoved" PointerExited="RealtimeGraph_PointerExited"
                                SizeChanged="ChartContainer_SizeChanged">
                            <Grid>
                                <!-- Horizontal Background Gridlines (5 Subtle Levels) -->
                                <Canvas Height="180">
                                    <Line StartPoint="0,10"  EndPoint="2000,10"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.12"/>
                                    <Line StartPoint="0,50"  EndPoint="2000,50"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.10"/>
                                    <Line StartPoint="0,90"  EndPoint="2000,90"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.10"/>
                                    <Line StartPoint="0,130" EndPoint="2000,130" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.10"/>
                                    <Line StartPoint="0,170" EndPoint="2000,170" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.20"/>
                                </Canvas>

                                <!-- Loading State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !HasRealtimeGraphData}">
                                    <TextBlock Text="Waiting for network telemetry…" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="DataSense is sampling Linux network interface statistics." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- Disconnected State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !IsRealtimeGraphLive}">
                                    <TextBlock Text="No active network connection" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="Check active network connection or Wi-Fi state." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- Live Download Series (Electric Cyan Area + Stroke) -->
                                <Path Data="{Binding RealtimeDownloadAreaGeometry}" Fill="{DynamicResource Brush.Download}" Opacity="0.10" IsVisible="{Binding HasRealtimeGraphData}"/>
                                <Path Data="{Binding RealtimeDownloadLineGeometry}" Stroke="{DynamicResource Brush.Download}" StrokeThickness="2" IsVisible="{Binding HasRealtimeGraphData}"/>

                                <!-- Live Upload Series (Sophisticated Violet Area + Stroke) -->
                                <Path Data="{Binding RealtimeUploadAreaGeometry}" Fill="{DynamicResource Brush.Upload}" Opacity="0.10" IsVisible="{Binding HasRealtimeGraphData}"/>
                                <Path Data="{Binding RealtimeUploadLineGeometry}" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="2" IsVisible="{Binding HasRealtimeGraphData}"/>

                                <!-- Glowing Head Dots on Latest Sample Point (NOW) -->
                                <Canvas IsVisible="{Binding HasRealtimeGraphData}">
                                    <Ellipse Canvas.Left="{Binding LatestDownloadX}" Canvas.Top="{Binding LatestDownloadY}" Width="8" Height="8" Margin="-4,-4,0,0" Fill="{DynamicResource Brush.Download}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="1.5"/>
                                    <Ellipse Canvas.Left="{Binding LatestUploadX}" Canvas.Top="{Binding LatestUploadY}" Width="8" Height="8" Margin="-4,-4,0,0" Fill="{DynamicResource Brush.Upload}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="1.5"/>
                                </Canvas>

                                <!-- Interactive Hover Guide Line & Floating Tooltip Card -->
                                <Canvas Height="180" IsVisible="{Binding IsHoveringRealtimeGraph}">
                                    <!-- Vertical Guide Line -->
                                    <Line Canvas.Left="{Binding HoverLineX}" StartPoint="0,10" EndPoint="0,170" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.8"/>

                                    <!-- Curve Highlight Dots -->
                                    <Ellipse Canvas.Left="{Binding HoverLineX}" Canvas.Top="{Binding HoverDownloadY}" Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource Brush.Download}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="{Binding HoverLineX}" Canvas.Top="{Binding HoverUploadY}" Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource Brush.Upload}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="2"/>

                                    <!-- Floating Elevated Tooltip Card -->
                                    <Border Canvas.Left="{Binding HoverTooltipX}" Canvas.Top="8"
                                            Background="{DynamicResource Brush.SurfaceElevated}" 
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                            CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="6" Width="160" DataContext="{Binding HoveredThroughputSample}">
                                            <TextBlock Text="{Binding TimeText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                            
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="↓" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                                    <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                            </Grid>
                                            
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="↑" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                                    <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding UploadSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                            </Grid>
                                            
                                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                            
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="TOTAL" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Dynamic X-Axis ( -60s -45s -30s -15s NOW ) and Legend -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <!-- X-Axis Timestamps -->
                        <ItemsControl ItemsSource="{Binding TimeAxisLabels}" Margin="78,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="Caption" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Legend & Peak Speed Readouts -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <!-- Download Legend -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}"/>
                                <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>

                            <!-- Upload Legend -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}"/>
                                <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>

                            <!-- Peak in Window -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="WINDOW PEAK:" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <TextBlock Text="{Binding PeakLiveDownloadSpeedText, StringFormat='↓ {0}'}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                    <TextBlock Text="{Binding PeakLiveUploadSpeedText, StringFormat='↑ {0}'}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 5. TWO SIDE-BY-SIDE PROCESS DONUT ANALYTICS PANELS ──────────────────────── -->
            <Grid ColumnDefinitions="*,16,*">

                <!-- LEFT: Today's Process Network Traffic Donut Panel -->
                <Border Grid.Column="0" Classes="AnalyticsSurface" Padding="18">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Multi-Segment Process Donut Chart -->
                        <Grid Height="170" HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding TopProcesses}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel Width="150" Height="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                        <Path Fill="{Binding ProcessName, Converter={x:Static conv:ProcessIndexColorConverter.Instance}}">
                                            <Path.Data>
                                                <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="((vm:DashboardViewModel)DataContext).TopProcesses" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <ToolTip.Tip>
                                                <Border Padding="10" Background="{DynamicResource Brush.Surface}" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding ProcessName}" Classes="Body" FontWeight="Bold"/>
                                                        <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat='Share: {0:F1}%'}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip.Tip>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Donut Center Hole -->
                            <Border Width="95" Height="95" CornerRadius="100" Background="{DynamicResource Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="TODAY" Classes="Caption" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TodayTotalText}" Classes="MetricSmall" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Process Legend Table -->
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,3">
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding ProcessName, Converter={x:Static conv:ProcessIndexColorConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Classes="Body" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DataSource}" Classes="Caption" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="BodySecondary" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RIGHT: This Month's Process Network Traffic Donut Ring Panel -->
                <Border Grid.Column="2" Classes="AnalyticsSurface" Padding="18">
                    <StackPanel Spacing="16">
                        <TextBlock Text="This Month's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Download vs Upload Monthly Donut Ring -->
                        <Grid Height="170" HorizontalAlignment="Center">
                            <!-- Download Arc Segment (Cyan) -->
                            <Path Fill="{DynamicResource Brush.Download}">
                                <Path.Data>
                                    <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                        <Binding Source="{x:False}"/>
                                        <Binding Path="DownloadColumnWidth"/>
                                        <Binding Path="UploadColumnWidth"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>

                            <!-- Upload Arc Segment (Purple) -->
                            <Path Fill="{DynamicResource Brush.Upload}">
                                <Path.Data>
                                    <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                        <Binding Source="{x:True}"/>
                                        <Binding Path="DownloadColumnWidth"/>
                                        <Binding Path="UploadColumnWidth"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>

                            <!-- Donut Center Hole -->
                            <Border Width="95" Height="95" CornerRadius="100" Background="{DynamicResource Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="THIS MONTH" Classes="Caption" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MonthTotalText}" Classes="MetricSmall" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Monthly Download / Upload Readouts -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Download Traffic" Classes="Body" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MonthDownloadedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding DownloadRatioText}" Classes="Caption" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Upload Traffic" Classes="Body" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MonthUploadedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding UploadRatioText}" Classes="Caption" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── 6. LIVE PROCESS TRAFFIC TABLE ───────────────────────────────────────────── -->
            <Border Classes="AnalyticsSurface" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Live Process Traffic" Classes="PanelTitle"/>

                    <!-- Table Header -->
                    <Grid ColumnDefinitions="*,120,120,120,90" Margin="0,4,0,4">
                        <TextBlock Grid.Column="0" Text="PROCESS" Classes="Caption" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="ACTIVITY" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Analytical Process Table Rows -->
                    <ItemsControl ItemsSource="{Binding LiveProcessTraffic}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ProcessNetworkUsage">
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="*,120,120,120,90">
                                        <!-- Process Name & Resolved Application Icon -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding ApplicationIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EffectiveDisplayName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessIdentifier}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" IsVisible="{Binding HasDistinctProcessIdentifier}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Rate / Usage Columns -->
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadRateBytesPerSec, Converter={x:Static conv:ByteFormatConverter.Instance}, StringFormat='{}{0}/s'}" Classes="Body" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UploadRateBytesPerSec, Converter={x:Static conv:ByteFormatConverter.Instance}, StringFormat='{}{0}/s'}" Classes="Body" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Live Active Indicator -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}"/>
                                            <TextBlock Text="Active" Classes="Caption" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
