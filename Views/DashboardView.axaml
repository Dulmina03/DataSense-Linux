<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:m="using:DataSense.Models"
             xmlns:conv="using:DataSense.Converters"
             x:DataType="vm:DashboardViewModel"
             x:Class="DataSense.Views.DashboardView">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XXXL}">

            <!-- HEADER -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                    <TextBlock Text="Network Overview" Classes="PageTitle" />

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" Margin="0,4,0,0">
                        <Border Classes="StatusPill">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}">
                                <Ellipse Classes="LiveIndicator" Fill="{Binding StatusDotColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Classes="Caption" Foreground="{DynamicResource Brush.TextPrimary}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionType}" Classes="BodySecondary" />
                            <TextBlock Text="•" Classes="BodySecondary" IsVisible="{Binding HasWifi}" />
                            <TextBlock Text="{Binding WifiSsid}" Classes="BodySecondary" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" IsVisible="{Binding HasWifi}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- HERO METRICS -->
            <Grid ColumnDefinitions="*,*,1.5*">

                <!-- Download -->
                <Border Grid.Column="0" Classes="MetricSurface" Margin="0,0,16,0">
                    <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                        <TextBlock Text="Download" Classes="SectionTitle" />
                        <TextBlock Text="{Binding DownloadSpeedText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Download}" />
                    </StackPanel>
                </Border>

                <!-- Upload -->
                <Border Grid.Column="1" Classes="MetricSurface" Margin="0,0,24,0">
                    <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                        <TextBlock Text="Upload" Classes="SectionTitle" />
                        <TextBlock Text="{Binding UploadSpeedText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Upload}" />
                    </StackPanel>
                </Border>

                <!-- Today's Total (Asymmetric visual anchor) -->
                <Border Grid.Column="2" Classes="HeroSurface" VerticalAlignment="Center" Padding="{DynamicResource Padding.Large}">
                    <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                        <TextBlock Text="Today's Usage" Classes="SectionTitle" />
                        <TextBlock Text="{Binding TodayTotalText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.XS}" IsVisible="{Binding HasTodayDelta}">
                            <TextBlock Text="{Binding TodayVsYesterdayText}" Classes="Caption" FontWeight="SemiBold" Foreground="{Binding TodayDeltaColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PRIMARY CHART (Usage Trend) -->
            <Border Classes="AnalyticsSurface">
                <StackPanel Spacing="{DynamicResource Spacing.LG}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Usage Trend" Classes="SectionTitle" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.XS}">
                            <Button Content="Today" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Classes="Ghost"/>
                            <Button Content="7 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days" Classes="Ghost"/>
                            <Button Content="30 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="Ghost"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Classes="EmptyState" IsVisible="{Binding IsChartEmpty}" Margin="0,32">
                        <TextBlock Text="📈" Classes="EmptyStateIcon" />
                        <TextBlock Text="No usage data available" Classes="EmptyStateTitle" />
                    </StackPanel>
                    <Border Classes="SkeletonBlock" Height="240" IsVisible="{Binding IsAnalyticsLoading}" />

                    <StackPanel IsVisible="{Binding !IsChartEmpty}" Spacing="0">
                        <Grid Height="200" SizeChanged="ChartContainer_SizeChanged">
                            <!-- Subtle grid lines -->
                            <Canvas>
                                <Line StartPoint="0,0"   EndPoint="4000,0"   Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.3"/>
                                <Line StartPoint="0,50"  EndPoint="4000,50"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.15"/>
                                <Line StartPoint="0,100" EndPoint="4000,100" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.15"/>
                                <Line StartPoint="0,150" EndPoint="4000,150" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.15"/>
                                <Line StartPoint="0,200" EndPoint="4000,200" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.3"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding DailyChartItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas Height="200"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DailyChartBarViewModel">
                                        <Canvas>
                                            <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}" Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}" Fill="{DynamicResource Brush.Upload}" Opacity="0.95" RadiusX="2" RadiusY="2" ToolTip.Tip="{Binding Tooltip}"/>
                                            <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}" Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}" Fill="{DynamicResource Brush.Download}" Opacity="0.95" ToolTip.Tip="{Binding Tooltip}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <!-- Chart X-Axis Labels -->
                        <ItemsControl ItemsSource="{Binding DailyChartItems}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DailyChartBarViewModel">
                                    <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="0" Text="{Binding DayLabel}" Classes="Caption" Width="{Binding BarWidth}" TextAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ROW 2: CONSUMERS & DISTRIBUTION -->
            <Grid ColumnDefinitions="3*,2*">

                <!-- Top Consumers (Left, larger column) -->
                <Border Grid.Column="0" Classes="CardInteractive" Margin="0,0,24,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Top Application Consumers" Classes="SectionTitle" />

                        <StackPanel Classes="EmptyState" IsVisible="{Binding !HasTopProcesses}" Margin="0,24">
                            <TextBlock Text="No application traffic recorded" Classes="Caption" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding TopProcesses}" IsVisible="{Binding HasTopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessName}" Classes="Body" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DataSource}" Classes="Caption" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TodayBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Metric" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Month Distribution & Session (Right, smaller column) -->
                <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XL}">

                    <!-- Distribution Visualization -->
                    <Border Classes="Card">
                        <StackPanel Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="Data Distribution" Classes="SectionTitle" />

                            <TextBlock Text="No data recorded this month." Classes="Caption" IsVisible="{Binding !HasMonthData}" Margin="0,12" />

                            <StackPanel IsVisible="{Binding HasMonthData}" Spacing="{DynamicResource Spacing.LG}" Margin="0,8,0,0">
                                <!-- Ratio Bar -->
                                <Border CornerRadius="{DynamicResource Radius.Pill}" ClipToBounds="True" Height="6" Background="{DynamicResource Brush.SurfaceElevated}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding DownloadColumnWidth}"/>
                                            <ColumnDefinition Width="{Binding UploadColumnWidth}"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="{DynamicResource Brush.Download}" />
                                        <Rectangle Grid.Column="1" Fill="{DynamicResource Brush.Upload}" />
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.Tight}">
                                        <TextBlock Text="Downloaded" Classes="Caption" />
                                        <TextBlock Text="{Binding DownloadActualText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Download}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Tight}" HorizontalAlignment="Right">
                                        <TextBlock Text="Uploaded" Classes="Caption" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding UploadActualText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Upload}" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Session Inspector -->
                    <Border Classes="CardInteractive">
                        <StackPanel Spacing="{DynamicResource Spacing.MD}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Session Inspector" Classes="SectionTitle" />
                                <Button Grid.Column="1" Content="➔" Classes="Icon" Command="{Binding OpenTimelineCommand}"/>
                            </Grid>

                            <StackPanel IsVisible="{Binding !HasCurrentSession}" Margin="0,16">
                                <TextBlock Text="No active network session." Classes="Caption" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasCurrentSession}" Spacing="{DynamicResource Spacing.MD}">
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock Grid.Column="0" Text="Network" Classes="Caption" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentSessionNetwork}" Classes="Body" FontWeight="SemiBold" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock Grid.Column="0" Text="Duration" Classes="Caption" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentSessionDuration}" Classes="Body" />
                                </Grid>
                                <Grid ColumnDefinitions="90,*">
                                    <TextBlock Grid.Column="0" Text="Traffic" Classes="Caption" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentSessionTotal}" Classes="MetricSmall" Foreground="{DynamicResource Brush.TextPrimary}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ROW 3: INTELLIGENCE, BUDGET, FORECAST -->
            <Grid ColumnDefinitions="*,*,*">

                <!-- Network Health / Intelligence -->
                <Border Grid.Column="0" Classes="CardInteractive" Margin="0,0,24,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="System Health" Classes="SectionTitle" />
                            <Button Grid.Column="1" Content="➔" Classes="Icon" Command="{Binding NavigateToUnifiedIntelligenceCommand}"/>
                        </Grid>

                        <StackPanel Classes="EmptyState" IsVisible="{Binding !HasInsights}" Margin="0,32">
                            <TextBlock Text="System operates nominally." Classes="Caption" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Insights}" IsVisible="{Binding HasInsights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                                            <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Classes="Caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Budget Monitor -->
                <Border Grid.Column="1" Classes="Card" Margin="0,0,24,0">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Data Budget" Classes="SectionTitle" />

                        <StackPanel IsVisible="{Binding !HasBudget}" Margin="0,24">
                            <TextBlock Text="No active data budget." Classes="Caption" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasBudget}" Spacing="{DynamicResource Spacing.LG}" Margin="0,8,0,0">
                            <StackPanel Spacing="{DynamicResource Spacing.XS}">
                                <TextBlock Text="{Binding BudgetStatusText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                                <ProgressBar Value="{Binding BudgetProgressValue}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" BorderThickness="0" Foreground="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.SurfaceElevated}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.Tight}">
                                    <TextBlock Text="Used" Classes="Caption" />
                                    <TextBlock Text="{Binding BudgetUsedText}" Classes="MetricSmall" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Tight}" HorizontalAlignment="Right">
                                    <TextBlock Text="Remaining" Classes="Caption" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding BudgetRemainingText}" Classes="MetricSmall" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Forecast -->
                <Border Grid.Column="2" Classes="Card">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Forecast" Classes="SectionTitle" />

                        <StackPanel IsVisible="{Binding !HasForecast}" Margin="0,24">
                            <TextBlock Text="Building your forecast baseline..." Classes="Caption" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasForecast}" Spacing="{DynamicResource Spacing.LG}">
                            <StackPanel Spacing="{DynamicResource Spacing.Tight}">
                                <TextBlock Text="Projected Month-End" Classes="Caption" />
                                <TextBlock Text="{Binding ForecastProjectedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Accent}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.Tight}">
                                    <TextBlock Text="Avg Daily" Classes="Caption" />
                                    <TextBlock Text="{Binding ForecastAvgDailyText}" Classes="MetricSmall" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.Tight}" HorizontalAlignment="Right">
                                    <TextBlock Text="Confidence" Classes="Caption" TextAlignment="Right"/>
                                    <TextBlock Text="{Binding ForecastConfidenceText}" Classes="MetricSmall" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
