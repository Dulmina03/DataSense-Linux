<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             xmlns:conv="using:DataSense.Converters"
             x:DataType="vm:DashboardViewModel"
             x:Class="DataSense.Views.DashboardView"
             Background="{DynamicResource Brush.AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.AppBackground}">
        <StackPanel Spacing="20" Margin="24">

            <!-- ── 1. HEADER BAR ───────────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard" Classes="PageTitle"/>
                    <TextBlock Text="Network usage &amp; application analytics" Classes="Caption"/>
                </StackPanel>

                <!-- Right: Status Badges & Speeds -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Live Connection Status Pill -->
                    <Border CornerRadius="16" Background="#1A10B981" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="Live connection" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Name Pill -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📶" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi/network" Classes="Caption" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WifiSsid}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" VerticalAlignment="Center"/>

                    <!-- Download & Upload Rates -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DownloadSpeedText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="Download ↓" Classes="Caption" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UploadSpeedText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                            <TextBlock Text="Upload kbps" Classes="Caption" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── 2. LARGE HERO NETWORK ANALYTICS SURFACE ─────────────────────────────────── -->
            <Border Classes="HeroSurface" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Hero Header Label -->
                    <TextBlock Text="HERO NETWORK ANALYTICS" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5"/>

                    <!-- 3 Major Metric Columns -->
                    <Grid ColumnDefinitions="*,12,*,12,*">
                        <!-- DOWNLOAD (Electric Cyan) -->
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LIVE DOWNLOAD RATE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="↓" FontSize="12" Foreground="{DynamicResource Brush.Download}"/>
                                </Grid>
                                <TextBlock Text="{Binding DownloadSpeedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                                <Path Data="M 0 15 Q 30 0 60 10 T 120 5 L 120 20 L 0 20 Z" Fill="#1A38BDF8" Stroke="{DynamicResource Brush.Download}" StrokeThickness="1.5" Height="20" Stretch="Fill"/>
                            </StackPanel>
                        </Border>

                        <!-- UPLOAD (Violet / Purple) -->
                        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="#60A855F7" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="LIVE UPLOAD RATE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="↑" FontSize="12" Foreground="{DynamicResource Brush.Upload}"/>
                                </Grid>
                                <TextBlock Text="{Binding UploadSpeedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                                <Path Data="M 0 15 Q 30 5 60 15 T 120 8 L 120 20 L 0 20 Z" Fill="#1AA855F7" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="1.5" Height="20" Stretch="Fill"/>
                            </StackPanel>
                        </Border>

                        <!-- TODAY'S USAGE (Neutral / High Contrast) -->
                        <Border Grid.Column="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="TODAY'S USAGE" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                    <TextBlock Grid.Column="1" Text="📊" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </Grid>
                                <TextBlock Text="{Binding TodayTotalText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding TodayVsYesterdayText}" Classes="Caption"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── 3. FOUR SECONDARY METRICS SURFACES ────────────────────────────── -->
                    <Grid ColumnDefinitions="*,8,*,8,*,8,*" Margin="0,4,0,0">
                        <Border Grid.Column="0" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MONTH DOWNLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding MonthDownloadedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MONTH UPLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding MonthUploadedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CURRENT SESSION" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding CurrentSessionTotal}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Classes="MetricSurface" Padding="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="PROJECTED MONTH-END" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Text="{Binding ForecastProjectedText}" Classes="MetricSmall"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 4. LARGE NETWORK TRAFFIC GRAPH ─────────────────────────────────────────── -->
            <Border Classes="AnalyticsSurface" Padding="20">
                <StackPanel Spacing="16">
                    <!-- Header with Title, Live Status Badge, and Speed Metrics -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Text="Network Traffic" Classes="PanelTitle"/>
                                <Border CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                        <TextBlock Text="{Binding LiveGraphStatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Download &amp; Upload Usage" Classes="Caption"/>
                        </StackPanel>

                        <!-- Right Live Speed Readouts -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <!-- Download Live & Peak -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="↓" Foreground="{DynamicResource Brush.Download}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding CurrentLiveDownloadSpeedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PeakLiveDownloadSpeedText, StringFormat='PEAK ↓ {0}'}" Classes="Caption" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- Upload Live & Peak -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="↑" Foreground="{DynamicResource Brush.Upload}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding CurrentLiveUploadSpeedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PeakLiveUploadSpeedText, StringFormat='PEAK ↑ {0}'}" Classes="Caption" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Graph Canvas Area -->
                    <Grid Height="210">
                        <!-- Dynamic Y-Axis Labels -->
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="72" RowDefinitions="Auto,*,*,*,*,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopText}" Classes="Caption" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding YAxisMidHighText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMidText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding YAxisMidLowText}" Classes="Caption" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Text="{Binding YAxisMinText}" Classes="Caption" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Graph Canvas Container -->
                        <Border Grid.Column="0" Margin="78,0,0,0" ClipToBounds="True" Background="Transparent" 
                                PointerMoved="RealtimeGraph_PointerMoved" PointerExited="RealtimeGraph_PointerExited"
                                SizeChanged="ChartContainer_SizeChanged">
                            <Grid>
                                <!-- Horizontal Background Gridlines -->
                                <Canvas Height="180">
                                    <Line StartPoint="0,10"  EndPoint="2000,10"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.15"/>
                                    <Line StartPoint="0,50"  EndPoint="2000,50"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.12"/>
                                    <Line StartPoint="0,90"  EndPoint="2000,90"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.12"/>
                                    <Line StartPoint="0,130" EndPoint="2000,130" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.12"/>
                                    <Line StartPoint="0,170" EndPoint="2000,170" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.25"/>
                                </Canvas>

                                <!-- Empty State when Disconnected/Offline -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !IsRealtimeGraphLive}">
                                    <TextBlock Text="Network telemetry unavailable" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="Check active network connection" Classes="Caption" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Real-Time Download Series (Cyan Area + Stroke) -->
                                <Path Data="{Binding RealtimeDownloadAreaGeometry}" Fill="#2038BDF8" IsVisible="{Binding IsRealtimeGraphLive}"/>
                                <Path Data="{Binding RealtimeDownloadLineGeometry}" Stroke="{DynamicResource Brush.Download}" StrokeThickness="2" IsVisible="{Binding IsRealtimeGraphLive}"/>

                                <!-- Real-Time Upload Series (Violet Area + Stroke) -->
                                <Path Data="{Binding RealtimeUploadAreaGeometry}" Fill="#20A855F7" IsVisible="{Binding IsRealtimeGraphLive}"/>
                                <Path Data="{Binding RealtimeUploadLineGeometry}" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="2" IsVisible="{Binding IsRealtimeGraphLive}"/>

                                <!-- Glowing Dots on Latest Sample Point -->
                                <Canvas IsVisible="{Binding IsRealtimeGraphLive}">
                                    <Ellipse Canvas.Left="{Binding LatestDownloadX}" Canvas.Top="{Binding LatestDownloadY}" Width="8" Height="8" Margin="-4,-4,0,0" Fill="{DynamicResource Brush.Download}"/>
                                    <Ellipse Canvas.Left="{Binding LatestUploadX}" Canvas.Top="{Binding LatestUploadY}" Width="8" Height="8" Margin="-4,-4,0,0" Fill="{DynamicResource Brush.Upload}"/>
                                </Canvas>

                                <!-- Interactive Hover Line & Tooltip Card -->
                                <Canvas IsVisible="{Binding IsHoveringRealtimeGraph}">
                                    <!-- Vertical Hover Guide Line -->
                                    <Line Canvas.Left="{Binding HoverLineX}" StartPoint="0,0" EndPoint="0,180" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.8"/>

                                    <!-- Floating Tooltip Card -->
                                    <Border Canvas.Left="{Binding HoverLineX}" Canvas.Top="10" Margin="-60,0,0,0"
                                            Background="{DynamicResource Brush.SurfaceElevated}" 
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" 
                                            CornerRadius="8" Padding="12,8" BoxShadow="0 4 12 #40000000">
                                        <StackPanel Spacing="6" DataContext="{Binding HoveredRealtimePoint}">
                                            <TextBlock Text="{Binding TimeText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                            <Grid ColumnDefinitions="80,*">
                                                <TextBlock Grid.Column="0" Text="Download" Classes="Caption" Foreground="{DynamicResource Brush.Download}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="80,*">
                                                <TextBlock Grid.Column="0" Text="Upload" Classes="Caption" Foreground="{DynamicResource Brush.Upload}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding UploadSpeedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                            <Grid ColumnDefinitions="80,*">
                                                <TextBlock Grid.Column="0" Text="Total" Classes="Caption" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSpeedText}" Classes="Body" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Dynamic X-Axis Timestamps & Legend -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- X-Axis Relative Time Labels -->
                        <ItemsControl ItemsSource="{Binding TimeAxisLabels}" Margin="78,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="Caption" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}"/>
                                <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}"/>
                                <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 5. TWO SIDE-BY-SIDE PROCESS DONUT ANALYTICS PANELS ──────────────────────── -->
            <Grid ColumnDefinitions="*,16,*">

                <!-- LEFT: Today's Process Network Traffic Donut Panel -->
                <Border Grid.Column="0" Classes="AnalyticsSurface" Padding="18">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Multi-Segment Process Donut Chart -->
                        <Grid Height="170" HorizontalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding TopProcesses}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel Width="150" Height="150"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                        <Path Fill="{Binding PercentageOfTotal, Converter={x:Static conv:ProcessIndexColorConverter.Instance}}">
                                            <Path.Data>
                                                <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="((vm:DashboardViewModel)DataContext).TopProcesses" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <ToolTip.Tip>
                                                <Border Padding="10" Background="{DynamicResource Brush.Surface}" CornerRadius="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding ProcessName}" Classes="Body" FontWeight="Bold"/>
                                                        <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat='Share: {0:F1}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ToolTip.Tip>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Donut Center Hole -->
                            <Border Width="95" Height="95" CornerRadius="100" Background="{DynamicResource Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="TODAY" Classes="Caption" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TodayTotalText}" Classes="MetricSmall" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Process Legend Table -->
                        <ItemsControl ItemsSource="{Binding TopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,3">
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding PercentageOfTotal, Converter={x:Static conv:ProcessIndexColorConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Classes="Body" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DataSource}" Classes="Caption" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="BodySecondary" Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RIGHT: This Month's Process Network Traffic Donut Ring Panel -->
                <Border Grid.Column="2" Classes="AnalyticsSurface" Padding="18">
                    <StackPanel Spacing="16">
                        <TextBlock Text="This Month's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Download vs Upload Monthly Donut Ring -->
                        <Grid Height="170" HorizontalAlignment="Center">
                            <!-- Download Arc Segment (Cyan) -->
                            <Path Fill="{DynamicResource Brush.Download}">
                                <Path.Data>
                                    <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                        <Binding Source="{x:False}"/>
                                        <Binding Path="DownloadColumnWidth"/>
                                        <Binding Path="UploadColumnWidth"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>

                            <!-- Upload Arc Segment (Purple) -->
                            <Path Fill="{DynamicResource Brush.Upload}">
                                <Path.Data>
                                    <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                        <Binding Source="{x:True}"/>
                                        <Binding Path="DownloadColumnWidth"/>
                                        <Binding Path="UploadColumnWidth"/>
                                    </MultiBinding>
                                </Path.Data>
                            </Path>

                            <!-- Donut Center Hole -->
                            <Border Width="95" Height="95" CornerRadius="100" Background="{DynamicResource Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="THIS MONTH" Classes="Caption" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MonthTotalText}" Classes="MetricSmall" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Monthly Download / Upload Readouts -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Download Traffic" Classes="Body" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MonthDownloadedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding DownloadRatioText}" Classes="Caption" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Upload Traffic" Classes="Body" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding MonthUploadedText}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" Margin="8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding UploadRatioText}" Classes="Caption" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── 6. LIVE PROCESS TRAFFIC TABLE ───────────────────────────────────────────── -->
            <Border Classes="AnalyticsSurface" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Live Process Traffic" Classes="PanelTitle"/>

                    <!-- Table Header -->
                    <Grid ColumnDefinitions="*,120,120,120,90" Margin="0,4,0,4">
                        <TextBlock Grid.Column="0" Text="PROCESS" Classes="Caption" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="ACTIVITY" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Analytical Process Table Rows -->
                    <ItemsControl ItemsSource="{Binding LiveProcessTraffic}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ProcessNetworkUsage">
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="*,120,120,120,90">
                                        <!-- Process Name & Icon Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⚡" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding ProcessIdentifier}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Rate / Usage Columns -->
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadRateBytesPerSec, Converter={x:Static conv:ByteFormatConverter.Instance}, StringFormat='{}{0}/s'}" Classes="Body" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding UploadRateBytesPerSec, Converter={x:Static conv:ByteFormatConverter.Instance}, StringFormat='{}{0}/s'}" Classes="Body" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Live Active Indicator -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}"/>
                                            <TextBlock Text="Active" FontSize="11" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
