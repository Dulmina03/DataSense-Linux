<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             xmlns:conv="using:DataSense.Converters"
             x:DataType="vm:DashboardViewModel"
             x:Class="DataSense.Views.DashboardView"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Spacing="{Binding DashboardSpacing}" Margin="24">

            <!-- ── 1. HEADER BAR ───────────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- Left: Title & Subtitle -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Dashboard" Classes="PageTitle"/>
                    <TextBlock Text="Network usage &amp; application analytics" Classes="Caption"/>
                </StackPanel>

                <!-- Right: Status Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <!-- Live Connection Status Pill -->
                    <Border CornerRadius="16" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Success}" BorderThickness="1" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="Live connection" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Name Pill -->
                    <Border CornerRadius="16" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12,6" BoxShadow="inset 0 1 0 0 #20FFFFFF, 0 2 8 0 #15000000">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📶" Classes="Caption" VerticalAlignment="Center"/>
                            <TextBlock Text="Wi-Fi/network ▾" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" IsVisible="{Binding ShowNetworkInfo}"/>
                            <TextBlock Text="{Binding WifiSsid}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" IsVisible="{Binding ShowNetworkInfo}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ── 2. LARGE HERO NETWORK ANALYTICS SURFACE (FLOATING GLOW CARDS) ─────────────── -->
            <Border Classes="HeroSurface" Padding="20" IsVisible="{Binding ShowHeroNetwork}">
                <StackPanel Spacing="16">
                    <!-- Hero Header Label -->
                    <TextBlock Text="NETWORK ANALYTICS" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>

                    <!-- 3 Floating Glow Metric Instruments -->
                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <!-- 1. DOWNLOAD FLOATING GLOW CARD (Electric Violet Glow) -->
                        <Border Grid.Column="0" Classes="CardHero" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="M 7 2 L 7 9 M 4 6.5 L 7 9.5 L 10 6.5 M 2.5 10.5 L 2.5 12 C 2.5 12.5 3 13 3.5 13 L 10.5 13 C 11 13 11.5 12.5 11.5 12 L 11.5 10.5" Width="14" Height="14" Stroke="{DynamicResource Brush.Download}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                        <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding DownloadSpeedText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" Margin="0,2"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Peak in window:" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding PeakLiveDownloadSpeedText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. UPLOAD FLOATING GLOW CARD (Electric Cyan Glow) -->
                        <Border Grid.Column="2" Classes="CardHero" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="M 7 9.5 L 7 2.5 M 4 5 L 7 2 L 10 5 M 2.5 10.5 L 2.5 12 C 2.5 12.5 3 13 3.5 13 L 10.5 13 C 11 13 11.5 12.5 11.5 12 L 11.5 10.5" Width="14" Height="14" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                        <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding UploadSpeedText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" Margin="0,2"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Peak in window:" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding PeakLiveUploadSpeedText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. TODAY'S USAGE FLOATING GLOW CARD (Ambient Purple Glow) -->
                        <Border Grid.Column="4" Classes="CardHero" Padding="20">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="M 2.5 4 C 2.5 2.6 4.5 1.5 7 1.5 C 9.5 1.5 11.5 2.6 11.5 4 C 11.5 5.4 9.5 6.5 7 6.5 C 4.5 6.5 2.5 5.4 2.5 4 Z M 2.5 7.5 C 2.5 8.9 4.5 10 7 10 C 9.5 10 11.5 8.9 11.5 7.5 M 2.5 4 L 2.5 11 C 2.5 12.4 4.5 13.5 7 13.5 C 9.5 13.5 11.5 12.4 11.5 11 L 11.5 4" Width="14" Height="14" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                        <TextBlock Text="TODAY'S USAGE" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding TodayTotalText}" Classes="LargeMetric" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,2"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Daily transfer activity" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── 3. FOUR SECONDARY METRICS SURFACES ────────────────────────────── -->
                    <Grid ColumnDefinitions="*,8,*,8,*,8,*" Margin="0,4,0,0">
                        <Border Grid.Column="0" Classes="MetricSurface" Padding="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    <TextBlock Text="MONTH DOWNLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MonthDownloadedText}" Classes="MetricSmall" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="MetricSurface" Padding="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="MONTH UPLOAD" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MonthUploadedText}" Classes="MetricSmall" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Classes="MetricSurface" Padding="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.AccentHover}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CURRENT SESSION" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentSessionTotal}" Classes="MetricSmall" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Classes="MetricSurface" Padding="14,10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Brush.ChartSegment4}" VerticalAlignment="Center"/>
                                    <TextBlock Text="PROJECTED MONTH-END" Classes="Caption" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ForecastProjectedText}" Classes="MetricSmall" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 4. PREMIUM LIVE NETWORK THROUGHPUT GRAPH (60-SECOND ROLLING WINDOW) ─────── -->
            <Border Classes="AnalyticsSurface LiquidWaterCard" Padding="20" IsVisible="{Binding ShowLiveThroughputGraph}">
                <StackPanel Spacing="16">
                    <!-- Header with Title, Subtitle, and Live Speed Readouts -->
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Left: Title & Subtitle -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Network Traffic" Classes="PanelTitle"/>
                            <TextBlock Text="Live network throughput" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>

                        <!-- Right: Live Indicator & Live Speed Readouts (Electric Cyan Download / Violet Upload) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <!-- Live / Offline Status Pill -->
                            <Border CornerRadius="12" Padding="8,4" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                    <TextBlock Text="{Binding LiveGraphStatusText}" Classes="Caption" FontWeight="Bold" Foreground="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Download Speed -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="↓" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentLiveDownloadSpeedText}" Classes="MetricSmall" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Live Upload Speed -->
                            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="↑" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentLiveUploadSpeedText}" Classes="MetricSmall" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Graph Canvas Area with Y-Axis -->
                    <Grid Height="210">
                        <!-- Dynamic Y-Axis Labels (5 Levels) -->
                        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="72" RowDefinitions="Auto,*,*,*,*,Auto">
                            <TextBlock Grid.Row="0" Text="{Binding YAxisTopText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding YAxisMidHighText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding YAxisMidText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="{Binding YAxisMidLowText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="5" Text="{Binding YAxisMinText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Graph Canvas Container -->
                        <Border Grid.Column="0" Margin="78,0,0,0" ClipToBounds="True" Background="Transparent" 
                                PointerMoved="RealtimeGraph_PointerMoved" PointerExited="RealtimeGraph_PointerExited"
                                SizeChanged="ChartContainer_SizeChanged">
                            <Grid>
                                <!-- Horizontal Background Gridlines (5 Subtle Levels) -->
                                <Canvas Height="180">
                                    <Line StartPoint="0,10"  EndPoint="2000,10"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.08"/>
                                    <Line StartPoint="0,48"  EndPoint="2000,48"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.06"/>
                                    <Line StartPoint="0,88"  EndPoint="2000,88"  Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.06"/>
                                    <Line StartPoint="0,128" EndPoint="2000,128" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.06"/>
                                    <Line StartPoint="0,168" EndPoint="2000,168" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" Opacity="0.14"/>
                                </Canvas>

                                <!-- Loading State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsVisible="{Binding !HasRealtimeGraphData}">
                                    <TextBlock Text="Waiting for network traffic…" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="DataSense is sampling Linux network interface statistics." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- Disconnected State -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" IsVisible="{Binding !IsRealtimeGraphLive}">
                                    <TextBlock Text="No active network connection" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="Check active network connection or Wi-Fi state." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <!-- 1. UPLOAD SERIES: Flowing Glowing Violet Spline Wave -->
                                <Path Data="{Binding RealtimeUploadAreaGeometry}" Fill="{DynamicResource Brush.UploadAreaGradient}" IsVisible="{Binding HasRealtimeGraphData}"/>
                                <Path Data="{Binding RealtimeUploadLineGeometry}" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="2.0" IsVisible="{Binding HasRealtimeGraphData}"/>

                                <!-- 2. DOWNLOAD SERIES: Flowing Glowing Cyan Spline Wave -->
                                <Path Data="{Binding RealtimeDownloadAreaGeometry}" Fill="{DynamicResource Brush.DownloadAreaGradient}" IsVisible="{Binding HasRealtimeGraphData}"/>
                                <Path Data="{Binding RealtimeDownloadLineGeometry}" Stroke="{DynamicResource Brush.Download}" StrokeThickness="2.5" IsVisible="{Binding HasRealtimeGraphData}"/>

                                <!-- Glowing Head Dots on Latest Sample Point (NOW) -->
                                <Canvas IsVisible="{Binding HasRealtimeGraphData}">
                                    <!-- Cyan Download Endpoint with subtle outer ring -->
                                    <Ellipse Canvas.Left="{Binding LatestDownloadX}" Canvas.Top="{Binding LatestDownloadY}" Width="12" Height="12" Margin="-6,-6,0,0" Fill="{DynamicResource Brush.SurfaceElevated}" Stroke="{DynamicResource Brush.Download}" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="{Binding LatestDownloadX}" Canvas.Top="{Binding LatestDownloadY}" Width="6" Height="6" Margin="-3,-3,0,0" Fill="{DynamicResource Brush.Download}"/>

                                    <!-- Violet Upload Endpoint with subtle outer ring -->
                                    <Ellipse Canvas.Left="{Binding LatestUploadX}" Canvas.Top="{Binding LatestUploadY}" Width="12" Height="12" Margin="-6,-6,0,0" Fill="{DynamicResource Brush.SurfaceElevated}" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="1"/>
                                    <Ellipse Canvas.Left="{Binding LatestUploadX}" Canvas.Top="{Binding LatestUploadY}" Width="6" Height="6" Margin="-3,-3,0,0" Fill="{DynamicResource Brush.Upload}"/>
                                </Canvas>

                                <!-- Interactive Hover Guide Line & Floating Tooltip Card -->
                                <Canvas Height="180" IsVisible="{Binding IsChartTooltipVisible}">
                                    <!-- Vertical Guide Line -->
                                    <Line Canvas.Left="{Binding HoverLineX}" StartPoint="0,10" EndPoint="0,168" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1" StrokeDashArray="3,3" Opacity="0.9"/>

                                    <!-- Highlight Dots on Both Curves -->
                                    <Ellipse Canvas.Left="{Binding HoverLineX}" Canvas.Top="{Binding HoverDownloadY}" Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource Brush.Download}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="2"/>
                                    <Ellipse Canvas.Left="{Binding HoverLineX}" Canvas.Top="{Binding HoverUploadY}" Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource Brush.Upload}" Stroke="{DynamicResource Brush.Surface}" StrokeThickness="2"/>

                                    <!-- Floating Tooltip Card -->
                                    <Border Canvas.Left="{Binding HoverTooltipX}" Canvas.Top="6"
                                            Background="{DynamicResource Brush.SurfaceElevated}" 
                                            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" 
                                            CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="5" Width="145" DataContext="{Binding HoveredThroughputSample}">
                                            <TextBlock Text="{Binding FormattedTime}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,4"/>
                                            
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="↓" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                                    <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}"/>
                                            </Grid>

                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="↑" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                                    <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding UploadSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}"/>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,2"/>

                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="TOTAL" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalSpeedText}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Dynamic X-Axis ( -60s  -45s  -30s  -15s  NOW ) and Legend -->
                    <Grid Margin="78,4,0,0" ColumnDefinitions="*,Auto">
                        <!-- X-Axis Rolling Timestamps -->
                        <Grid ColumnDefinitions="*,*,*,*,*">
                            <TextBlock Grid.Column="0" Text="-60s" Classes="Caption" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="-45s" Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Grid.Column="2" Text="-30s" Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Grid.Column="3" Text="-15s" Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <TextBlock Grid.Column="4" Text="NOW" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </Grid>

                        <!-- Centered Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" Margin="24,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Download}"/>
                                <TextBlock Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Upload}"/>
                                <TextBlock Text="UPLOAD" Classes="Caption" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── 5. TWO SIDE-BY-SIDE PROCESS DONUT ANALYTICS PANELS ──────────────────────── -->
            <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding IsApplicationUsageVisible}">

                <!-- LEFT: Today's Process Network Traffic Donut Panel -->
                <Border Grid.Column="0" Classes="AnalyticsSurface LiquidWaterCard" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Empty State when no processes available -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,28" IsVisible="{Binding !HasTopProcesses}">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡" Classes="Body" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No process traffic recorded today" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="{Binding TopProcessesBaselineText}" Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Multi-Segment Process Donut Chart (Perfect 1:1 Circular Geometry) -->
                        <Grid Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasTopProcesses}">
                            <ItemsControl ItemsSource="{Binding TopProcesses}" Width="200" Height="200">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Panel Width="200" Height="200"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                        <Path Fill="{Binding Converter={x:Static conv:ProcessIndexGradientBrushConverter.Instance}}"
                                              Stroke="{DynamicResource Brush.Surface}"
                                              StrokeThickness="1"
                                              ToolTip.Tip="{Binding TooltipSummary}">
                                            <Path.Data>
                                                <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="((vm:DashboardViewModel)DataContext).TopProcesses" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Donut Center Hole -->
                            <Border Width="116" Height="116" CornerRadius="100" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" BoxShadow="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="TODAY" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TodayTotalText}" Classes="MetricSmall" FontWeight="Bold" HorizontalAlignment="Center"/>
                                 </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Process Legend Table (Deterministic Color Dots) -->
                        <ItemsControl ItemsSource="{Binding TopProcesses}" Margin="0,4,0,0" IsVisible="{Binding HasTopProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                    <Border Padding="6,4" CornerRadius="6" Background="Transparent" ToolTip.Tip="{Binding TooltipSummary}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Converter={x:Static conv:ProcessIndexGradientBrushConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EffectiveDisplayName}" Classes="Body" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="BodySecondary" Margin="10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" Width="44" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- RIGHT: This Month's Process Network Traffic Donut Ring Panel -->
                <Border Grid.Column="2" Classes="AnalyticsSurface LiquidWaterCard" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="This Month's Process Network Traffic" Classes="PanelTitle"/>

                        <!-- Empty State when no monthly processes available -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,28" IsVisible="{Binding !HasTopMonthProcesses}">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚡" Classes="Body" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="No monthly process traffic recorded" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <TextBlock Text="Monthly application usage will accumulate as network activity is monitored." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Multi-Segment Monthly Process Donut Chart (Perfect 1:1 Circular Geometry) -->
                        <Grid Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasTopMonthProcesses}">
                            <ItemsControl ItemsSource="{Binding TopMonthProcesses}" Width="200" Height="200">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Panel Width="200" Height="200"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                        <Path Fill="{Binding Converter={x:Static conv:ProcessIndexGradientBrushConverter.Instance}}"
                                              Stroke="{DynamicResource Brush.Surface}"
                                              StrokeThickness="1"
                                              ToolTip.Tip="{Binding TooltipSummary}">
                                            <Path.Data>
                                                <MultiBinding Converter="{x:Static conv:DonutArcPathConverter.Instance}">
                                                    <Binding />
                                                    <Binding Path="((vm:DashboardViewModel)DataContext).TopMonthProcesses" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Path.Data>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Donut Center Hole -->
                            <Border Width="116" Height="116" CornerRadius="100" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" BoxShadow="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="THIS MONTH" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding MonthTotalText}" Classes="MetricSmall" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Process Legend Table (Deterministic Color Dots) -->
                        <ItemsControl ItemsSource="{Binding TopMonthProcesses}" Margin="0,4,0,0" IsVisible="{Binding HasTopMonthProcesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:ApplicationHistoricalProfile">
                                    <Border Padding="6,4" CornerRadius="6" Background="Transparent" ToolTip.Tip="{Binding TooltipSummary}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Converter={x:Static conv:ProcessIndexGradientBrushConverter.Instance}}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EffectiveDisplayName}" Classes="Body" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="BodySecondary" Margin="10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" Width="44" TextAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ── 6. PREMIUM LIVE PROCESS TRAFFIC TABLE ─────────────────────────────────── -->
            <Border Classes="AnalyticsSurface LiquidWaterCard" Padding="20" IsVisible="{Binding IsApplicationUsageVisible}">
                <StackPanel Spacing="16">
                    <!-- Header with Title, Subtitle, and Live Badge -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Live Process Traffic" Classes="PanelTitle"/>
                            <TextBlock Text="Real-time application network activity" Classes="Caption"/>
                        </StackPanel>

                        <!-- Live Status Pill -->
                        <Border Grid.Column="1" CornerRadius="12" Padding="8,3" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                                <TextBlock Text="{Binding LiveGraphStatusText}" Classes="Caption" FontWeight="Bold" Foreground="{Binding LiveGraphStatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Table Column Headers -->
                    <Grid ColumnDefinitions="*,1.15*,1.15*,Auto" Margin="12,4,12,0">
                        <TextBlock Grid.Column="0" Text="PROCESS" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Grid.Column="3" Text="ACTIVITY" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Opacity="0.5"/>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="0,28" IsVisible="{Binding !HasLiveProcessTraffic}">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚡" Classes="Body" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No active network traffic" Classes="Body" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Text="Applications using network bandwidth will appear here automatically." Classes="Caption" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </StackPanel>

                    <!-- Process Table Rows -->
                    <ItemsControl ItemsSource="{Binding LiveProcessTraffic}" IsVisible="{Binding HasLiveProcessTraffic}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ProcessNetworkUsage">
                                <Border Classes="ProcessRow">
                                    <Grid ColumnDefinitions="*,1.15*,1.15*,Auto" VerticalAlignment="Center">
                                        <!-- 1. Process Column: [Icon] Application Name & Live Subtitle -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image Source="{Binding ApplicationIcon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EffectiveDisplayName}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <Ellipse Width="5" Height="5" Fill="{Binding ActivityColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActivityText}" Classes="Caption" Foreground="{Binding ActivityColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 2. DOWNLOAD: ↓ formatted speed in cyan -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="↓" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadRateText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 3. UPLOAD: ↑ formatted speed in violet -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="↑" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UploadRateText}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- 4. ACTIVITY: calm status badge -->
                                        <Border Grid.Column="3" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding ActivityColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ActivityText}" Classes="Caption" FontWeight="SemiBold" Foreground="{Binding ActivityColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
