<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:DataSense.Converters"

             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="900"
             x:Class="DataSense.Views.DashboardView"
             xmlns:m="using:DataSense.Models"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <Style Selector="Border.stat-card">
            <Setter Property="Background"      Value="#1A1A2E"/>
            <Setter Property="BorderBrush"     Value="#2D2D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>
        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#555577"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.insight-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#444466"/>
        </Style>
        <Style Selector="TextBlock.insight-value">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CCCCEE"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="16">

            <!-- ══ Top Status Banner ══ -->
            <Border Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="20,14">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Network Interface Telemetry" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Active Adapter:" Foreground="#888899" FontSize="13"/>
                            <TextBlock Text="{Binding ActiveInterface}" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Download speed inline -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="⬇" Foreground="#00D2FF" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadSpeedText}" Foreground="#00D2FF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Upload speed inline -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="⬆" Foreground="#00E676" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UploadSpeedText}" Foreground="#00E676" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Status badge -->
                    <Border Grid.Column="3" Background="#1A1A28" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" Fill="{Binding StatusDotColor}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Foreground="#E0E0E0" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ Live Metric Cards ══ -->
            <Grid ColumnDefinitions="1.2*,12,*,12,*,12,*,12,*">
                <!-- Network Info -->
                <Border Grid.Column="0" Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding NetworkTypeText}" FontSize="12" Foreground="#888899"/>
                        <TextBlock Text="{Binding NetworkIdentityText}" FontSize="18" FontWeight="Bold" Foreground="#CCCCEE" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <!-- Download Speed -->
                <Border Grid.Column="2" Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Download Speed" FontSize="12" Foreground="#888899"/>
                        <TextBlock Text="{Binding DownloadSpeedText}" FontSize="18" FontWeight="Bold" Foreground="#00D2FF"/>
                    </StackPanel>
                </Border>
                <!-- Upload Speed -->
                <Border Grid.Column="4" Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Upload Speed" FontSize="12" Foreground="#888899"/>
                        <TextBlock Text="{Binding UploadSpeedText}" FontSize="18" FontWeight="Bold" Foreground="#00E676"/>
                    </StackPanel>
                </Border>
                <!-- Total Downloaded -->
                <Border Grid.Column="6" Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Total Downloaded" FontSize="12" Foreground="#888899"/>
                        <TextBlock Text="{Binding TotalDownloadedText}" FontSize="18" FontWeight="Bold" Foreground="#AB47BC"/>
                    </StackPanel>
                </Border>
                <!-- Total Uploaded -->
                <Border Grid.Column="8" Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Total Uploaded" FontSize="12" Foreground="#888899"/>
                        <TextBlock Text="{Binding TotalUploadedText}" FontSize="18" FontWeight="Bold" Foreground="#FF9800"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ Connection Details Panel ══ -->
            <Border Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Network Connection Details" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" IsIndeterminate="True" Height="4" Width="50" IsVisible="{Binding IsConnectionDetailsLoading}"/>
                        <Button Grid.Column="2" Content="Analytics ➔" Classes="link-button" Foreground="#8888FF" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding NavigateToNetworkAnalyticsCommand}" CommandParameter="{Binding ConnectionName}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,24,*">
                        <!-- Left column -->
                        <StackPanel Grid.Column="0" Spacing="10">
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Interface:"       Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveInterface}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Connection Type:" Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Profile Name:"   Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Status State:"   Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="MAC Address:"    Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding MacAddress}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*" IsVisible="{Binding HasWifi}">
                                <TextBlock Grid.Column="0" Text="Wi-Fi SSID:"     Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding WifiSsid}" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                        <!-- Right column -->
                        <StackPanel Grid.Column="2" Spacing="10">
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="IPv4 Address:"   Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ipv4Address}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="IPv6 Address:"   Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Ipv6Address}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Default Gateway:" Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Gateway}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="DNS Server(s):"  Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding DnsServers}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*">
                                <TextBlock Grid.Column="0" Text="Link Speed:"     Foreground="#888899" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding LinkSpeed}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                            </Grid>
                            <Grid ColumnDefinitions="140,*" IsVisible="{Binding HasWifi}">
                                <TextBlock Grid.Column="0" Text="Signal Strength:" Foreground="#888899" FontSize="13"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding WifiSignalStrengthText}" Foreground="#00E676" FontWeight="SemiBold" FontSize="13"/>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding WifiSignalStrength}"
                                                 Width="80" Height="8" Background="#262636" Foreground="#00E676"
                                                 BorderThickness="0" CornerRadius="4" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ Analytics Loading ══ -->
            <Border IsVisible="{Binding IsAnalyticsLoading}"
                    Background="#13131F" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="4"/>
                    <TextBlock Text="Loading analytics…" Foreground="#7777AA" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══ Analytics Error ══ -->
            <Border IsVisible="{Binding AnalyticsError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="#1A0A0A" BorderBrush="#551111" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⚠️" FontSize="13"/>
                    <TextBlock Text="{Binding AnalyticsError}" Foreground="#FF6666" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ══ Analytics Sections ══ -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsAnalyticsLoading}">

                <!-- Section 1: Today & This Month -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📊" FontSize="14"/>
                                <TextBlock Text="Usage Summary" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,16,*">
                            <!-- TODAY column -->
                            <StackPanel Grid.Column="0" Spacing="10">
                                <TextBlock Text="TODAY" Classes="section-label"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <Border Grid.Column="0" Classes="stat-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="⬇  Downloaded" Foreground="#336688" FontSize="10"/>
                                            <TextBlock Text="{Binding TodayDownloadedText}" FontSize="16" FontWeight="Bold" Foreground="#00D2FF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="stat-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="⬆  Uploaded" Foreground="#226633" FontSize="10"/>
                                            <TextBlock Text="{Binding TodayUploadedText}" FontSize="16" FontWeight="Bold" Foreground="#00E676"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Classes="stat-card" Background="#1A1A3A" BorderBrush="#3535AA">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="∑  Total" Foreground="#7777BB" FontSize="10"/>
                                            <TextBlock Text="{Binding TodayTotalText}" FontSize="16" FontWeight="Bold" Foreground="#8888FF"/>
                                            <!-- Delta vs yesterday -->
                                            <TextBlock Text="{Binding TodayVsYesterdayText}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding TodayDeltaColor}"
                                                       IsVisible="{Binding HasTodayDelta}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Yesterday reference -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Yesterday:" Classes="insight-label"/>
                                    <TextBlock Text="{Binding YesterdayTotalText}" FontSize="11" Foreground="#888899"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="#2D2D44" VerticalAlignment="Stretch"/>

                            <!-- THIS MONTH column -->
                            <StackPanel Grid.Column="2" Spacing="10">
                                <TextBlock Text="THIS MONTH" Classes="section-label"/>
                                <Grid ColumnDefinitions="*,8,*,8,*">
                                    <Border Grid.Column="0" Classes="stat-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="⬇  Downloaded" Foreground="#336688" FontSize="10"/>
                                            <TextBlock Text="{Binding MonthDownloadedText}" FontSize="16" FontWeight="Bold" Foreground="#00D2FF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="stat-card">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="⬆  Uploaded" Foreground="#226633" FontSize="10"/>
                                            <TextBlock Text="{Binding MonthUploadedText}" FontSize="16" FontWeight="Bold" Foreground="#00E676"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Classes="stat-card" Background="#1A1A3A" BorderBrush="#3535AA">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="∑  Total" Foreground="#7777BB" FontSize="10"/>
                                            <TextBlock Text="{Binding MonthTotalText}" FontSize="16" FontWeight="Bold" Foreground="#8888FF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 2: Network Intelligence -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16" IsVisible="{Binding HasInsights}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🧠" FontSize="14"/>
                            <TextBlock Text="Network Intelligence" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding Insights}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Margin="-4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="m:NetworkInsight">
                                    <Border Background="#1A1A2E" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4" Width="300" 
                                            Cursor="Hand"
                                            PointerPressed="OnInsightCardPressed">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="Background" Value="#222238"/>
                                                <Setter Property="BorderBrush" Value="#444466"/>
                                            </Style>
                                        </Border.Styles>
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Severity, Converter={x:Static conv:InsightSeverityIconConverter.Instance}}" FontSize="14"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{Binding Severity, Converter={x:Static conv:InsightSeverityColorConverter.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#CCCCEE" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 3: Download vs Upload Ratio -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚖️" FontSize="14"/>
                            <TextBlock Text="Download vs Upload  —  This Month" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- No data message -->
                        <TextBlock Text="No data recorded this month."
                                   Foreground="#555577" FontSize="13"
                                   IsVisible="{Binding !HasMonthData}"
                                   HorizontalAlignment="Center" Margin="0,8"/>

                        <!-- Proportional bar (only when data exists) -->
                        <Border IsVisible="{Binding HasMonthData}" CornerRadius="4" ClipToBounds="True" Height="22" Background="#0D0D18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding DownloadColumnWidth}"/>
                                    <ColumnDefinition Width="{Binding UploadColumnWidth}"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="#00D2FF" Opacity="0.85"/>
                                <Rectangle Grid.Column="1" Fill="#00E676" Opacity="0.85"/>
                            </Grid>
                        </Border>

                        <!-- Legend with byte values -->
                        <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding HasMonthData}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" Fill="#00D2FF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Download" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DownloadActualText}" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DownloadRatioText}" Foreground="#446688" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Rectangle Width="12" Height="12" Fill="#00E676" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Upload" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UploadActualText}" Foreground="#00E676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding UploadRatioText}" Foreground="#336644" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 4: 14-Day Bar Chart -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📅" FontSize="14"/>
                            <TextBlock Text="Daily Usage — Last 14 Days" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="10" Height="10" Fill="#00D2FF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Download" Foreground="#666688" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="10" Height="10" Fill="#00E676" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                <TextBlock Text="Upload" Foreground="#666688" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Empty state -->
                        <Border IsVisible="{Binding IsChartEmpty}"
                                Background="#0D0D18" CornerRadius="6" Padding="20" Height="200">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="No usage data for the last 14 days"
                                           Foreground="#555577" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Chart canvas — stretches to fill available width -->
                        <StackPanel IsVisible="{Binding !IsChartEmpty}" Spacing="0">
                            <!-- Bars -->
                            <Grid Height="160" SizeChanged="ChartContainer_SizeChanged">
                                <!-- Grid lines -->
                                <Canvas>
                                    <Line StartPoint="0,0"   EndPoint="2000,0"   Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                    <Line StartPoint="0,40"  EndPoint="2000,40"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,80"  EndPoint="2000,80"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,120" EndPoint="2000,120" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,160" EndPoint="2000,160" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                </Canvas>
                                <!-- Bars -->
                                <ItemsControl ItemsSource="{Binding DailyChartItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Height="160"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DailyChartBarViewModel">
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}"
                                                           Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}"
                                                           Fill="#00E676" Opacity="0.85" RadiusX="3" RadiusY="3"
                                                           ToolTip.Tip="{Binding Tooltip}"/>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}"
                                                           Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}"
                                                           Fill="#00D2FF" Opacity="0.85"
                                                           ToolTip.Tip="{Binding Tooltip}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <!-- Day labels -->
                            <ItemsControl ItemsSource="{Binding DailyChartItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="28"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DailyChartBarViewModel">
                                        <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="4"
                                                   Text="{Binding DayLabel}"
                                                   FontSize="10" Foreground="#7777AA"
                                                   Width="{Binding BarWidth}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 5: Advanced Period Trend -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📈" FontSize="14"/>
                                <TextBlock Text="Network Usage Trend" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                            </StackPanel>
                            <!-- Period Selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding !IsPeriodAnalyticsLoading}">
                                <Button Content="Today"      Command="{Binding SelectPeriodCommand}" CommandParameter="Today"      Classes="link-button" Background="Transparent" Foreground="{Binding SelectedPeriod, Converter={x:Static StringConverters.IsNullOrEmpty}}"/> <!-- TODO: custom converter or style for active state -->
                                <Button Content="7 Days"     Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days"  Classes="link-button" Background="Transparent"/>
                                <Button Content="30 Days"    Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="link-button" Background="Transparent"/>
                                <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth"  Classes="link-button" Background="Transparent"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsPeriodAnalyticsLoading}" Foreground="#00D2FF"/>

                        <Border IsVisible="{Binding IsPeriodChartEmpty}" Background="#0D0D18" CornerRadius="6" Padding="20" Height="200">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="No usage data for the selected period" Foreground="#555577" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel IsVisible="{Binding !IsPeriodChartEmpty}" Spacing="0">
                            <Grid Height="160" SizeChanged="ChartContainer_SizeChanged">
                                <Canvas>
                                    <Line StartPoint="0,0"   EndPoint="2000,0"   Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                    <Line StartPoint="0,40"  EndPoint="2000,40"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,80"  EndPoint="2000,80"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,120" EndPoint="2000,120" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                    <Line StartPoint="0,160" EndPoint="2000,160" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                </Canvas>
                                <!-- Daily Bars -->
                                <ItemsControl ItemsSource="{Binding PeriodChartItems}" IsVisible="{Binding !IsHourlyChart}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="160"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DailyChartBarViewModel">
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}" Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}" Fill="#00E676" Opacity="0.85" RadiusX="3" RadiusY="3" ToolTip.Tip="{Binding Tooltip}"/>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}" Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}" Fill="#00D2FF" Opacity="0.85" ToolTip.Tip="{Binding Tooltip}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Hourly Bars -->
                                <ItemsControl ItemsSource="{Binding HourlyChartItems}" IsVisible="{Binding IsHourlyChart}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="160"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:HourlyChartBarViewModel">
                                            <Canvas>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}" Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}" Fill="#00E676" Opacity="0.85" RadiusX="3" RadiusY="3" ToolTip.Tip="{Binding Tooltip}"/>
                                                <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}" Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}" Fill="#00D2FF" Opacity="0.85" ToolTip.Tip="{Binding Tooltip}"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            
                            <!-- Day Labels -->
                            <ItemsControl ItemsSource="{Binding PeriodChartItems}" IsVisible="{Binding !IsHourlyChart}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DailyChartBarViewModel">
                                        <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="4" Text="{Binding DayLabel}" FontSize="10" Foreground="#7777AA" Width="{Binding BarWidth}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Hourly Labels -->
                            <ItemsControl ItemsSource="{Binding HourlyChartItems}" IsVisible="{Binding IsHourlyChart}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:HourlyChartBarViewModel">
                                        <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="4" Text="{Binding HourLabel}" FontSize="9" Foreground="#7777AA" Width="{Binding BarWidth}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 6: Analytics Summary -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Analytics Summary" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                        <Grid ColumnDefinitions="*,12,*,12,*,12,*,12,*">
                            <Border Grid.Column="0" Classes="stat-card" Background="#1A1A2E">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Avg Daily" Classes="insight-label"/>
                                    <TextBlock Text="{Binding PeriodAvgDailyText}" Classes="insight-value" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="stat-card" Background="#1A1A2E">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Peak Day" Classes="insight-label"/>
                                    <TextBlock Text="{Binding PeriodPeakDayText}" Classes="insight-value" Foreground="#FF9800"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="stat-card" Background="#1A1A2E">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⬇ Downloaded" Classes="insight-label" Foreground="#00D2FF"/>
                                    <TextBlock Text="{Binding PeriodTotalDownloadedText}" Classes="insight-value" Foreground="#00D2FF"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Classes="stat-card" Background="#1A1A2E">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="⬆ Uploaded" Classes="insight-label" Foreground="#00E676"/>
                                    <TextBlock Text="{Binding PeriodTotalUploadedText}" Classes="insight-value" Foreground="#00E676"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="8" Classes="stat-card" Background="#1A1A2E" BorderBrush="#3535AA">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Total Usage" Classes="insight-label" Foreground="#8888FF"/>
                                    <TextBlock Text="{Binding PeriodTotalUsageText}" Classes="insight-value" Foreground="#8888FF"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 7: Peak Usage -->
                <Grid ColumnDefinitions="*,12,*">
                    <Border Grid.Column="0" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🔥  Peak Hour Today" Classes="insight-label"/>
                            <TextBlock Text="{Binding PeakHourText}" Classes="insight-value" Foreground="#FF5252"/>
                            <TextBlock Text="{Binding PeakHourUsageText}" Classes="insight-label" Foreground="#AA5555"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🏆  Highest Day in Period" Classes="insight-label"/>
                            <TextBlock Text="{Binding PeakDayInPeriodText}" Classes="insight-value" Foreground="#FFB300"/>
                            <TextBlock Text="{Binding PeakDayInPeriodUsageText}" Classes="insight-label" Foreground="#AA8800"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Section 8: Top Data Consumers & Live Traffic -->
                <Grid ColumnDefinitions="*,12,1.2*">
                    <!-- Top Data Consumers (Period-based) -->
                    <Border Grid.Column="0" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="👑" FontSize="14"/>
                                <TextBlock Text="Top Data Consumers" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding TopProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1A2E" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <!-- Process Name -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="#CCCCEE" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                
                                                <!-- Total bytes -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="⬇" Foreground="#00D2FF" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BytesDownloaded, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00D2FF" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="⬆" Foreground="#00E676" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BytesUploaded, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00E676" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Action Button -->
                                                <Button Grid.Column="2" 
                                                        Content="Analytics ➔" 
                                                        Classes="link-button" 
                                                        Foreground="#8888FF"
                                                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).NavigateToProcessAnalyticsCommand}"
                                                        CommandParameter="{Binding ProcessName}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <TextBlock Text="No processes found for this period." 
                                       Foreground="#555577" FontSize="13" 
                                       IsVisible="{Binding !TopProcesses.Count}" 
                                       HorizontalAlignment="Center" Margin="0,16"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Live Process Network Traffic -->
                    <Border Grid.Column="2" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚡" FontSize="14"/>
                                    <TextBlock Text="Live Process Traffic" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#00E676" VerticalAlignment="Center">
                                    <!-- Simple pulse animation could go here -->
                                </Ellipse>
                            </Grid>
                            
                            <!-- Table Header -->
                            <Border Background="#13131F" Margin="0,0,0,4" Padding="12,8">
                                <Grid ColumnDefinitions="*,100,100,90">
                                    <TextBlock Grid.Column="0" Text="Process" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="Download" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Upload" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            
                            <!-- Table Body -->
                            <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LiveProcessTraffic}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#2D2D44" BorderThickness="0,0,0,1" Padding="12,8">
                                                <Grid ColumnDefinitions="*,100,100,90">
                                                    <!-- Process Column -->
                                                    <TextBlock Grid.Column="0" Text="{Binding ProcessIdentifier}" Foreground="#CCCCEE" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    
                                                    <!-- Download Column -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="⬇" Foreground="#00D2FF" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DownloadRateBytesPerSec, Converter={x:Static conv:SpeedFormatConverter.Instance}}" Foreground="#00D2FF" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Upload Column -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="⬆" Foreground="#00E676" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding UploadRateBytesPerSec, Converter={x:Static conv:SpeedFormatConverter.Instance}}" Foreground="#00E676" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Action Column -->
                                                    <Button Grid.Column="3" Content="Analytics ➔" 
                                                            Classes="link-button" 
                                                            Foreground="#8888FF"
                                                            FontSize="11"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).NavigateToProcessAnalyticsCommand}"
                                                            CommandParameter="{Binding ProcessIdentifier}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
