<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.PerformanceView"
             x:DataType="vm:PerformanceViewModel"
             xmlns:conv="using:DataSense.Converters">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                            <TextBlock Text="Performance &amp; Resource Monitor" Classes="PageTitle"/>
                            <Border Classes="StatusPill" Padding="12,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" Classes="Caption" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Real-time DataSense process CPU, working set, thread counts, and operation latencies." Classes="BodySecondary"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                        <Button Content="Toggle Sampling" Command="{Binding ToggleMonitoringCommand}" Classes="Secondary"/>
                        <Button Content="Clear Metrics" Command="{Binding ClearHistoryCommand}" Classes="Secondary"/>
                        <Button Content="Export Report" Command="{Binding ExportReportCommand}" Classes="Secondary"/>
                    </StackPanel>
                </Grid>

                <!-- ── METRICS SUMMARY HERO ───────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Process CPU -->
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="PROCESS CPU" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CpuText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="DataSense process load" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Working Set -->
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="WORKING SET" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MemoryText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Success}"/>
                            <TextBlock Text="Total physical memory" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Managed Heap -->
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="MANAGED HEAP" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ManagedHeapText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text=".NET GC allocated bytes" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Active Threads -->
                        <StackPanel Grid.Column="3" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="ACTIVE THREADS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ThreadsText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Warning}"/>
                            <TextBlock Text="Active execution threads" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── RECOMMENDATIONS SECTION ──────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="{DynamicResource Padding.Large}">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="OPTIMIZATION RECOMMENDATIONS" Classes="PanelTitle"/>

                        <StackPanel Classes="EmptyState" IsVisible="{Binding !Recommendations.Count}" Margin="0,16">
                            <TextBlock Text="No active optimization recommendations." Classes="BodySecondary" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PerformanceRecommendation">
                                    <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="16" Margin="0,0,0,8">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="⚠️" Classes="Caption" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="4" Margin="24,6,0,0">
                                                <TextBlock Text="{Binding Description}" Classes="BodySecondary"/>
                                                <TextBlock Text="{Binding Evidence}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding Recommendation}" Classes="Caption" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── OPERATION PERFORMANCE TABLE ─────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <TextBlock Text="OPERATION LATENCY &amp; DURATION METRICS" Classes="PanelTitle" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Padding="16,12">
                            <Grid ColumnDefinitions="*,120,100,100,100">
                                <TextBlock Grid.Column="0" Text="OPERATION" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="CATEGORY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="LAST (MS)" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="AVG (MS)" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="CALLS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !Metrics.Count}" Margin="0,32">
                            <TextBlock Text="No operation metrics recorded." Classes="BodySecondary" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:PerformanceMetric">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid ColumnDefinitions="*,120,100,100,100">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Category}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LastDurationMs, StringFormat='{}{0:F1}'}" Classes="Body" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AverageDurationMs, StringFormat='{}{0:F1}'}" Classes="Body" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding InvocationCount}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
