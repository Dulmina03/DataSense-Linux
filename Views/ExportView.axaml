<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.ExportView"
             x:DataType="vm:ExportViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="📤 Data Export, Reports &amp; Portability" Classes="PageTitle"/>
                <TextBlock Text="Export your DataSense telemetry to CSV, JSON, TXT reports, or complete ZIP backups." Classes="BodySecondary"/>
            </StackPanel>

            <!-- Custom Export Config Card -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="⚙️ Custom Data Export Options" Classes="SectionTitle" Foreground="{DynamicResource Brush.Download}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,10,0">
                            <TextBlock Text="Export Format" Classes="Caption" FontWeight="Bold"/>
                            <ComboBox SelectedIndex="{Binding SelectedFormatIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="CSV (Comma Separated Values)"/>
                                <ComboBoxItem Content="JSON (Structured Telemetry)"/>
                                <ComboBoxItem Content="TXT (Human-Readable Summary Report)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12" Margin="10,0,0,0">
                            <TextBlock Text="Data Content" Classes="Caption" FontWeight="Bold"/>
                            <ComboBox SelectedIndex="{Binding SelectedDataTypeIndex}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Usage Telemetry History"/>
                                <ComboBoxItem Content="Network Session Records"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox IsChecked="{Binding AnonymizeNetworks}" Content="Anonymize Network Names (Privacy Option)" Classes="Caption"/>

                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <Button Content="🚀 Start Export" Command="{Binding StartExportCommand}" IsEnabled="{Binding !IsExporting}" Classes="Primary" HorizontalAlignment="Left"/>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" IsVisible="{Binding IsExporting}" Height="4" Foreground="{DynamicResource Brush.Success}"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Success}" Classes="Caption" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Complete Backup Card -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="📦 Complete Data Backup (.ZIP)" Classes="SectionTitle" Foreground="{DynamicResource Brush.Warning}"/>
                    <Separator Background="{DynamicResource Brush.Border}"/>
                    <TextBlock Text="Create a full, portable .zip archive containing your local datasense.db SQLite database and backup metadata for safety or migration." Classes="Caption" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <Button Content="💾 Create Full ZIP Backup" Command="{Binding CreateBackupCommand}" Classes="Primary" Background="{DynamicResource Brush.Warning}" Foreground="{DynamicResource Brush.Surface}"/>
                        <TextBlock Text="{Binding BackupStatusText}" Foreground="{DynamicResource Brush.Success}" Classes="Caption" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recent Exports Table -->
            <Border Classes="Card">
                <StackPanel Spacing="{DynamicResource Spacing.MD}">
                    <TextBlock Text="📋 Recent Export History" Classes="SectionTitle"/>
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ExportItemHistory">
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8" Margin="0,2">
                                    <Grid ColumnDefinitions="*,100,100,100">
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Classes="Body" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="Caption" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="Caption" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Classes="Caption" Foreground="{DynamicResource Brush.Success}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
