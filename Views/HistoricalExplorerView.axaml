<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoricalExplorerView"
             x:DataType="vm:HistoricalExplorerViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.hero-card">
            <Setter Property="Background" Value="#1D1D35"/>
            <Setter Property="BorderBrush" Value="#3D3D66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.preset-btn">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.preset-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2A48"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="#0F0F1A">
        <!-- ── Header Toolbar ── -->
        <Border Grid.Row="0" Background="#141422" BorderBrush="#222236" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🏛️ Historical Usage Explorer" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#2A2A48" CornerRadius="12" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding CanDrillUp}">
                            <TextBlock Text="{Binding DrillHeaderText}" FontSize="11" Foreground="#00E676" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Explore network usage across time, applications, and networks." FontSize="12" Foreground="#8888AA"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="⬆ Drill Up" Command="{Binding DrillUpCommand}" IsVisible="{Binding CanDrillUp}" Classes="preset-btn"/>

                    <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedPreset}" MinWidth="140" Background="#1A1A2E" Foreground="#CCCCDD">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" MinWidth="120" Background="#1A1A2E" Foreground="#CCCCDD"/>

                    <Button Content="🔄" Command="{Binding RefreshCommand}" Classes="preset-btn" ToolTip.Tip="Refresh"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main Content Area ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Spacing="20" MaxWidth="1400">
                <!-- ── Summary Cards Grid ── -->
                <UniformGrid Columns="4" Rows="1">
                    <Border Classes="hero-card" Margin="0,0,8,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🌐 Total Usage" Foreground="#8888CC" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalText}" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PeriodLabel}" Foreground="#666688" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="4,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⬇ Downloaded" Foreground="#00D2FF" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DownloadText}" Foreground="#00D2FF" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ActiveDaysText}" Foreground="#666688" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="4,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⬆ Uploaded" Foreground="#00E676" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UploadText}" Foreground="#00E676" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AvgDailyText, StringFormat='Avg {0}/day'}" Foreground="#666688" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="8,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="⚡ Peak Usage Day" Foreground="#FF9800" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PeakDayText}" Foreground="#FF9800" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ── Period Comparison Banner ── -->
                <Border Classes="card" IsVisible="{Binding HasComparison}">
                    <Grid ColumnDefinitions="*,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Current Period" Foreground="#8888AA" FontSize="11"/>
                            <TextBlock Text="{Binding CompareCurrentLabel}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CompareCurrentTotal}" Foreground="#8888FF" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="vs" Foreground="#555577" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Previous Period" Foreground="#8888AA" FontSize="11"/>
                            <TextBlock Text="{Binding ComparePreviousLabel}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ComparePreviousTotal}" Foreground="#AAAACC" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="#222238" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Change:" Foreground="#8888AA" FontSize="12"/>
                                <TextBlock Text="{Binding CompareChangeText}" Foreground="{Binding CompareChangeColor}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Monthly Trend Bars (Drill Level: Month) ── -->
                <Border Classes="card" IsVisible="{Binding ShowMonthly}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Monthly Usage Breakdown (Last 12 Months)" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding MonthBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MonthBarViewModel">
                                    <StackPanel Spacing="6" Width="60" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalText}" Foreground="#AAAACC" FontSize="9" HorizontalAlignment="Center"/>
                                        <Grid Height="120" VerticalAlignment="Bottom">
                                            <Border Height="{Binding BarHeight}" Width="32" Background="#2A2A4D" CornerRadius="4" VerticalAlignment="Bottom"/>
                                            <Border Height="{Binding DownloadHeight}" Width="32" Background="#00D2FF" CornerRadius="4" VerticalAlignment="Bottom" Opacity="0.8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MonthLabel}" Foreground="#8888AA" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Two Column: Apps & Spikes ── -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Top Applications -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top Applications in Selected Period" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding AppRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AppUsageRowViewModel">
                                        <Grid ColumnDefinitions="120,*,80" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Foreground="#E0E0E0" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding PercentValue}" Maximum="100" Height="8" VerticalAlignment="Center" Margin="8,0" Foreground="#8888FF" Background="#222238"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="#8888FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Usage Spikes -->
                    <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Notable Usage Spikes" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding Spikes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SpikeRowViewModel">
                                        <Border Background="#202032" CornerRadius="6" Padding="10,8" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="⚡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Description}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DateLabel}" Foreground="#8888AA" FontSize="10"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="#FF9800" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No significant usage spikes detected." IsVisible="{Binding !Spikes.Count}" Foreground="#666688" FontSize="12" HorizontalAlignment="Center" Margin="0,12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Daily Breakdown Table ── -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Daily Usage Breakdown (Click row to drill into hourly data)" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>

                        <Border Background="#12121E" CornerRadius="6" Padding="12,8">
                            <Grid ColumnDefinitions="60,*,120,120,120,80">
                                <TextBlock Grid.Column="0" Text="Day" Foreground="#666688" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Date" Foreground="#666688" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Downloaded" Foreground="#00D2FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Uploaded" Foreground="#00E676" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Total" Foreground="#8888FF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Action" Foreground="#666688" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DailyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DailyUsageViewModel">
                                    <Border Background="#1A1A2B" CornerRadius="4" Padding="12,8" Margin="0,2">
                                        <Grid ColumnDefinitions="60,*,120,120,120,80">
                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeekLabel}" Foreground="#8888AA" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DayLabel}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadedText}" Foreground="#00D2FF" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadedText}" Foreground="#00E676" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalText}" Foreground="#8888FF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="Drill 🔍" Command="{Binding $parent[UserControl].((vm:HistoricalExplorerViewModel)DataContext).DrillIntoDayCommand}" CommandParameter="{Binding}" Classes="preset-btn" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
