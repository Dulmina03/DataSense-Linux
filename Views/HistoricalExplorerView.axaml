<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoricalExplorerView"
             x:DataType="vm:HistoricalExplorerViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- ── Header Toolbar ── -->
            <Border Classes="CardElevated">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🏛️ Historical Usage Explorer" Classes="PageTitle"/>
                            <Border Classes="Badge" IsVisible="{Binding CanDrillUp}">
                                <TextBlock Text="{Binding DrillHeaderText}" Foreground="{DynamicResource Brush.Success}" Classes="Caption" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Explore network usage across time, applications, and networks." Classes="BodySecondary"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                        <Button Content="⬆ Drill Up" Command="{Binding DrillUpCommand}" IsVisible="{Binding CanDrillUp}" Classes="Secondary"/>

                        <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedPreset}" MinWidth="140">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" MinWidth="120"/>

                        <Button Content="🔄" Command="{Binding RefreshCommand}" Classes="Secondary" ToolTip.Tip="Refresh"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Main Content Area ── -->
            <StackPanel Spacing="{DynamicResource Spacing.XL}">
                <!-- ── Summary Cards Grid ── -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <Border Grid.Column="0" Classes="CardInteractive" Margin="0,0,16,0">
                        <StackPanel Spacing="{DynamicResource Spacing.SM}">
                            <TextBlock Text="🌐 Total Usage" Classes="Caption" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{Binding TotalText}" Classes="MetricLarge"/>
                            <TextBlock Text="{Binding PeriodLabel}" Classes="Caption"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="Card" Margin="0,0,16,0">
                        <StackPanel Spacing="{DynamicResource Spacing.SM}">
                            <TextBlock Text="⬇ Downloaded" Classes="Caption" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="{Binding DownloadText}" Classes="MetricLarge" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="{Binding ActiveDaysText}" Classes="Caption"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="Card" Margin="0,0,16,0">
                        <StackPanel Spacing="{DynamicResource Spacing.SM}">
                            <TextBlock Text="⬆ Uploaded" Classes="Caption" Foreground="{DynamicResource Brush.Upload}"/>
                            <TextBlock Text="{Binding UploadText}" Classes="MetricLarge" Foreground="{DynamicResource Brush.Upload}"/>
                            <TextBlock Text="{Binding AvgDailyText, StringFormat='Avg {0}/day'}" Classes="Caption"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="Card">
                        <StackPanel Spacing="{DynamicResource Spacing.SM}">
                            <TextBlock Text="⚡ Peak Usage Day" Classes="Caption" Foreground="{DynamicResource Brush.Warning}"/>
                            <TextBlock Text="{Binding PeakDayText}" Classes="Body" Foreground="{DynamicResource Brush.Warning}" FontWeight="Bold" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Period Comparison Banner ── -->
                <Border Classes="Card" IsVisible="{Binding HasComparison}">
                    <Grid ColumnDefinitions="*,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Current Period" Classes="Caption"/>
                            <TextBlock Text="{Binding CompareCurrentLabel}" Classes="Body" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CompareCurrentTotal}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Accent}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="vs" Classes="SectionTitle" VerticalAlignment="Center" Margin="20,0"/>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="Previous Period" Classes="Caption"/>
                            <TextBlock Text="{Binding ComparePreviousLabel}" Classes="Body" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ComparePreviousTotal}" Classes="MetricSmall"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Change:" Classes="Caption"/>
                                <TextBlock Text="{Binding CompareChangeText}" Foreground="{Binding CompareChangeColor}" Classes="Body" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Monthly Trend Bars (Drill Level: Month) ── -->
                <Border Classes="Card" IsVisible="{Binding ShowMonthly}">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Monthly Usage Breakdown (Last 12 Months)" Classes="SectionTitle"/>
                        <ItemsControl ItemsSource="{Binding MonthBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MonthBarViewModel">
                                    <StackPanel Spacing="6" Width="60" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalText}" Classes="Caption" HorizontalAlignment="Center"/>
                                        <Grid Height="120" VerticalAlignment="Bottom">
                                            <Border Height="{Binding BarHeight}" Width="32" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" VerticalAlignment="Bottom"/>
                                            <Border Height="{Binding DownloadHeight}" Width="32" Background="{DynamicResource Brush.Download}" CornerRadius="{DynamicResource Radius.Small}" VerticalAlignment="Bottom" Opacity="0.8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MonthLabel}" Classes="Caption" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Two Column: Apps & Spikes ── -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Top Applications -->
                    <Border Grid.Column="0" Classes="Card" Margin="0,0,16,0">
                        <StackPanel Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="Top Applications in Selected Period" Classes="SectionTitle"/>
                            <ItemsControl ItemsSource="{Binding AppRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AppUsageRowViewModel">
                                        <Grid ColumnDefinitions="120,*,80" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding ProcessName}" Classes="Body" TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding PercentValue}" Maximum="100" Height="8" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.SurfaceElevated}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Usage Spikes -->
                    <Border Grid.Column="1" Classes="Card">
                        <StackPanel Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="Notable Usage Spikes" Classes="SectionTitle"/>
                            <ItemsControl ItemsSource="{Binding Spikes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SpikeRowViewModel">
                                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="10,8" Margin="0,3">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="⚡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Description}" Classes="Body" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding DateLabel}" Classes="Caption"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TotalText}" Foreground="{DynamicResource Brush.Warning}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Classes="EmptyState" IsVisible="{Binding !Spikes.Count}">
                                <TextBlock Text="No significant usage spikes detected." Classes="EmptyStateTitle"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Daily Breakdown Table ── -->
                <Border Classes="Card">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="Daily Usage Breakdown (Click row to drill into hourly data)" Classes="SectionTitle"/>

                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8">
                            <Grid ColumnDefinitions="60,*,120,120,120,80">
                                <TextBlock Grid.Column="0" Text="Day" Classes="Caption" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="Date" Classes="Caption" FontWeight="Bold"/>
                                <TextBlock Grid.Column="2" Text="Downloaded" Classes="Caption" Foreground="{DynamicResource Brush.Download}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Uploaded" Classes="Caption" Foreground="{DynamicResource Brush.Upload}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="Total" Classes="Caption" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Action" Classes="Caption" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DailyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DailyUsageViewModel">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,8" Margin="0,2">
                                        <Grid ColumnDefinitions="60,*,120,120,120,80">
                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeekLabel}" Classes="Caption" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DayLabel}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadedText}" Classes="Body" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadedText}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="Drill 🔍" Command="{Binding $parent[UserControl].((vm:HistoricalExplorerViewModel)DataContext).DrillIntoDayCommand}" CommandParameter="{Binding}" Classes="Secondary" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
