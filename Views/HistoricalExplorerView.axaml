<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.HistoricalExplorerView"
             x:DataType="vm:HistoricalExplorerViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Historical Usage Explorer" Classes="PageTitle"/>
                            <Border Classes="StatusPill" IsVisible="{Binding CanDrillUp}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DrillHeaderText}" Foreground="{DynamicResource Brush.Success}" Classes="Caption" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Explore network usage across time, applications, and networks." Classes="BodySecondary"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                        <Button Content="Drill Up" Command="{Binding DrillUpCommand}" IsVisible="{Binding CanDrillUp}" Classes="Secondary"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Classes="Secondary"/>
                    </StackPanel>
                </Grid>

                <!-- ── FILTER BAR ──────────────────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="{DynamicResource Padding.Medium}">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="Period:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding DatePresets}" SelectedItem="{Binding SelectedPreset}" MinWidth="140" Classes="Secondary">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                            <TextBlock Text="Interface:" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}" MinWidth="120" Classes="Secondary"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- ── SUMMARY HERO ─────────────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Total Usage -->
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="TOTAL USAGE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="{Binding PeriodLabel}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Downloaded -->
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="DOWNLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DownloadText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="{Binding ActiveDaysText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Uploaded -->
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="UPLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UploadText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                            <TextBlock Text="{Binding AvgDailyText, StringFormat='Avg {0}/day'}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Peak Usage Day -->
                        <StackPanel Grid.Column="3" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="PEAK USAGE DAY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PeakDayText}" Classes="Metric" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── PERIOD COMPARISON BANNER ────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" IsVisible="{Binding HasComparison}" Padding="{DynamicResource Padding.Medium}">
                    <Grid ColumnDefinitions="*,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="CURRENT PERIOD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding CompareCurrentLabel}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding CompareCurrentTotal}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Accent}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="vs" Classes="BodySecondary" VerticalAlignment="Center" Margin="32,0"/>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="PREVIOUS PERIOD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                            <TextBlock Text="{Binding ComparePreviousLabel}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="{Binding ComparePreviousTotal}" Classes="MetricSmall" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        </StackPanel>

                        <Border Grid.Column="3" Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="{DynamicResource Radius.Small}" Padding="16,12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Change:" Classes="BodySecondary" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CompareChangeText}" Foreground="{Binding CompareChangeColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── MONTHLY TREND BARS ────────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" IsVisible="{Binding ShowMonthly}">
                    <StackPanel Spacing="{DynamicResource Spacing.LG}">
                        <TextBlock Text="MONTHLY USAGE BREAKDOWN (LAST 12 MONTHS)" Classes="PanelTitle"/>
                        <ItemsControl ItemsSource="{Binding MonthBars}" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:MonthBarViewModel">
                                    <StackPanel Spacing="8" Width="64" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalText}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                                        <Grid Height="140" VerticalAlignment="Bottom">
                                            <Border Height="{Binding BarHeight}" Width="32" Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="{DynamicResource Radius.Small}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                                            <Border Height="{Binding DownloadHeight}" Width="32" Background="{DynamicResource Brush.Download}" CornerRadius="{DynamicResource Radius.Small}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0.8"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MonthLabel}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── TWO COLUMN: APPS & SPIKES ─────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,48,*">
                    <!-- Top Applications -->
                    <Border Grid.Column="0" Classes="MetricSurface">
                        <StackPanel Spacing="{DynamicResource Spacing.LG}">
                            <TextBlock Text="TOP APPLICATIONS" Classes="PanelTitle"/>
                            <ItemsControl ItemsSource="{Binding AppRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:AppUsageRowViewModel">
                                        <Grid ColumnDefinitions="*,80" Margin="0,8">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding ProcessName}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Value="{Binding PercentValue}" Maximum="100" Height="4" Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.SurfaceHover}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Usage Spikes -->
                    <Border Grid.Column="2" Classes="MetricSurface">
                        <StackPanel Spacing="{DynamicResource Spacing.LG}">
                            <TextBlock Text="NOTABLE USAGE SPIKES" Classes="PanelTitle"/>

                            <StackPanel Classes="EmptyState" IsVisible="{Binding !Spikes.Count}" Margin="0,24">
                                <TextBlock Text="No significant usage spikes detected." Classes="BodySecondary" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Spikes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SpikeRowViewModel">
                                        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8,0,12" Margin="0,4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Description}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Text="{Binding DateLabel}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalText}" Foreground="{DynamicResource Brush.Warning}" Classes="Body" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── DAILY BREAKDOWN TABLE ─────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <StackPanel Grid.Row="0" Margin="20,16" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="DAILY USAGE BREAKDOWN" Classes="PanelTitle"/>
                            <TextBlock Text="Click a row to drill into hourly data" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                            <Grid ColumnDefinitions="60,*,120,120,120,100">
                                <TextBlock Grid.Column="0" Text="DAY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="DATE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="DOWNLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="UPLOADED" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="TOTAL" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="ACTION" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding DailyRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DailyUsageViewModel">
                                    <Border Classes="CardInteractive" Padding="16,12" Margin="0">
                                        <Grid ColumnDefinitions="60,*,120,120,120,100">
                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeekLabel}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DayLabel}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DownloadedText}" Classes="Body" Foreground="{DynamicResource Brush.Download}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadedText}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <Button Grid.Column="5" Content="Drill" Command="{Binding $parent[UserControl].((vm:HistoricalExplorerViewModel)DataContext).DrillIntoDayCommand}" CommandParameter="{Binding}" Classes="Ghost" HorizontalAlignment="Right" Padding="12,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
