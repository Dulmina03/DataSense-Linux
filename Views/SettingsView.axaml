<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:srv="using:DataSense.Services"
             x:Class="DataSense.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Margin="{DynamicResource Padding.Large}">

            <!-- ── 1. HEADER ────────────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Settings" Classes="PageTitle"/>
                    <TextBlock Text="Customize DataSense and manage application behavior" Classes="BodySecondary"/>
                </StackPanel>

                <!-- Global Save Button & Feedback -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveStatusText}" Classes="Caption" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding !IsSaving}" Classes="Primary"/>
                </StackPanel>
            </Grid>

            <!-- ── 2. TWO-COLUMN LAYOUT ─────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="230,20,*">

                <!-- ── LEFT NAVIGATION COLUMN ───────────────────────────────────────── -->
                <Border Grid.Column="0" Classes="AnalyticsSurface" Padding="8,12" VerticalAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SETTINGS" Classes="Caption" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="12,6,12,10"
                                   LetterSpacing="0.8"/>

                        <!-- 1. Appearance -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Appearance}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsAppearanceSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="🎨" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Appearance" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 2. Dashboard -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Dashboard}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsDashboardSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="📊" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Dashboard" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 3. Analytics -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Analytics}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsAnalyticsSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="📈" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Analytics" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 4. Network -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Network}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsNetworkSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="🌐" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Network" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 5. Data -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Data}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsDataSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="💾" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Data" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 6. Notifications -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.Notifications}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsNotificationsSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="🔔" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Notifications" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 7. Data Limits -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.DataLimits}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsDataLimitsSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Data Limits" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- 8. System -->
                        <Button Command="{Binding SelectCategoryCommand}"
                                CommandParameter="{x:Static vm:SettingsCategory.System}"
                                Classes="SidebarItem"
                                Classes.active="{Binding IsSystemSelected}">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Grid.Column="0" Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="System" Classes="Body" FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ── RIGHT CONTENT COLUMN ─────────────────────────────────────────── -->
                <StackPanel Grid.Column="2" Spacing="20">

                    <!-- Section Header -->
                    <StackPanel Spacing="4" Margin="0,0,0,4">
                        <TextBlock Text="{Binding CategoryTitle}" Classes="PanelTitle" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CategoryDescription}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 1. APPEARANCE CATEGORY                                         -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsAppearanceSelected}">
                        <!-- Card: THEME -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="THEME" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="Choose your preferred DataSense visual theme" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Theme" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedTheme}"
                                              MinWidth="220">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="srv:ThemeOption">
                                                <TextBlock Text="{Binding FormattedName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: INTERFACE -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="INTERFACE" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Start DataSense with system" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartAtLogin}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Minimize to system tray" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Launch on startup" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding LaunchOnStartup}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Enable animations" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableAnimations}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 2. DASHBOARD CATEGORY                                          -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsDashboardSelected}">
                        <!-- Card: WIDGETS -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="DASHBOARD WIDGETS" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Summary cards" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowSummaryCards}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Network usage chart" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowNetworkChart}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Application usage" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowApplicationUsage}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Network information" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowNetworkInfo}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: PREFERENCES -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="PREFERENCES" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Default dashboard period" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding DefaultDashboardPeriod}" MinWidth="160"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Card layout" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding CardLayout}" MinWidth="180"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 3. ANALYTICS CATEGORY                                          -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsAnalyticsSelected}">
                        <!-- Card: CHART RENDERING -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="CHART RENDERING" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Chart animations" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableChartAnimations}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Smooth graph rendering" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding SmoothGraphRendering}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Show chart tooltips" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowChartTooltips}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: UNITS & FORMATTING -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="UNITS &amp; FORMATTING" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Data unit" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataUnitOptions}" SelectedItem="{Binding DataUnit}" MinWidth="180"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Transfer rate" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TransferRateUnitOptions}" SelectedItem="{Binding TransferRateUnit}" MinWidth="180"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 4. NETWORK CATEGORY                                            -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsNetworkSelected}">
                        <!-- Card: MONITORING ENGINE -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="MONITORING ENGINE" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Network monitoring" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableNetworkMonitoring}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Monitor application traffic" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding MonitorAppTraffic}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Detect network changes" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding DetectNetworkChanges}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: NETWORK IDENTITY -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="NETWORK IDENTITY" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Automatically detect network names" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoDetectNetworkNames}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Use Wi-Fi SSID when available" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding UseWifiSsid}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 5. DATA CATEGORY                                               -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsDataSelected}">
                        <!-- Card: HISTORY -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="HISTORY" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="History retention" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding HistoryRetention}" MinWidth="160"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Refresh interval" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshIntervalOptions}" SelectedItem="{Binding RefreshInterval}" MinWidth="160"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: STORAGE -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="STORAGE" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <!-- Metrics Row -->
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="DATABASE SIZE" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding DatabaseSizeFormatted}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Download}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="STORED RECORDS" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding StoredRecordsCountFormatted}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <!-- Database File Location -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Database Path" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="{Binding DatabasePath}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <!-- Clear History Section -->
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding !IsConfirmingClearHistory}">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Clear Historical Data" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Text="Permanently delete all stored network and process telemetry." Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Clear History" Classes="Danger"
                                                Command="{Binding RequestClearHistoryCommand}"/>
                                    </Grid>

                                    <!-- Inline Confirmation Box -->
                                    <Border Background="{DynamicResource Brush.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Brush.Danger}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            IsVisible="{Binding IsConfirmingClearHistory}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="⚠️ Are you sure you want to clear historical network telemetry? This action cannot be undone."
                                                       Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Classes="Secondary" Command="{Binding CancelClearHistoryCommand}"/>
                                                <Button Content="Confirm Clear" Classes="Danger" Command="{Binding ConfirmClearHistoryCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding ClearHistoryStatusText}" Classes="Caption" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success}"
                                               IsVisible="{Binding ClearHistoryStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 6. NOTIFICATIONS CATEGORY                                      -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsNotificationsSelected}">
                        <!-- Card: NOTIFICATIONS -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="NOTIFICATIONS" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Enable notifications" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EnableNotifications}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Notification sound" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotificationSound}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Notify while minimized" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotifyWhileMinimized}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: USAGE ALERTS -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="USAGE ALERTS" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Daily limit reached" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotifyDailyLimit}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Monthly limit reached" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding NotifyMonthlyLimit}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Alert threshold" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding AlertThreshold}" MinWidth="120"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 7. DATA LIMITS CATEGORY                                        -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsDataLimitsSelected}">
                        <!-- Card: DAILY LIMIT -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="DAILY LIMIT" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Enable daily limit" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding DailyBudgetEnabled}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding DailyBudgetEnabled}">
                                    <TextBlock Text="Limit" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding DailyLimitGb}" Minimum="0.5" Maximum="500" Increment="1" MinWidth="160" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding DailyBudgetEnabled}">
                                    <TextBlock Text="Alert threshold" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding DailyAlertThreshold}" MinWidth="120"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <!-- Daily Live Telemetry Usage Progress -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Today" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding TodayUsageText}" Classes="Metric" Foreground="{DynamicResource Brush.Download}"/>
                                            <TextBlock Text="/" Classes="Metric" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Text="{Binding DailyLimitText}" Classes="Metric" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding DailyUsagePercent, StringFormat='{}{0:F1}%'}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Progress Bar with Cyan Gradient -->
                                    <Grid Height="8">
                                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="4" Height="8"/>
                                        <ProgressBar Value="{Binding DailyUsagePercent}" Minimum="0" Maximum="100"
                                                     Height="8" CornerRadius="4"
                                                     Foreground="{DynamicResource Brush.DownloadBarGradient}"
                                                     Background="Transparent"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card: MONTHLY LIMIT -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="MONTHLY LIMIT" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Enable monthly limit" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding BudgetEnabled}" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding BudgetEnabled}">
                                    <TextBlock Text="Limit" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Value="{Binding MonthlyLimitGb}" Minimum="1" Maximum="10000" Increment="10" MinWidth="160" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" IsVisible="{Binding BudgetEnabled}">
                                    <TextBlock Text="Alert threshold" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThresholdOptions}" SelectedItem="{Binding MonthlyAlertThreshold}" MinWidth="120"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <!-- Monthly Live Telemetry Usage Progress -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="This Month" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding MonthUsageText}" Classes="Metric" Foreground="{DynamicResource Brush.Upload}"/>
                                            <TextBlock Text="/" Classes="Metric" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Text="{Binding MonthlyLimitText}" Classes="Metric" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MonthlyUsagePercent, StringFormat='{}{0:F1}%'}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Progress Bar with Violet Gradient -->
                                    <Grid Height="8">
                                        <Border Background="{DynamicResource Brush.Surface}" CornerRadius="4" Height="8"/>
                                        <ProgressBar Value="{Binding MonthlyUsagePercent}" Minimum="0" Maximum="100"
                                                     Height="8" CornerRadius="4"
                                                     Foreground="{DynamicResource Brush.UploadBarGradient}"
                                                     Background="Transparent"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <!-- 8. SYSTEM CATEGORY                                             -->
                    <!-- ══════════════════════════════════════════════════════════════ -->
                    <StackPanel Spacing="16" IsVisible="{Binding IsSystemSelected}">
                        <!-- Card: STARTUP -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="STARTUP" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Start with system" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartWithSystem}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Start minimized" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card: SYSTEM TRAY -->
                        <Border Classes="AnalyticsSurface" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="SYSTEM TRAY" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Show tray icon" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowTrayIcon}" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}"/>

                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <TextBlock Text="Show live network speed" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding ShowLiveSpeedInTray}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
