<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
             x:Class="DataSense.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- Global Description -->
            <TextBlock Text="Modify DataSense application behavior and threshold boundaries." 
                       FontSize="13" 
                       Foreground="#888888" 
                       Margin="0,0,0,8" />

            <!-- Group 1: General Settings -->
            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="General Configuration" FontSize="14" FontWeight="Bold" Foreground="#007ACC" />
                    <Separator Height="1" Background="#242424" />

                    <!-- Theme Setting -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Application Theme" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" />
                            <TextBlock Text="Choose the visual appearance style of the desktop interface." FontSize="11" Foreground="#666666" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="0" Width="160" FontSize="12">
                            <ComboBoxItem Content="Fluent Dark (Default)" />
                            <ComboBoxItem Content="Fluent Light" />
                            <ComboBoxItem Content="System Sync" />
                        </ComboBox>
                    </Grid>
                    
                    <Separator Height="1" Background="#242424" />

                    <!-- Storage Setting -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Data Storage Location" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" />
                            <TextBlock Text="The absolute path where the local SQLite database resides." FontSize="11" Foreground="#666666" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Text="~/.config/datasense/datasense.db" IsReadOnly="True" Width="240" FontSize="11" Background="#141414" BorderBrush="#333333" VerticalContentAlignment="Center" />
                            <Button Content="Browse..." IsEnabled="False" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 2: Monitoring thresholds -->
            <Border Background="#1A1A1A" BorderBrush="#222222" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Data Limits &amp; System Probes" FontSize="14" FontWeight="Bold" Foreground="#007ACC" />
                    <Separator Height="1" Background="#242424" />

                    <!-- Data Limits -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Monthly Data Limit" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" />
                            <TextBlock Text="Alert when compiled network packet logging exceeds threshold." FontSize="11" Foreground="#666666" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="1" Width="160" FontSize="12">
                            <ComboBoxItem Content="Disabled" />
                            <ComboBoxItem Content="100 GB" />
                            <ComboBoxItem Content="500 GB" />
                            <ComboBoxItem Content="1 TB" />
                        </ComboBox>
                    </Grid>

                    <Separator Height="1" Background="#242424" />

                    <!-- Notifications Setting -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Notification Settings" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" />
                            <TextBlock Text="Receive desktop warnings when system indicators trigger." FontSize="11" Foreground="#666666" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="True" IsEnabled="False" Margin="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Save Bar -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Changes are automatically applied locally." VerticalAlignment="Center" Foreground="#555555" FontSize="11" />
                <Button Grid.Column="1" Content="Reset Default Settings" IsEnabled="False" FontSize="11" Padding="12,6" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
