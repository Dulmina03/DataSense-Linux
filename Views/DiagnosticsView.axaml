<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- Header Toolbar -->
            <Border Classes="CardElevated">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🛠️ Diagnostics &amp; Troubleshooting Center" Classes="PageTitle"/>
                            <Border Classes="Badge">
                                <TextBlock Text="{Binding OverallStatusText}" Foreground="{Binding OverallStatusColor}" Classes="Body" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Inspect component operational states, capability diagnostics, and recovery recommendations." Classes="BodySecondary"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🔄 Refresh Diagnostics" Command="{Binding RefreshDiagnosticsCommand}" Classes="Secondary" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Components List -->
            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:DiagnosticComponent">
                        <Border Classes="Card" Margin="0,0,0,16">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <!-- Row 0: Name, Category, Status Badge -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Classes="SectionTitle"/>
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding Category}" />
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="Badge">
                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Brush.Success}" Classes="Body" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Row 1: Message & Details -->
                                <StackPanel Grid.Row="1" Spacing="4" Margin="0,12">
                                    <TextBlock Text="{Binding Message}" Classes="Body" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DetailedMessage}" Classes="Caption" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Row 2: Recommended Action Banner -->
                                <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="💡 Recommended Action:" Foreground="{DynamicResource Brush.Warning}" Classes="Caption" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RecommendedAction}" Classes="Caption" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
