<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.EventCenterView"
             x:DataType="vm:EventCenterViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            <!-- Top Toolbar -->
            <Border Classes="CardElevated">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.SM}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="🔔 Event &amp; Alert Center" Classes="PageTitle"/>
                            <Border Classes="Badge" Background="{DynamicResource Brush.Danger}" IsVisible="{Binding UnreadCount}">
                                <TextBlock Text="{Binding UnreadCount, StringFormat='{}{0} Unread'}" Classes="Caption" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Centralized notifications, system alerts, anomalies, and background notifications." Classes="BodySecondary"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                        <Button Content="✓ Mark All Read" Command="{Binding MarkAllReadCommand}" Classes="Secondary"/>
                        <Button Content="🧹 Clear Resolved" Command="{Binding ClearResolvedCommand}" Classes="Secondary"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Events List -->
            <StackPanel Spacing="{DynamicResource Spacing.MD}">
                <!-- Filter Bar -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Classes="Secondary"/>
                    <Button Content="Critical" Command="{Binding SetFilterCommand}" CommandParameter="Critical" Classes="Secondary" Foreground="{DynamicResource Brush.Danger}"/>
                    <Button Content="Warning" Command="{Binding SetFilterCommand}" CommandParameter="Warning" Classes="Secondary" Foreground="{DynamicResource Brush.Warning}"/>
                    <Button Content="Info" Command="{Binding SetFilterCommand}" CommandParameter="Info" Classes="Secondary" Foreground="{DynamicResource Brush.Download}"/>
                    <Button Content="Success" Command="{Binding SetFilterCommand}" CommandParameter="Success" Classes="Secondary" Foreground="{DynamicResource Brush.Success}"/>
                </StackPanel>

                <!-- Active Events List -->
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:DataSenseEvent">
                            <Border Classes="Card" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Source}" Classes="Caption" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:u}'}" Classes="Caption" VerticalAlignment="Center" Opacity="0.8"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Classes="Caption" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Read" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).MarkReadCommand}" CommandParameter="{Binding Id}" Classes="Secondary"/>
                                        <Button Content="Dismiss" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).DismissCommand}" CommandParameter="{Binding Id}" Classes="Secondary"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
