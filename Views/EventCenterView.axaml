<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.EventCenterView"
             x:DataType="vm:EventCenterViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.filter-btn">
            <Setter Property="Background" Value="#1E1E30"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="#0F0F1A">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#141422" BorderBrush="#222236" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🔔 Event &amp; Alert Center" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#FF5252" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding UnreadCount}">
                            <TextBlock Text="{Binding UnreadCount, StringFormat='{}{0} Unread'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Centralized notifications, system alerts, anomalies, and background notifications." FontSize="12" Foreground="#8888AA"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="✓ Mark All Read" Command="{Binding MarkAllReadCommand}" Classes="filter-btn"/>
                    <Button Content="🧹 Clear Resolved" Command="{Binding ClearResolvedCommand}" Classes="filter-btn"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Events List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Spacing="16" MaxWidth="1100">
                <!-- Filter Bar -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Classes="filter-btn"/>
                    <Button Content="Critical" Command="{Binding SetFilterCommand}" CommandParameter="Critical" Classes="filter-btn" Foreground="#FF5252"/>
                    <Button Content="Warning" Command="{Binding SetFilterCommand}" CommandParameter="Warning" Classes="filter-btn" Foreground="#FF9800"/>
                    <Button Content="Info" Command="{Binding SetFilterCommand}" CommandParameter="Info" Classes="filter-btn" Foreground="#00D2FF"/>
                    <Button Content="Success" Command="{Binding SetFilterCommand}" CommandParameter="Success" Classes="filter-btn" Foreground="#00E676"/>
                </StackPanel>

                <!-- Active Events List -->
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:DataSenseEvent">
                            <Border Classes="card" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Source}" Foreground="#8888AA" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:u}'}" Foreground="#555577" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Read" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).MarkReadCommand}" CommandParameter="{Binding Id}" Classes="filter-btn"/>
                                        <Button Content="Dismiss" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).DismissCommand}" CommandParameter="{Binding Id}" Classes="filter-btn"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
