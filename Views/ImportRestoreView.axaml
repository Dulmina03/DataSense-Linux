<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.ImportRestoreView"
             x:DataType="vm:ImportRestoreViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#181824"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20" Background="#0F0F1A">
        <StackPanel Spacing="20" MaxWidth="1000">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="📥 Import &amp; Restore Center" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Safely restore database backups or import telemetry CSV/JSON records." FontSize="12" Foreground="#8888AA"/>
            </StackPanel>

            <!-- Status Card -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="Migration Controls" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#00D2FF" FontSize="13"/>
                    <ProgressBar IsIndeterminate="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}" Height="4"/>
                </StackPanel>
            </Border>

            <!-- File Select Card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Select Data Source" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                        <TextBox Grid.Column="0" Text="{Binding SelectedFilePath}" Watermark="Select .zip, .csv, or .json file..." Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Start Import / Restore" Command="{Binding ExecuteImportCommand}" Classes="action-btn"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Preview Card -->
            <Border Classes="card" IsVisible="{Binding Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Import File Preview" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Preview.Format, StringFormat='Format: {0}'}" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.TotalRecords, StringFormat='Total Records: {0}'}" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview.FileSizeBytes, StringFormat='File Size: {0} bytes'}" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Preview.ValidRecords, StringFormat='Valid Records: {0}'}" Foreground="#00E676"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
