<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.BackupRecoveryView"
             x:DataType="vm:BackupRecoveryViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <TextBlock Text="Automated Backup &amp; Disaster Recovery" Classes="PageTitle"/>
                        <TextBlock Text="Local, offline database recovery points with SHA-256 integrity validation." Classes="BodySecondary"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="💾 Create Backup Now"
                            Command="{Binding CreateBackupNowCommand}"
                            IsEnabled="{Binding !IsProcessing}"
                            Classes="Primary" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── STATUS HERO SURFACE ──────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <Grid ColumnDefinitions="*,*">
                            <!-- System Protection Status -->
                            <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                                <TextBlock Text="SYSTEM PROTECTION STATUS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Success}"/>
                                <TextBlock Text="Local database disaster recovery health" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>

                            <!-- Recovery Points Count -->
                            <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}">
                                <TextBlock Text="RECOVERY POINTS AVAILABLE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RecoveryPoints.Count}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="Validated offline restore points" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <ProgressBar Height="4" IsIndeterminate="{Binding IsProcessing}" IsVisible="{Binding IsProcessing}"
                                     Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.SurfaceHover}"
                                     CornerRadius="{DynamicResource Radius.Small}"/>
                    </StackPanel>
                </Border>

                <!-- ── RECOVERY POINTS TABLE SURFACE ───────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <TextBlock Text="AVAILABLE RECOVERY POINTS" Classes="PanelTitle" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Padding="16,12">
                            <Grid ColumnDefinitions="*,180,140,120">
                                <TextBlock Grid.Column="0" Text="FILE PATH &amp; LOCATION" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="CREATED AT" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="SIZE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="3" Text="STATUS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !RecoveryPoints.Count}" Margin="0,32">
                            <TextBlock Text="No local recovery points found." Classes="BodySecondary" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding RecoveryPoints}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:RecoveryPoint">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid ColumnDefinitions="*,180,140,120">
                                            <TextBlock Grid.Column="0" Text="{Binding FilePath}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeBytes, StringFormat='{}{0:N0} bytes'}" Classes="Body" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="3" Classes="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="✓ Validated" Classes="Caption" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
