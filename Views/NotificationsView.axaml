<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:models="using:DataSense.Models"
             x:Class="DataSense.Views.NotificationsView"
             x:DataType="vm:EventCenterViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                            <TextBlock Text="Notifications &amp; Alerts" Classes="PageTitle"/>
                            <Border Classes="Badge" Background="{DynamicResource Brush.Danger}" IsVisible="{Binding UnreadCount}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UnreadCount, StringFormat='{}{0} Unread'}" Classes="Caption" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Real-time system notifications, network alert logs, and background event tracking." Classes="BodySecondary"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.SM}" VerticalAlignment="Center">
                        <Button Content="✓ Mark All Read" Command="{Binding MarkAllReadCommand}" Classes="Secondary"/>
                        <Button Content="🧹 Clear Resolved" Command="{Binding ClearResolvedCommand}" Classes="Secondary"/>
                    </StackPanel>
                </Grid>

                <!-- ── SUMMARY HERO SURFACE ────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,*">
                        <!-- Unread Count -->
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="UNREAD NOTIFICATIONS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UnreadCount}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="Active items requiring attention" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Filter Scope -->
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="ACTIVE SEVERITY FILTER" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FilterSeverity}" Classes="LargeMetric" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            <TextBlock Text="Current view severity scope" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── FILTERS SURFACE ────────────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="{DynamicResource Padding.Large}">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="FILTER BY SEVERITY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Classes="Secondary" Margin="0,0,8,8"/>
                            <Button Content="Critical" Command="{Binding SetFilterCommand}" CommandParameter="Critical" Classes="Secondary" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,8"/>
                            <Button Content="Warning" Command="{Binding SetFilterCommand}" CommandParameter="Warning" Classes="Secondary" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,8"/>
                            <Button Content="Info" Command="{Binding SetFilterCommand}" CommandParameter="Info" Classes="Secondary" Foreground="{DynamicResource Brush.Download}" Margin="0,0,8,8"/>
                            <Button Content="Success" Command="{Binding SetFilterCommand}" CommandParameter="Success" Classes="Secondary" Foreground="{DynamicResource Brush.Success}" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── NOTIFICATIONS LIST SURFACE ──────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <TextBlock Text="NOTIFICATION LOG" Classes="PanelTitle" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceHover}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Padding="16,12">
                            <Grid ColumnDefinitions="110,*,140,160,160">
                                <TextBlock Grid.Column="0" Text="SEVERITY" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="DETAILS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="SOURCE" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="3" Text="TIMESTAMP" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="4" Text="ACTIONS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !Events.Count}" Margin="0,32">
                            <TextBlock Text="No notifications found matching the active filter." Classes="BodySecondary" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:DataSenseEvent">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid ColumnDefinitions="110,*,140,160,160">
                                            <!-- Severity Pill -->
                                            <Border Grid.Column="0" Classes="StatusPill" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="8,4">
                                                <TextBlock Text="{Binding Severity}" Classes="Caption" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                <TextBlock Text="{Binding Description}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Source -->
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>

                                            <!-- Timestamp -->
                                            <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:MMM dd, HH:mm:ss}'}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="Read" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).MarkReadCommand}" CommandParameter="{Binding Id}" IsVisible="{Binding !IsRead}" Classes="Secondary"/>
                                                <Button Content="Dismiss" Command="{Binding $parent[UserControl].((vm:EventCenterViewModel)DataContext).DismissCommand}" CommandParameter="{Binding Id}" Classes="Secondary"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
