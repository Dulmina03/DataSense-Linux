<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.SpeedTestView"
             x:DataType="vm:SpeedTestViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="{DynamicResource Spacing.XXL}" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}">
                        <TextBlock Text="Network Speed Test" Classes="PageTitle"/>
                        <TextBlock Text="Measure your current connection speed and latency using Cloudflare CDN." Classes="BodySecondary"/>
                    </StackPanel>
                </Grid>

                <!-- ── SPEED METRICS HERO ───────────────────────────────────────────── -->
                <Border Classes="HeroSurface">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Download -->
                        <StackPanel Grid.Column="0" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DownloadSpeedText}" Classes="DisplayMetric" Foreground="{DynamicResource Brush.Download}"/>
                            <TextBlock Text="Peak bandwidth speed" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Upload -->
                        <StackPanel Grid.Column="1" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UploadSpeedText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Upload}"/>
                            <TextBlock Text="Outbound transmission rate" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Ping -->
                        <StackPanel Grid.Column="2" Spacing="{DynamicResource Spacing.XS}" Margin="0,0,24,0">
                            <TextBlock Text="PING" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PingText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock Text="Round-trip response latency" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>

                        <!-- Jitter -->
                        <StackPanel Grid.Column="3" Spacing="{DynamicResource Spacing.XS}">
                            <TextBlock Text="JITTER" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding JitterText}" Classes="LargeMetric" Foreground="{DynamicResource Brush.Warning}"/>
                            <TextBlock Text="Latency variance stability" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── CONTROL & PROGRESS SURFACE ───────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="{DynamicResource Padding.Large}">
                    <StackPanel Spacing="{DynamicResource Spacing.LG}">

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="TEST CONTROL &amp; STATUS" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusText}" Classes="Body" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Medium"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelTestCommand}"
                                    IsVisible="{Binding IsTesting}" Classes="Secondary" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Button Grid.Column="2" Content="Start Speed Test"
                                    Command="{Binding StartTestCommand}"
                                    IsEnabled="{Binding !IsTesting}"
                                    Classes="Primary" VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                     IsIndeterminate="{Binding IsIndeterminateProgress}"
                                     Foreground="{DynamicResource Brush.Download}" Background="{DynamicResource Brush.SurfaceHover}"
                                     CornerRadius="{DynamicResource Radius.Small}"
                                     IsVisible="{Binding IsTesting}"/>
                    </StackPanel>
                </Border>

                <!-- ── RECENT TEST RESULTS TABLE ────────────────────────────────────── -->
                <Border Classes="AnalyticsSurface" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <TextBlock Text="RECENT TEST RESULTS" Classes="PanelTitle" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="16,12">
                            <Grid ColumnDefinitions="200,*,*,*,*">
                                <TextBlock Grid.Column="0" Text="DATE &amp; TIME" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="3" Text="PING" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="4" Text="SERVER" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !TestHistory.Count}" Margin="0,32">
                            <TextBlock Text="No speed test history available." Classes="BodySecondary" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TestHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid ColumnDefinitions="200,*,*,*,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='MMM dd, HH:mm'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Classes="Body" Foreground="{DynamicResource Brush.Download}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PingMs, StringFormat='{}{0:F0} ms'}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ServerName}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
