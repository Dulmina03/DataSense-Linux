<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             x:Class="DataSense.Views.SpeedTestView"
             x:DataType="vm:SpeedTestViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Panel>
            <StackPanel Spacing="24" Margin="{DynamicResource Padding.Large}">

                <!-- ── HEADER ──────────────────────────────────────────────────────── -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Speed Test" Classes="PageTitle"/>
                        <TextBlock Text="Live network diagnostic console &amp; throughput analyzer" Classes="Caption"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border CornerRadius="16" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="{Binding ServerName}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── MAIN CONSOLE: 3-COLUMN RADIAL LAYOUT ────────────────────────── -->
                <Grid ColumnDefinitions="260,*,280" Margin="0,8,0,0">

                    <!-- ════ LEFT COLUMN: NETWORK DIAGNOSTICS & SYSTEM INFO ════ -->
                    <StackPanel Grid.Column="0" Spacing="20" VerticalAlignment="Center">

                        <!-- Diagnostics List Items -->
                        <Border Classes="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="20,18">
                            <StackPanel Spacing="16">
                                <!-- IP Address -->
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="📶" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding IpAddress}" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="IP Address" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}" Opacity="0.5"/>

                                <!-- Connection Type -->
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="🔗" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Download}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ActiveConnectionType}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="Connection Type" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}" Opacity="0.5"/>

                                <!-- Provider / Network -->
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="🌐" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ActiveNetworkName}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Provider / SSID" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource Brush.BorderSubtle}" Opacity="0.5"/>

                                <!-- OS / Platform -->
                                <Grid ColumnDefinitions="32,*">
                                    <TextBlock Grid.Column="0" Text="💻" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Upload}"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding OsPlatform}" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        <TextBlock Text="Operating System" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Bottom-Left Diagnostic Health Card -->
                        <Border Classes="Card" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Medium}" Padding="16,14">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource Brush.SurfaceHover}" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Network Health" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Text="Optimal • Cloudflare Edge" Classes="Caption" Foreground="{DynamicResource Brush.Success}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ════ CENTER COLUMN: RADIAL SPEEDOMETER & ORBITAL RADAR ════ -->
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">

                        <!-- Orbital Radar & Radial Gauge Container -->
                        <Panel Width="360" Height="320" HorizontalAlignment="Center">

                            <!-- Concentric Orbital Background Rings -->
                            <Path Data="{Binding ConcentricRing4}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" Opacity="0.15" StrokeDashArray="2,4"/>
                            <Path Data="{Binding ConcentricRing3}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" Opacity="0.25" StrokeDashArray="3,5"/>
                            <Path Data="{Binding ConcentricRing2}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" Opacity="0.35"/>
                            <Path Data="{Binding ConcentricRing1}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" Opacity="0.45"/>

                            <!-- Outer Border Arc -->
                            <Path Data="{Binding MeterOuterRing}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1.5" StrokeDashArray="2,3" Opacity="0.6"/>

                            <!-- Background Gauge Track -->
                            <Path Data="{Binding MeterBackgroundArc}" Stroke="{DynamicResource Brush.SurfaceHover}" StrokeThickness="8" StrokeLineCap="Round" Opacity="0.7"/>

                            <!-- Inner Decorative Ring & Inner Dome -->
                            <Path Data="{Binding MeterInnerRing}" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" Opacity="0.3"/>
                            <Path Data="{Binding MeterInnerDomeArc}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="2" Opacity="0.5"/>

                            <!-- Scale Major and Minor Tick Lines -->
                            <Path Data="{Binding MeterScaleTicksGeometry}" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.5" StrokeLineCap="Round" Opacity="0.6"/>

                            <!-- Scale Numeric Labels (0, 2.5, 5, 7.5, 10, 12.5, 15, 17.5, 20 ...) -->
                            <ItemsControl ItemsSource="{Binding ScaleTicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="360" Height="320" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                                   Text="{Binding Label}" Classes="Caption" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ── ACTIVE ANIMATION LAYER (DYNAMIC THEME BRUSH) ── -->
                            <Path Data="{Binding MeterActiveScaleTicksGeometry}"
                                  Stroke="{Binding ActivePhaseSemanticColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"
                                  StrokeThickness="2" StrokeLineCap="Round"/>
                            <Path Data="{Binding MeterSecondaryArc}"
                                  Stroke="{Binding ActivePhaseSemanticColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"
                                  StrokeThickness="2" Opacity="0.4" StrokeLineCap="Round" />
                            <Path Data="{Binding MeterActiveArc}"
                                  Stroke="{Binding ActivePhaseSemanticColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"
                                  StrokeThickness="8" StrokeLineCap="Round" />
                            <Path Data="{Binding MeterActiveDomeArc}"
                                  Stroke="{Binding ActivePhaseSemanticColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"
                                  StrokeThickness="3" Opacity="0.85" StrokeLineCap="Round" />

                            <!-- ── Central Focal Numeric Readout ── -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-10,0,0" Spacing="2">
                                <!-- Cloud / Phase Icon with Dynamic Semantic Color -->
                                <TextBlock Text="{Binding DisplayPhaseIcon}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,2"
                                           Foreground="{Binding ActivePhaseSemanticColor, Converter={x:Static conv:SemanticBrushConverter.Instance}}"/>

                                <!-- Large Bold Speed Value -->
                                <TextBlock Text="{Binding DisplaySpeedValue}" Classes="DisplayMetric" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-4,0,-4"/>

                                <!-- Unit Text (MB/s) -->
                                <TextBlock Text="{Binding DisplayUnitText}" Classes="Caption" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" LetterSpacing="0.8"/>

                                <!-- Sub-Metric (Ping 5 ms) -->
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Text="Ping" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding PingText}" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Panel>

                        <!-- Footer Info Bar Under Gauge -->
                        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,-4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Provider" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding ActiveNetworkName}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="•" Classes="Caption" Foreground="{DynamicResource Brush.BorderStrong}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="IP Address" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding IpAddress}" Classes="Caption" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Centered Action Area -->
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <!-- Prominent TEST SPEED Gradient Button -->
                            <Button Command="{Binding StartTestCommand}"
                                    IsEnabled="{Binding !IsTesting}"
                                    Classes="Gradient"
                                    Background="{DynamicResource Brush.GradientAccent}"
                                    MinWidth="200" Height="50" CornerRadius="25"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActionButtonText}" FontSize="14" FontWeight="Bold" LetterSpacing="1.2" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Status Text -->
                            <TextBlock Text="{Binding StatusText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ════ RIGHT COLUMN: THREE STACKED METRIC CARDS ════ -->
                    <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Center">

                        <!-- Download Card -->
                        <Border Classes="Card" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="20,18">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="☁️↓" FontSize="16" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Download" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Download}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                    <TextBlock Grid.Column="0" Text="{Binding DownloadValueText}" Classes="DisplayMetric" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="MB/s" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Upload Card -->
                        <Border Classes="Card" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="20,18">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="☁️↑" FontSize="16" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Upload" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Upload}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                    <TextBlock Grid.Column="0" Text="{Binding UploadValueText}" Classes="DisplayMetric" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="MB/s" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Ping Card -->
                        <Border Classes="Card" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="20,18">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📈" FontSize="16" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ping" Classes="Body" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Bottom">
                                    <TextBlock Grid.Column="0" Text="{Binding PingValueText}" Classes="DisplayMetric" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <TextBlock Grid.Column="1" Text="ms" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ── BOTTOM TELEMETRY & SPARKLINE WAVEFORM ───────────────────────── -->
                <Border Classes="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="LIVE THROUGHPUT TELEMETRY" Classes="PanelTitle" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="8,2">
                                    <TextBlock Text="REAL-TIME" Classes="Caption" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.Download}"/>
                                    <TextBlock Text="Download" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Brush.Upload}"/>
                                    <TextBlock Text="Upload" Classes="Caption" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Chart Surface -->
                        <Grid ColumnDefinitions="60,*" Height="110" Margin="0,4,0,0">
                            <!-- Y-Axis Labels -->
                            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" VerticalAlignment="Stretch">
                                <TextBlock Grid.Row="0" Text="{Binding GraphYMaxText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="1" Text="{Binding GraphYMidText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Text="{Binding GraphYMinText}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                            </Grid>

                            <!-- Chart Surface -->
                            <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}">
                                <Panel ClipToBounds="True">
                                    <!-- Horizontal Grid Lines -->
                                    <Grid RowDefinitions="*,*,*">
                                        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Opacity="0.4"/>
                                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Opacity="0.4"/>
                                        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Opacity="0.4"/>
                                    </Grid>

                                    <!-- Download Area & Line -->
                                    <Path Data="{Binding RealtimeDownloadAreaGeometry}" Fill="{DynamicResource Brush.Download}" Opacity="0.15" IsVisible="{Binding HasRealtimeGraphData}"/>
                                    <Path Data="{Binding RealtimeDownloadGeometry}" Stroke="{DynamicResource Brush.Download}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding HasRealtimeGraphData}"/>

                                    <!-- Upload Area & Line -->
                                    <Path Data="{Binding RealtimeUploadAreaGeometry}" Fill="{DynamicResource Brush.Upload}" Opacity="0.15" IsVisible="{Binding HasRealtimeGraphData}"/>
                                    <Path Data="{Binding RealtimeUploadGeometry}" Stroke="{DynamicResource Brush.Upload}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding HasRealtimeGraphData}"/>

                                    <!-- Empty / Idle Overlay -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" IsVisible="{Binding !HasRealtimeGraphData}">
                                        <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Run a speed test to view live bandwidth telemetry" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── RECENT TEST RESULTS TABLE ────────────────────────────────────── -->
                <Border Classes="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Large}" Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" Margin="20,16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="RECENT TEST RESULTS" Classes="PanelTitle" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TestHistory.Count, StringFormat='{}{0} Records'}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Background="{DynamicResource Brush.SurfaceHover}" Padding="20,10">
                            <Grid ColumnDefinitions="160,130,130,110,110,*,140">
                                <TextBlock Grid.Column="0" Text="DATE &amp; TIME" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="1" Text="DOWNLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="2" Text="UPLOAD" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="3" Text="PING" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="4" Text="JITTER" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="5" Text="NETWORK" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBlock Grid.Column="6" Text="SERVER" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" LetterSpacing="0.5"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Classes="EmptyState" IsVisible="{Binding !TestHistory.Count}" Margin="0,32">
                            <TextBlock Text="No previous tests" Classes="Body" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Run a speed test to build your test history." Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TestHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,12">
                                        <Grid ColumnDefinitions="160,130,130,110,110,*,140">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='MMM dd, HH:mm'}" Classes="Caption" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedMbps, StringFormat='{}{0:F1} MB/s'}" Classes="Body" Foreground="{DynamicResource Brush.Download}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadSpeedMbps, StringFormat='{}{0:F1} MB/s'}" Classes="Body" Foreground="{DynamicResource Brush.Upload}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PingMs, StringFormat='{}{0:F0} ms'}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding JitterMs, StringFormat='{}{0:F1} ms'}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="5" Text="{Binding NetworkName}" Classes="Body" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="6" Text="{Binding ServerName}" Classes="Caption" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
