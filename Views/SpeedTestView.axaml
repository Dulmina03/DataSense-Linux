<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.SpeedTestView"
             x:DataType="vm:SpeedTestViewModel">

    <UserControl.Styles>
        <Style Selector="Border.stat-box">
            <Setter Property="Background"      Value="#161625"/>
            <Setter Property="BorderBrush"     Value="#2D2D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="24,20"/>
            <Setter Property="MinWidth"        Value="140"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            
            <!-- Header Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Network Speed Test" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Measure your current connection speed and latency using Cloudflare CDN." Foreground="#888899" FontSize="14"/>
            </StackPanel>

            <!-- Test Area -->
            <Border Background="#1E1E2A" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="12" Padding="32">
                <StackPanel Spacing="32">
                    
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Download -->
                        <Border Grid.Column="0" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⬇ Download" Foreground="#00D2FF" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DownloadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Upload -->
                        <Border Grid.Column="1" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⬆ Upload" Foreground="#00E676" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UploadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>

                        <!-- Ping -->
                        <Border Grid.Column="2" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🏓 Ping" Foreground="#AB47BC" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PingText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Jitter -->
                        <Border Grid.Column="3" Classes="stat-box">
                            <StackPanel Spacing="8">
                                <TextBlock Text="〰️ Jitter" Foreground="#FF9800" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding JitterText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status & Progress -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#888899" FontSize="14"/>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" Classes="sidebar-btn" Padding="12,6" Background="#333344"/>
                        </Grid>
                        
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" 
                                     IsIndeterminate="{Binding IsIndeterminateProgress}" 
                                     Foreground="#00D2FF" Background="#262636" BorderThickness="0" CornerRadius="3"
                                     IsVisible="{Binding IsTesting}"/>
                    </StackPanel>

                    <!-- Action Button -->
                    <Button Content="Start Speed Test" 
                            Command="{Binding StartTestCommand}" 
                            IsEnabled="{Binding !IsTesting}"
                            HorizontalAlignment="Center" 
                            Padding="32,16" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Background="#007ACC" 
                            Foreground="White"
                            CornerRadius="8"/>
                </StackPanel>
            </Border>

            <!-- History Section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Recent Test Results" FontSize="18" FontWeight="Bold" Foreground="#E0E0E0"/>
                
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="200,*,*,*,*" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="Date &amp; Time" Foreground="#555577" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Download" Foreground="#555577" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Upload" Foreground="#555577" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Ping" Foreground="#555577" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Server" Foreground="#555577" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                        
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TestHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#1E1E30" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid ColumnDefinitions="200,*,*,*,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='MMM dd, HH:mm'}" Foreground="#CCCCDD" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Foreground="#00D2FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Foreground="#00E676" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PingMs, StringFormat='{}{0:F0} ms'}" Foreground="#AB47BC" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ServerName}" Foreground="#888899" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
