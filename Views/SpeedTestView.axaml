<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             x:Class="DataSense.Views.SpeedTestView"
             x:DataType="vm:SpeedTestViewModel">

    <UserControl.Styles>
        <Style Selector="Border.stat-box">
            <Setter Property="Background"      Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="24,20"/>
            <Setter Property="MinWidth"        Value="140"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="32">
            
            <!-- Header Section -->
            <StackPanel Spacing="8">
                <TextBlock Text="Network Speed Test" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Text="Measure your current connection speed and latency using Cloudflare CDN." Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14"/>
            </StackPanel>

            <!-- Test Area -->
            <Border Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="32">
                <StackPanel Spacing="32">
                    
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Download -->
                        <Border Grid.Column="0" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⬇ Download" Foreground="{DynamicResource Brush.Download}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DownloadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Upload -->
                        <Border Grid.Column="1" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="⬆ Upload" Foreground="{DynamicResource Brush.Upload}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UploadSpeedText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Ping -->
                        <Border Grid.Column="2" Classes="stat-box" Margin="0,0,12,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🏓 Ping" Foreground="{DynamicResource Brush.Accent}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PingText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Jitter -->
                        <Border Grid.Column="3" Classes="stat-box">
                            <StackPanel Spacing="8">
                                <TextBlock Text="〰️ Jitter" Foreground="{DynamicResource Brush.Warning}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding JitterText}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status & Progress -->
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="14"/>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelTestCommand}" IsVisible="{Binding IsTesting}" Classes="Secondary" Padding="12,6"/>
                        </Grid>
                        
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" 
                                     IsIndeterminate="{Binding IsIndeterminateProgress}" 
                                     Foreground="{DynamicResource Brush.Download}" Background="{DynamicResource Brush.Surface}" BorderThickness="0" CornerRadius="3"
                                     IsVisible="{Binding IsTesting}"/>
                    </StackPanel>

                    <!-- Action Button -->
                    <Button Content="Start Speed Test" 
                            Command="{Binding StartTestCommand}" 
                            IsEnabled="{Binding !IsTesting}"
                            HorizontalAlignment="Center" 
                            Classes="Primary"
                            Padding="32,16" 
                            FontSize="16"/>
                </StackPanel>
            </Border>

            <!-- History Section -->
            <StackPanel Spacing="16">
                <TextBlock Text="Recent Test Results" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="200,*,*,*,*" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="Date &amp; Time" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Download" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Upload" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Ping" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Server" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                        
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TestHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid ColumnDefinitions="200,*,*,*,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='MMM dd, HH:mm'}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DownloadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Foreground="{DynamicResource Brush.Download}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding UploadSpeedMbps, StringFormat='{}{0:F1} Mbps'}" Foreground="{DynamicResource Brush.Upload}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PingMs, StringFormat='{}{0:F0} ms'}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ServerName}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
