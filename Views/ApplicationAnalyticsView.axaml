<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             xmlns:m="using:DataSense.Models"
             x:Class="DataSense.Views.ApplicationAnalyticsView"
             x:DataType="vm:ApplicationAnalyticsViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Padding.Large}">
        <StackPanel Spacing="{DynamicResource Spacing.XL}">
            
            <!-- ════ MASTER VIEW ════ -->
            <StackPanel Spacing="{DynamicResource Spacing.XL}" IsVisible="{Binding !IsDetailActive}">
                <!-- Master Header -->
                <Border Classes="CardElevated">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                            <Border Classes="Badge">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Application Analytics" Classes="PageTitle"/>
                                <TextBlock Text="Historical profiling, trend analysis, and attribution" Classes="BodySecondary"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Content="← Dashboard" Command="{Binding NavigateBackCommand}" Classes="Secondary" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Search & Filters Bar -->
                <Border Classes="Card">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search by process name, path, or user..." Width="300" HorizontalAlignment="Left" />
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" Classes="Caption" VerticalAlignment="Center"/>
                            <ComboBox SelectedItem="{Binding SelectedFilter}" Width="150">
                                <ComboBox.Items>
                                    <x:String>All</x:String>
                                    <x:String>Active</x:String>
                                    <x:String>Historical</x:String>
                                    <x:String>Download Heavy</x:String>
                                    <x:String>Upload Heavy</x:String>
                                    <x:String>High Usage</x:String>
                                    <x:String>Increasing</x:String>
                                    <x:String>Decreasing</x:String>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Today" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Classes="Secondary"/>
                            <Button Content="Yesterday" Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday" Classes="Secondary"/>
                            <Button Content="7 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days" Classes="Secondary"/>
                            <Button Content="30 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="Secondary"/>
                            <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth" Classes="Secondary"/>
                            <Button Content="All Time" Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime" Classes="Secondary"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Full Process List Table -->
                <Border Classes="Card">
                    <StackPanel Spacing="{DynamicResource Spacing.MD}">
                        <TextBlock Text="All Applications &amp; Processes" Classes="SectionTitle"/>
                        
                        <StackPanel Classes="EmptyState" IsVisible="{Binding !FilteredProcesses.Count}">
                            <TextBlock Text="No matching processes found." Classes="EmptyStateTitle"/>
                        </StackPanel>
                        
                        <Border Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Small}" Padding="12,8" IsVisible="{Binding FilteredProcesses.Count}">
                            <Grid ColumnDefinitions="*,120,100,120,100">
                                <Button Grid.Column="0" Content="Process Name" Command="{Binding SortCommand}" CommandParameter="Name" Classes="Secondary" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Content="Total Usage" Command="{Binding SortCommand}" CommandParameter="Total" Classes="Secondary" HorizontalAlignment="Left"/>
                                <Button Grid.Column="2" Content="System Share" Command="{Binding SortCommand}" CommandParameter="Percentage" Classes="Secondary" HorizontalAlignment="Left"/>
                                <Button Grid.Column="3" Content="Trend" Command="{Binding SortCommand}" CommandParameter="Trend" Classes="Secondary" HorizontalAlignment="Left"/>
                                <Button Grid.Column="4" Content="Status" Command="{Binding SortCommand}" CommandParameter="Status" Classes="Secondary" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto" IsVisible="{Binding FilteredProcesses.Count}">
                            <ItemsControl ItemsSource="{Binding FilteredProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ApplicationAnalyticsSummary">
                                        <Button Command="{Binding $parent[UserControl].((vm:ApplicationAnalyticsViewModel)DataContext).DrillDownCommand}" CommandParameter="{Binding}" Classes="Icon" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="*,120,100,120,100">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" Classes="Body" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding UserName}" Classes="Caption"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PercentageOfTotal, StringFormat=\{0:F1\}%}" Classes="Body" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding CombinedTrend}" Foreground="{Binding CombinedTrend, Converter={x:Static conv:TrendColorConverter.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                                                    <Border Grid.Column="4" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusBgConverter.Instance}}">
                                                        <TextBlock Text="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusTextConverter.Instance}}" Foreground="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusColorConverter.Instance}}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ════ DETAIL VIEW ════ -->
            <StackPanel Spacing="{DynamicResource Spacing.XL}" IsVisible="{Binding IsDetailActive}">
                <!-- Detail Header -->
                <Border Classes="CardElevated">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="← Back" Command="{Binding NavigateBackCommand}" Classes="Secondary" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}" VerticalAlignment="Center">
                            <Border Classes="Badge">
                                <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ApplicationNameText}" Classes="PageTitle"/>
                                <TextBlock Text="{Binding ProcessNameText}" Classes="BodySecondary"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Border Grid.Column="2" Classes="Badge" IsVisible="{Binding IsCurrentlyActive}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                                <TextBlock Text="Active Now" Foreground="{DynamicResource Brush.Success}" Classes="Body" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="⬇" Foreground="{DynamicResource Brush.Download}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveDownloadSpeed}" Foreground="{DynamicResource Brush.Download}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="⬆" Foreground="{DynamicResource Brush.Upload}" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveUploadSpeed}" Foreground="{DynamicResource Brush.Upload}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2" Text="Currently inactive" Classes="Caption" VerticalAlignment="Center" IsVisible="{Binding !IsCurrentlyActive}"/>
                    </Grid>
                </Border>

                <!-- Loading State inside detail -->
                <Border IsVisible="{Binding IsLoading}" Classes="SkeletonBlock" Height="200" />

                <StackPanel Spacing="{DynamicResource Spacing.XL}" IsVisible="{Binding !IsLoading}">
                    <!-- Period Selector & Summary Cards -->
                    <Border Classes="Card">
                        <StackPanel Spacing="{DynamicResource Spacing.MD}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Usage Summary" Classes="SectionTitle" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Today" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Classes="Secondary"/>
                                    <Button Content="Yesterday" Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday" Classes="Secondary"/>
                                    <Button Content="7 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days" Classes="Secondary"/>
                                    <Button Content="30 Days" Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="Secondary"/>
                                    <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth" Classes="Secondary"/>
                                    <Button Content="All Time" Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime" Classes="Secondary"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*,*,*">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="⬇ Downloaded" Classes="Caption" Foreground="{DynamicResource Brush.Download}"/>
                                    <TextBlock Text="{Binding PeriodTotalDownloadedText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Download}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="⬆ Uploaded" Classes="Caption" Foreground="{DynamicResource Brush.Upload}"/>
                                    <TextBlock Text="{Binding PeriodTotalUploadedText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Upload}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Total Usage" Classes="Caption" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding PeriodTotalUsageText}" Classes="MetricSmall" Foreground="{DynamicResource Brush.Accent}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="6">
                                    <TextBlock Text="Days Used" Classes="Caption"/>
                                    <TextBlock Text="{Binding DaysUsedText}" Classes="Body" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="6">
                                    <TextBlock Text="System Share" Classes="Caption" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{Binding PeriodPercentageShareText}" Classes="Body" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
