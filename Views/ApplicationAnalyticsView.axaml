<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataSense.ViewModels"
             xmlns:conv="using:DataSense.Converters"
             xmlns:m="using:DataSense.Models"
             x:Class="DataSense.Views.ApplicationAnalyticsView"
             x:DataType="vm:ApplicationAnalyticsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.stat-card">
            <Setter Property="Background"      Value="#1A1A2E"/>
            <Setter Property="BorderBrush"     Value="#2D2D44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
        </Style>
        <Style Selector="TextBlock.insight-label">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#444466"/>
        </Style>
        <Style Selector="TextBlock.insight-value">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CCCCEE"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="16">
            
            <!-- ════ MASTER VIEW ════ -->
            <StackPanel Spacing="16" IsVisible="{Binding !IsDetailActive}">
                <!-- Master Header -->
                <Border Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="#2D2D44" CornerRadius="8" Width="40" Height="40">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Application Analytics" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Historical profiling, trend analysis, and attribution" FontSize="12" Foreground="#888899"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Back to Dashboard -->
                        <Button Grid.Column="2" Content="← Dashboard" Command="{Binding NavigateBackCommand}" Classes="link-button" Foreground="#7777AA" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Search & Filters Bar -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <!-- Search Box -->
                        <TextBox Grid.Column="0" Text="{Binding SearchQuery, Mode=TwoWay}" Watermark="Search by process name, path, or user..." Width="300" HorizontalAlignment="Left" Background="#1E1E2F" BorderBrush="#2D2D44" Foreground="#E0E0E0"/>
                        
                        <!-- Status/Usage Filter ComboBox -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" Foreground="#7777AA" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox SelectedItem="{Binding SelectedFilter}" Width="150" Background="#1E1E2F" BorderBrush="#2D2D44">
                                <ComboBox.Items>
                                    <x:String>All</x:String>
                                    <x:String>Active</x:String>
                                    <x:String>Historical</x:String>
                                    <x:String>Download Heavy</x:String>
                                    <x:String>Upload Heavy</x:String>
                                    <x:String>High Usage</x:String>
                                    <x:String>Increasing</x:String>
                                    <x:String>Decreasing</x:String>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>

                        <!-- Period selector -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Today"      Command="{Binding SelectPeriodCommand}" CommandParameter="Today"      Classes="link-button" Background="Transparent"/>
                            <Button Content="Yesterday"  Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday"  Classes="link-button" Background="Transparent"/>
                            <Button Content="7 Days"     Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days"  Classes="link-button" Background="Transparent"/>
                            <Button Content="30 Days"    Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="link-button" Background="Transparent"/>
                            <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth"  Classes="link-button" Background="Transparent"/>
                            <Button Content="All Time"   Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime"    Classes="link-button" Background="Transparent"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Top 5 Grid -->
                <Grid ColumnDefinitions="*,16,*,16,*">
                    <!-- Top 5 Overall -->
                    <Border Grid.Column="0" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top 5 Overall Consumption" FontSize="13" FontWeight="Bold" Foreground="#8888FF"/>
                            <ItemsControl ItemsSource="{Binding TopOverallProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ApplicationAnalyticsSummary">
                                        <Button Classes="link-button" Command="{Binding $parent[UserControl].((vm:ApplicationAnalyticsViewModel)DataContext).DrillDownCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="#1E1E2F" BorderThickness="0,0,0,1" Padding="4,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat=\{0:F1\}% system share}" Foreground="#888899" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#8888FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top 5 Download -->
                    <Border Grid.Column="2" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top 5 Download" FontSize="13" FontWeight="Bold" Foreground="#00D2FF"/>
                            <ItemsControl ItemsSource="{Binding TopDownloadProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ApplicationAnalyticsSummary">
                                        <Button Classes="link-button" Command="{Binding $parent[UserControl].((vm:ApplicationAnalyticsViewModel)DataContext).DrillDownCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="#1E1E2F" BorderThickness="0,0,0,1" Padding="4,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat=\{0:F1\}% system share}" Foreground="#888899" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding DownloadBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00D2FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Top 5 Upload -->
                    <Border Grid.Column="4" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Top 5 Upload" FontSize="13" FontWeight="Bold" Foreground="#00E676"/>
                            <ItemsControl ItemsSource="{Binding TopUploadProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ApplicationAnalyticsSummary">
                                        <Button Classes="link-button" Command="{Binding $parent[UserControl].((vm:ApplicationAnalyticsViewModel)DataContext).DrillDownCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="#1E1E2F" BorderThickness="0,0,0,1" Padding="4,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Text="{Binding PercentageOfTotal, StringFormat=\{0:F1\}% system share}" Foreground="#888899" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding UploadBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00E676" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Full Process List Table -->
                <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="All Applications &amp; Processes" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                        
                        <TextBlock Text="No matching processes found." 
                                   Foreground="#555577" FontSize="13" 
                                   IsVisible="{Binding !FilteredProcesses.Count}" 
                                   HorizontalAlignment="Center" Margin="0,16"/>
                        
                        <!-- Table Header with Sorting -->
                        <Border Background="#1E1E2F" Margin="0,0,0,4" Padding="12,8" CornerRadius="6" IsVisible="{Binding FilteredProcesses.Count}">
                            <Grid ColumnDefinitions="*,120,100,120,100">
                                <Button Grid.Column="0" Content="Process Name" Command="{Binding SortCommand}" CommandParameter="Name" Classes="link-button" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Content="Total Usage" Command="{Binding SortCommand}" CommandParameter="Total" Classes="link-button" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button Grid.Column="2" Content="System Share" Command="{Binding SortCommand}" CommandParameter="Percentage" Classes="link-button" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button Grid.Column="3" Content="Trend" Command="{Binding SortCommand}" CommandParameter="Trend" Classes="link-button" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <Button Grid.Column="4" Content="Status" Command="{Binding SortCommand}" CommandParameter="Status" Classes="link-button" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto" IsVisible="{Binding FilteredProcesses.Count}">
                            <ItemsControl ItemsSource="{Binding FilteredProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="m:ApplicationAnalyticsSummary">
                                        <Button Classes="link-button" Command="{Binding $parent[UserControl].((vm:ApplicationAnalyticsViewModel)DataContext).DrillDownCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" Padding="0">
                                            <Border BorderBrush="#2D2D44" BorderThickness="0,0,0,1" Padding="12,10">
                                                <Grid ColumnDefinitions="*,120,100,120,100">
                                                    <!-- Name -->
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                                        <TextBlock Text="{Binding UserName}" Foreground="#555577" FontSize="10"/>
                                                    </StackPanel>
                                                    <!-- Total -->
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#8888FF" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                                    <!-- Percentage -->
                                                    <TextBlock Grid.Column="2" Text="{Binding PercentageOfTotal, StringFormat=\{0:F1\}%}" Foreground="#CCCCEE" VerticalAlignment="Center" FontSize="12"/>
                                                    <!-- Trend -->
                                                    <TextBlock Grid.Column="3" Text="{Binding CombinedTrend}" Foreground="{Binding CombinedTrend, Converter={x:Static conv:TrendColorConverter.Instance}}" VerticalAlignment="Center" FontSize="12"/>
                                                    <!-- Status -->
                                                    <Border Grid.Column="4" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusBgConverter.Instance}}">
                                                        <TextBlock Text="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusTextConverter.Instance}}" Foreground="{Binding IsCurrentlyRunning, Converter={x:Static conv:RunningStatusColorConverter.Instance}}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ════ DETAIL VIEW ════ -->
            <StackPanel Spacing="16" IsVisible="{Binding IsDetailActive}">
                <!-- Detail Header -->
                <Border Background="#1E1E24" BorderBrush="#2D2D38" BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="← Back" Command="{Binding NavigateBackCommand}" Classes="link-button" Foreground="#7777AA" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Background="#2D2D44" CornerRadius="8" Width="40" Height="40">
                                <TextBlock Text="📱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ApplicationNameText}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding ProcessNameText}" FontSize="12" Foreground="#888899"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Live indicator -->
                        <Border Grid.Column="2" Background="#1A1A28" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="8" Padding="12,8" IsVisible="{Binding IsCurrentlyActive}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse Width="8" Height="8" Fill="#00E676" VerticalAlignment="Center"/>
                                <TextBlock Text="Active Now" Foreground="#00E676" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="⬇" Foreground="#00D2FF" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveDownloadSpeed}" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="⬆" Foreground="#00E676" FontSize="10" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveUploadSpeed}" Foreground="#00E676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="2" Text="Currently inactive" Foreground="#555577" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !IsCurrentlyActive}"/>
                    </Grid>
                </Border>

                <!-- Loading State inside detail -->
                <Border IsVisible="{Binding IsLoading}" Background="#13131F" BorderBrush="#2D2D44" BorderThickness="1" CornerRadius="8" Padding="16,12">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4"/>
                        <TextBlock Text="Loading application analytics…" Foreground="#7777AA" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" IsVisible="{Binding !IsLoading}">
                    <!-- Period Selector & Summary Cards -->
                    <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Usage Summary" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Today"      Command="{Binding SelectPeriodCommand}" CommandParameter="Today"      Classes="link-button" Background="Transparent"/>
                                    <Button Content="Yesterday"  Command="{Binding SelectPeriodCommand}" CommandParameter="Yesterday"  Classes="link-button" Background="Transparent"/>
                                    <Button Content="7 Days"     Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days"  Classes="link-button" Background="Transparent"/>
                                    <Button Content="30 Days"    Command="{Binding SelectPeriodCommand}" CommandParameter="Last30Days" Classes="link-button" Background="Transparent"/>
                                    <Button Content="This Month" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth"  Classes="link-button" Background="Transparent"/>
                                    <Button Content="All Time"   Command="{Binding SelectPeriodCommand}" CommandParameter="AllTime"    Classes="link-button" Background="Transparent"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,12,*,12,*,12,*,12,*">
                                <Border Grid.Column="0" Classes="stat-card" Background="#1A1A2E">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="⬇ Downloaded" Classes="insight-label" Foreground="#00D2FF"/>
                                        <TextBlock Text="{Binding PeriodTotalDownloadedText}" Classes="insight-value" Foreground="#00D2FF"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Classes="stat-card" Background="#1A1A2E">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="⬆ Uploaded" Classes="insight-label" Foreground="#00E676"/>
                                        <TextBlock Text="{Binding PeriodTotalUploadedText}" Classes="insight-value" Foreground="#00E676"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Classes="stat-card" Background="#1A1A2E" BorderBrush="#3535AA">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Total Usage" Classes="insight-label" Foreground="#8888FF"/>
                                        <TextBlock Text="{Binding PeriodTotalUsageText}" Classes="insight-value" Foreground="#8888FF"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="6" Classes="stat-card" Background="#1A1A2E">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Days Used" Classes="insight-label"/>
                                        <TextBlock Text="{Binding DaysUsedText}" Classes="insight-value" Foreground="#CCCCEE"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="8" Classes="stat-card" Background="#1A1A2E">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="System Share" Classes="insight-label" Foreground="#8888FF"/>
                                        <TextBlock Text="{Binding PeriodPercentageShareText}" Classes="insight-value" Foreground="#8888FF"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Chart Area -->
                    <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Usage Timeline" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                            
                            <Border IsVisible="{Binding IsChartEmpty}" Background="#0D0D18" CornerRadius="6" Padding="20" Height="200">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No usage data for the selected period." Foreground="#555577" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel IsVisible="{Binding !IsChartEmpty}" Spacing="0">
                                <Grid Height="160" SizeChanged="ChartContainer_SizeChanged">
                                    <Canvas>
                                        <Line StartPoint="0,0"   EndPoint="2000,0"   Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                        <Line StartPoint="0,40"  EndPoint="2000,40"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                        <Line StartPoint="0,80"  EndPoint="2000,80"  Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                        <Line StartPoint="0,120" EndPoint="2000,120" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.4"/>
                                        <Line StartPoint="0,160" EndPoint="2000,160" Stroke="#1E1E30" StrokeThickness="1" Opacity="0.6"/>
                                    </Canvas>
                                    <!-- Daily Bars -->
                                    <ItemsControl ItemsSource="{Binding PeriodChartItems}" IsVisible="{Binding !IsHourlyChart}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="160"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:DailyChartBarViewModel">
                                                <Canvas>
                                                    <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}" Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}" Fill="#00E676" Opacity="0.85" RadiusX="3" RadiusY="3" ToolTip.Tip="{Binding Tooltip}"/>
                                                    <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}" Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}" Fill="#00D2FF" Opacity="0.85" ToolTip.Tip="{Binding Tooltip}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Hourly Bars -->
                                    <ItemsControl ItemsSource="{Binding HourlyChartItems}" IsVisible="{Binding IsHourlyChart}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="160"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:HourlyChartBarViewModel">
                                                <Canvas>
                                                    <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding UploadBarY}" Width="{Binding BarWidth}" Height="{Binding UploadBarHeight}" Fill="#00E676" Opacity="0.85" RadiusX="3" RadiusY="3" ToolTip.Tip="{Binding Tooltip}"/>
                                                    <Rectangle Canvas.Left="{Binding BarX}" Canvas.Top="{Binding DownloadBarY}" Width="{Binding BarWidth}" Height="{Binding DownloadBarHeight}" Fill="#00D2FF" Opacity="0.85" ToolTip.Tip="{Binding Tooltip}"/>
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                
                                <!-- Day Labels -->
                                <ItemsControl ItemsSource="{Binding PeriodChartItems}" IsVisible="{Binding !IsHourlyChart}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:DailyChartBarViewModel">
                                            <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="4" Text="{Binding DayLabel}" FontSize="10" Foreground="#7777AA" Width="{Binding BarWidth}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                
                                <!-- Hourly Labels -->
                                <ItemsControl ItemsSource="{Binding HourlyChartItems}" IsVisible="{Binding IsHourlyChart}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="28"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:HourlyChartBarViewModel">
                                            <TextBlock Canvas.Left="{Binding BarX}" Canvas.Top="4" Text="{Binding HourLabel}" FontSize="9" Foreground="#7777AA" Width="{Binding BarWidth}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,16,*">
                        <!-- Breakdown & Activity -->
                        <StackPanel Grid.Column="0" Spacing="16">
                            <!-- Breakdown Donut/Bar -->
                            <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Download vs Upload" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                                    
                                    <Border IsVisible="{Binding HasPeriodData}" CornerRadius="4" ClipToBounds="True" Height="22" Background="#0D0D18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding DownloadColumnWidth}"/>
                                                <ColumnDefinition Width="{Binding UploadColumnWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="#00D2FF" Opacity="0.85"/>
                                            <Rectangle Grid.Column="1" Fill="#00E676" Opacity="0.85"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="No data for this period." Foreground="#555577" FontSize="13" IsVisible="{Binding !HasPeriodData}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="24" IsVisible="{Binding HasPeriodData}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="12" Height="12" Fill="#00D2FF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Download" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadActualText}" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DownloadRatioText}" Foreground="#446688" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="12" Height="12" Fill="#00E676" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                            <TextBlock Text="Upload" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UploadActualText}" Foreground="#00E676" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UploadRatioText}" Foreground="#336644" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <!-- Activity & Trends -->
                            <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Activity &amp; Historical Trends" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="First Active:" Foreground="#888899" FontSize="13"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FirstActiveText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Active:" Foreground="#888899" FontSize="13"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastActiveText}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Download Trend:" Foreground="#888899" FontSize="13"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownloadTrendText}" Foreground="#00D2FF" FontWeight="SemiBold" FontSize="13"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Upload Trend:" Foreground="#888899" FontSize="13"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding UploadTrendText}" Foreground="#00E676" FontWeight="SemiBold" FontSize="13"/>

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Combined Trend:" Foreground="#888899" FontSize="13"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding CombinedTrendText}" Foreground="#8888FF" FontWeight="SemiBold" FontSize="13"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ══ Historical Intelligence (Phase 11.31) ══ -->

                            <!-- Surge Warning Banner -->
                            <Border IsVisible="{Binding IsUsageSurging}"
                                    Background="#2A1800" BorderBrush="#FF9800" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⚠" FontSize="16" Foreground="#FF9800" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SurgeText}" Foreground="#FF9800"
                                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Trend Badge Card -->
                            <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1"
                                    CornerRadius="10" Padding="20,14">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                               Text="Usage Trend (7-day vs prior 7-day)"
                                               FontSize="13" FontWeight="Bold" Foreground="#E0E0E0"/>

                                    <!-- Trend badge -->
                                    <Border Grid.Row="2" Grid.Column="0"
                                            Background="#0D0D18" CornerRadius="6" Padding="12,6"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TrendBadgeText}"
                                                   Foreground="{Binding TrendBadgeColor}"
                                                   FontSize="14" FontWeight="Bold"/>
                                    </Border>

                                    <!-- Rank badge -->
                                    <Border Grid.Row="2" Grid.Column="1"
                                            Background="#0D0D18" CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="{Binding RankText}"
                                                   Foreground="#7777FF" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                                               Text="{Binding SevenDayComparisonText}"
                                               Foreground="{Binding SevenDayComparisonColor}"
                                               FontSize="11"/>
                                </Grid>
                            </Border>

                            <!-- Historical Averages + Projections -->
                            <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1"
                                    CornerRadius="10" Padding="20,14">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Historical Averages &amp; Projections"
                                               FontSize="13" FontWeight="Bold" Foreground="#E0E0E0"/>

                                    <!-- Insufficient data notice -->
                                    <TextBlock Text="{Binding InsufficientDataText}"
                                               Foreground="#FF9800" FontSize="11" FontStyle="Italic"
                                               IsVisible="{Binding !HasSufficientHistory}"/>

                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,10,Auto,10,Auto">
                                        <!-- 7-day average -->
                                        <Border Grid.Row="0" Grid.Column="0" Classes="stat-card" Margin="0,0,6,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="7-Day Avg / Day" Classes="insight-label"/>
                                                <TextBlock Text="{Binding SevenDayAverageText}" Classes="insight-value" Foreground="#00D2FF"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 30-day average -->
                                        <Border Grid.Row="0" Grid.Column="1" Classes="stat-card" Margin="6,0,0,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="30-Day Avg / Day" Classes="insight-label"/>
                                                <TextBlock Text="{Binding ThirtyDayAverageText}" Classes="insight-value" Foreground="#00E676"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Monthly projection -->
                                        <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="stat-card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Monthly Projection" Classes="insight-label"/>
                                                    <TextBlock Text="{Binding MonthlyProjectionText}" Classes="insight-value" Foreground="#8888FF"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding TodayVsYesterdayText}" Foreground="#888899" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Peak day -->
                                        <Border Grid.Row="4" Grid.Column="0" Classes="stat-card" Margin="0,0,6,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Peak Day" Classes="insight-label"/>
                                                <TextBlock Text="{Binding PeakDayText}" Classes="insight-value" Foreground="#FFD600"/>
                                                <TextBlock Text="{Binding PeakDayBytesText}" Foreground="#888899" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Peak hour -->
                                        <Border Grid.Row="4" Grid.Column="1" Classes="stat-card" Margin="6,0,0,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Peak Hour (UTC)" Classes="insight-label"/>
                                                <TextBlock Text="{Binding PeakHourText}" Classes="insight-value" Foreground="#FFD600"/>
                                                <TextBlock Text="{Binding PeakHourBytesText}" Foreground="#888899" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Daily Usage Table -->
                        <Border Grid.Column="2" Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Daily Usage" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                                
                                <TextBlock Text="Table not available for 'Today' view or no data found." 
                                           Foreground="#555577" FontSize="13" 
                                           IsVisible="{Binding IsHistoryTableEmpty}" 
                                           HorizontalAlignment="Center" Margin="0,16"/>
                                
                                <!-- Table Header -->
                                <Border Background="#13131F" Margin="0,0,0,4" Padding="12,8" IsVisible="{Binding !IsHistoryTableEmpty}">
                                    <Grid ColumnDefinitions="*,100,100,100">
                                        <TextBlock Grid.Column="0" Text="Date" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="Download" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="Upload" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="Total" Foreground="#7777AA" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsHistoryTableEmpty}">
                                    <ItemsControl ItemsSource="{Binding DailyHistoryItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="m:ApplicationUsageTimelinePoint">
                                                <Border BorderBrush="#2D2D44" BorderThickness="0,0,0,1" Padding="12,8">
                                                    <Grid ColumnDefinitions="*,100,100,100">
                                                        <!-- Date -->
                                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=\{0:MMM d\}}" Foreground="#CCCCEE" VerticalAlignment="Center" FontSize="12"/>
                                                        <!-- Download -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DownloadBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00D2FF" VerticalAlignment="Center" FontSize="12"/>
                                                        <!-- Upload -->
                                                        <TextBlock Grid.Column="2" Text="{Binding UploadBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#00E676" VerticalAlignment="Center" FontSize="12"/>
                                                        <!-- Total -->
                                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#8888FF" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══ Process Network Usage Profiles & Behavior ══ -->
                    <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Network Usage &amp; Attribution" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                            
                            <TextBlock Text="No cross-network telemetry recorded for this process." 
                                       Foreground="#555577" FontSize="13" 
                                       IsVisible="{Binding IsProcessNetworkUsageProfilesEmpty}" 
                                       HorizontalAlignment="Center" Margin="0,16"/>

                            <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding !IsProcessNetworkUsageProfilesEmpty}">
                                <!-- Left: Network Usage Profiles list -->
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Networks Used by this Process" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                    <!-- Table Header -->
                                    <Border Background="#1A1A2E" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="*,80,90,70,80">
                                            <TextBlock Grid.Column="0" Text="Network" Foreground="#7777AA" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="Type" Foreground="#7777AA" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="Total" Foreground="#7777AA" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="3" Text="Share" Foreground="#7777AA" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="4" Text="Active Days" Foreground="#7777AA" FontSize="10" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Height="180" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ProcessNetworkUsageProfiles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#2D2D44" BorderThickness="0,0,0,1" Padding="8,6">
                                                        <Grid ColumnDefinitions="*,80,90,70,80">
                                                            <TextBlock Grid.Column="0" Text="{Binding NetworkName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ConnectionType}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding TotalBytes, Converter={x:Static conv:ByteFormatConverter.Instance}}" Foreground="#8888FF" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding PercentageOfNetworkUsage, StringFormat='\{0:F1\}%'}" Foreground="#CCCCEE" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding ActiveDays}" Foreground="#CCCCEE" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- Right: Network Behavior Stats -->
                                <StackPanel Grid.Column="2" Spacing="10">
                                    <TextBlock Text="Network Behavior &amp; Trend" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                    
                                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto" Margin="0,4,0,0">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Most Used Network:" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MostUsedNetwork}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Highest Download:" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HighestDownloadNetwork}" Foreground="#00D2FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Highest Upload:" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HighestUploadNetwork}" Foreground="#00E676" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Trend by Network:" Foreground="#888899" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding NetworkTrendText}" Foreground="#FFB300" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Smart Recommendations & Profile Intelligence -->
                    <Border Background="#13131F" BorderBrush="#1E1E30" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💡" FontSize="14"/>
                                <TextBlock Text="Smart Recommendations &amp; Profile Intelligence" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,16,*">
                                <!-- Profile Intelligence Engine (7 key areas) -->
                                <StackPanel Grid.Column="0" Spacing="12">
                                    <!-- 1. Behavior & Direction Classification -->
                                    <Border Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Network Traffic Direction" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{Binding NetworkProfile.DirectionClassification}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="Based on real download/upload telemetry" Foreground="#888899" FontSize="10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NetworkProfile.DownloadPercentage, StringFormat='{}{0:F0}% Download'}" Foreground="#00D2FF" FontWeight="Bold" FontSize="11"/>
                                                    <TextBlock Text="{Binding NetworkProfile.UploadPercentage, StringFormat='{}{0:F0}% Upload'}" Foreground="#00E676" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2. Trend & Data Share Analysis -->
                                    <Border Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Trend &amp; Data Share Analysis" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                                <!-- Trend -->
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Weekly Trend" Foreground="#888899" FontSize="11"/>
                                                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="#1D2A1D">
                                                        <TextBlock Text="{Binding NetworkProfile.TrendState}" Foreground="#00E676" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <!-- Data Share -->
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="Consumption Share" Foreground="#888899" FontSize="11"/>
                                                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="#1D1D2C">
                                                        <TextBlock Text="{Binding NetworkProfile.DataShareClassification}" Foreground="#8888FF" FontWeight="Bold" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 3. Peak Usage Analysis -->
                                    <Border Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Peak Usage Analysis" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto,8,Auto" Margin="0,4,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Peak Activity Day:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetworkProfile.PeakDay}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Peak Activity Hour:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetworkProfile.PeakHour, StringFormat='{}{0}:00 UTC'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Peak Usage Period:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetworkProfile.PeakUsagePeriod}" Foreground="#FFB300" FontWeight="Bold" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Session & Observation Details -->
                                    <Border Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Observed Activity Telemetry" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,8,Auto,8,Auto" Margin="0,4,0,0">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="First Observed:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetworkProfile.FirstObserved, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#FFFFFF" FontSize="12"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Observed:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetworkProfile.LastObserved, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#FFFFFF" FontSize="12"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Telemetry Samples:" Foreground="#888899" FontSize="12"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding NetworkProfile.ObservedSessionsCount}" Foreground="#8888FF" FontWeight="Bold" FontSize="12"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- 5. Anomaly State -->
                                    <Border Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Anomaly Detection Engine" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Statistical Anomaly State" Foreground="#888899" FontSize="11"/>
                                                    <TextBlock Text="{Binding NetworkProfile.AnomalyState}" Foreground="#FF5252" FontWeight="Bold" FontSize="14"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="8,4" Background="#2C1D1D" VerticalAlignment="Center">
                                                    <TextBlock Text="Deterministic Baseline" Foreground="#FF5252" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Recommendations -->
                                <Border Grid.Column="2" Background="#161626" BorderBrush="#222238" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Optimization Advice" Foreground="#8888AA" FontSize="11" FontWeight="SemiBold"/>

                                        <ItemsControl ItemsSource="{Binding ProcessRecommendations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="m:ApplicationRecommendation">
                                                    <Border Background="#1A1828" BorderBrush="{Binding ImpactColor}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,3">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                                                <Border Grid.Column="1" Background="#261C33" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding ImpactLabel}" Foreground="{Binding ImpactColor}" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding Description}" Foreground="#BBBBDD" FontSize="11" TextWrapping="Wrap"/>
                                                            <Border Background="#0D0D18" CornerRadius="4" Padding="8,6" Margin="0,2,0,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="💡" FontSize="11"/>
                                                                    <TextBlock Text="{Binding ActionableStep}" Foreground="#00E676" FontSize="10" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
