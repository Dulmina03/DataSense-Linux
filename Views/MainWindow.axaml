<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DataSense.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="DataSense.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DataSense"
        MinWidth="1024"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- SIDEBAR (Navigation Rail) -->
        <Border Grid.Column="0" Width="260" Background="{DynamicResource Brush.NavigationBackground}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- BRANDING AREA -->
                <StackPanel Grid.Row="0" Margin="{DynamicResource Padding.Large}" Spacing="{DynamicResource Spacing.SM}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="{DynamicResource Radius.Small}" Width="24" Height="24" Margin="0,0,12,0">
                            <TextBlock Text="▶" Foreground="{DynamicResource Brush.AppBackground}" Classes="Caption" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="DataSense" Classes="SectionTitle" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Ubuntu Desktop Analytics" Classes="Caption" />
                </StackPanel>

                <!-- NAVIGATION ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{DynamicResource Spacing.XS}" Margin="{DynamicResource Padding.Medium}">

                        <!-- Primary Views -->
                        <TextBlock Text="OVERVIEW" Classes="Caption" Margin="12,16,12,8" FontWeight="SemiBold" LetterSpacing="0.5"/>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsDashboardActive}" Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="📊" Width="16" />
                                <TextBlock Text="Dashboard" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsHistoryActive}" Command="{Binding NavigateToHistoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="📜" Width="16" />
                                <TextBlock Text="History Log" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsExplorerActive}" Command="{Binding NavigateToExplorerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🏛️" Width="16" />
                                <TextBlock Text="Usage Explorer" />
                            </StackPanel>
                        </Button>

                        <!-- Diagnostics & Tools -->
                        <TextBlock Text="TOOLS" Classes="Caption" Margin="12,24,12,8" FontWeight="SemiBold" LetterSpacing="0.5"/>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsUnifiedIntelligenceActive}" Command="{Binding NavigateToUnifiedIntelligenceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🧠" Width="16" />
                                <TextBlock Text="Intelligence Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsLiveMonitoringActive}" Command="{Binding NavigateToLiveMonitoringCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="📡" Width="16" />
                                <TextBlock Text="Live Monitor" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsTimelineActive}" Command="{Binding NavigateToTimelineCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="⏱️" Width="16" />
                                <TextBlock Text="Timeline" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsSpeedTestActive}" Command="{Binding NavigateToSpeedTestCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🚀" Width="16" />
                                <TextBlock Text="Speed Test" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsDiagnosticsActive}" Command="{Binding NavigateToDiagnosticsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🛠️" Width="16" />
                                <TextBlock Text="Diagnostics" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsPerformanceActive}" Command="{Binding NavigateToPerformanceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="⚡" Width="16" />
                                <TextBlock Text="Performance" />
                            </StackPanel>
                        </Button>

                        <!-- Data & System -->
                        <TextBlock Text="SYSTEM" Classes="Caption" Margin="12,24,12,8" FontWeight="SemiBold" LetterSpacing="0.5"/>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsExportActive}" Command="{Binding NavigateToExportCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="📤" Width="16" />
                                <TextBlock Text="Export &amp; Reports" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsImportRestoreActive}" Command="{Binding NavigateToImportRestoreCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="📥" Width="16" />
                                <TextBlock Text="Import &amp; Restore" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsBackupRecoveryActive}" Command="{Binding NavigateToBackupRecoveryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🛡️" Width="16" />
                                <TextBlock Text="Backup &amp; Recovery" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsEventCenterActive}" Command="{Binding NavigateToEventCenterCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                                <TextBlock Text="🔔" Width="16" />
                                <TextBlock Text="Event Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER / SETTINGS -->
                <StackPanel Grid.Row="2" Spacing="{DynamicResource Spacing.XS}" Margin="{DynamicResource Padding.Medium}">
                    <Button Classes="SidebarItem" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="⚙️" Width="16" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarItem" Classes.active="{Binding IsPrivacyActive}" Command="{Binding NavigateToPrivacyCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="🔒" Width="16" />
                            <TextBlock Text="Privacy" />
                        </StackPanel>
                    </Button>
                    <Button Classes="SidebarItem" Classes.active="{Binding IsAboutActive}" Command="{Binding NavigateToAboutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Spacing.MD}">
                            <TextBlock Text="ℹ️" Width="16" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="v1.0.0-Beta" Classes="Caption" Margin="12,8,12,0" Foreground="{DynamicResource Brush.TextDisabled}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{DynamicResource Brush.AppBackground}">

            <!-- Context Header (Top Bar) -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.AppBackground}" BorderBrush="Transparent" BorderThickness="0" Padding="32,24,32,0">
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Current Page Context (Only shown when not Dashboard, as Dashboard has its own large header) -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentPage.Title}"
                               Classes="PageTitle"
                               IsVisible="{Binding !IsDashboardActive}"
                               VerticalAlignment="Center"/>

                    <!-- We optionally can put global actions here -->
                </Grid>
            </Border>

            <!-- Dynamic Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
