<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DataSense.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="DataSense.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DataSense"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}">

    <!-- Sidebar Button Style is now defined in Controls.axaml -->

    <Grid ColumnDefinitions="Auto,*">
        <!-- Sidebar Navigation (Left Column) -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="{DynamicResource Brush.SurfaceElevated}">
            <!-- App Logo / Title Header -->
            <StackPanel Grid.Row="0" Margin="24" Spacing="8">
                <TextBlock Text="DATASENSE" IsVisible="{Binding IsSidebarExpanded}" 
                           FontSize="20" 
                           FontWeight="Black" 
                           LetterSpacing="2"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <TextBlock Text="Ubuntu Desktop Analytics" IsVisible="{Binding IsSidebarExpanded}" 
                           FontSize="11" 
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <Separator Height="1" Background="{DynamicResource Brush.Border}" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Navigation Buttons -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="12,0">
                <Button Classes="SidebarItem" ToolTip.Tip="Dashboard" 
                        Classes.active="{Binding IsDashboardActive}"
                        Command="{Binding NavigateToDashboardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📊" Width="20" />
                        <TextBlock Text="Dashboard" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Intelligence Center" 
                        Classes.active="{Binding IsUnifiedIntelligenceActive}"
                        Command="{Binding NavigateToUnifiedIntelligenceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🧠" Width="20" />
                        <TextBlock Text="Intelligence Center" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Live Monitor" 
                        Classes.active="{Binding IsLiveMonitoringActive}"
                        Command="{Binding NavigateToLiveMonitoringCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📡" Width="20" />
                        <TextBlock Text="Live Monitor" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Timeline" 
                        Classes.active="{Binding IsTimelineActive}"
                        Command="{Binding NavigateToTimelineCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⏱️" Width="20" />
                        <TextBlock Text="Timeline" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="History Log" 
                        Classes.active="{Binding IsHistoryActive}"
                        Command="{Binding NavigateToHistoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📜" Width="20" />
                        <TextBlock Text="History Log" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Usage Explorer" 
                        Classes.active="{Binding IsExplorerActive}"
                        Command="{Binding NavigateToExplorerCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🏛️" Width="20" />
                        <TextBlock Text="Usage Explorer" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Speed Test" 
                        Classes.active="{Binding IsSpeedTestActive}"
                        Command="{Binding NavigateToSpeedTestCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🚀" Width="20" />
                        <TextBlock Text="Speed Test" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Settings" 
                        Classes.active="{Binding IsSettingsActive}"
                        Command="{Binding NavigateToSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⚙️" Width="20" />
                        <TextBlock Text="Settings" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Privacy &amp; Data" 
                        Classes.active="{Binding IsPrivacyActive}"
                        Command="{Binding NavigateToPrivacyCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🛡️" Width="20" />
                        <TextBlock Text="Privacy &amp; Data" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Diagnostics" 
                        Classes.active="{Binding IsDiagnosticsActive}"
                        Command="{Binding NavigateToDiagnosticsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🛠️" Width="20" />
                        <TextBlock Text="Diagnostics" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Performance" 
                        Classes.active="{Binding IsPerformanceActive}"
                        Command="{Binding NavigateToPerformanceCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="⚡" Width="20" />
                        <TextBlock Text="Performance" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Export &amp; Reports" 
                        Classes.active="{Binding IsExportActive}"
                        Command="{Binding NavigateToExportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📤" Width="20" />
                        <TextBlock Text="Export &amp; Reports" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Event Center" 
                        Classes.active="{Binding IsEventCenterActive}"
                        Command="{Binding NavigateToEventCenterCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🔔" Width="20" />
                        <TextBlock Text="Event Center" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Import &amp; Restore" 
                        Classes.active="{Binding IsImportRestoreActive}"
                        Command="{Binding NavigateToImportRestoreCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="📥" Width="20" />
                        <TextBlock Text="Import &amp; Restore" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="Backup &amp; Recovery" 
                        Classes.active="{Binding IsBackupRecoveryActive}"
                        Command="{Binding NavigateToBackupRecoveryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="🛡️" Width="20" />
                        <TextBlock Text="Backup &amp; Recovery" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
                <Button Classes="SidebarItem" ToolTip.Tip="About" 
                        Classes.active="{Binding IsAboutActive}"
                        Command="{Binding NavigateToAboutCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="ℹ️" Width="20" />
                        <TextBlock Text="About" IsVisible="{Binding IsSidebarExpanded}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Sidebar Footer -->
            <StackPanel Grid.Row="2" Margin="24" Spacing="4">
                <TextBlock Text="V1.0.0-Beta" IsVisible="{Binding IsSidebarExpanded}" 
                           FontSize="10" 
                           Foreground="{DynamicResource Brush.TextMuted}" 
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Main Content Area (Right Column) -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{DynamicResource Brush.AppBackground}">
            <!-- Header bar -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="24,16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" 
                               Text="{Binding CurrentPage.Title}" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.TextPrimary}" 
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12,6">
                        <TextBlock Text="Online" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Dynamic Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="24" />
        </Grid>
    </Grid>
</Window>
