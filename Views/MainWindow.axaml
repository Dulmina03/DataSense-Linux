<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DataSense.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="DataSense.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="DataSense"
        Icon="avares://DataSense/Assets/datasense.ico"
        MinWidth="1024"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackgroundGradient}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- SIDEBAR (Navigation Rail) -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.NavigationBackground}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0"
                Classes.sidebar-expanded="{Binding IsSidebarExpanded}"
                Classes.sidebar-collapsed="{Binding !IsSidebarExpanded}">
            <Border.Styles>
                <Style Selector="Border.sidebar-expanded">
                    <Setter Property="Width" Value="260" />
                </Style>
                <Style Selector="Border.sidebar-collapsed">
                    <Setter Property="Width" Value="68" />
                </Style>
            </Border.Styles>

            <Grid RowDefinitions="Auto,*,Auto">

                <!-- BRANDING AREA & TOGGLE BUTTON -->
                <Grid Grid.Row="0" Margin="14,16,14,12" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <Border Grid.Column="0" CornerRadius="{DynamicResource Radius.Medium}" ClipToBounds="True" Width="32" Height="32" VerticalAlignment="Center">
                        <Image Source="avares://DataSense/Assets/datasense.png" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSidebarExpanded}">
                        <TextBlock Text="DataSense" Classes="SectionTitle" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="Ubuntu Desktop Analytics" Classes="Caption"/>
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding ToggleSidebarCommand}" Classes="Icon" Width="32" Height="32" Padding="0" ToolTip.Tip="Toggle Sidebar" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="☰" FontSize="16" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- NAVIGATION ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{DynamicResource Spacing.XS}" Margin="8,4">

                        <Button Classes="SidebarItem" Classes.active="{Binding IsDashboardActive}" Command="{Binding NavigateToDashboardCommand}" ToolTip.Tip="Dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="📊" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Dashboard" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsHistoryActive}" Command="{Binding NavigateToHistoryCommand}" ToolTip.Tip="History Log">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="📜" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="History Log" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsSpeedTestActive}" Command="{Binding NavigateToSpeedTestCommand}" ToolTip.Tip="Speed Test">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="🚀" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Speed Test" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="SidebarItem" Classes.active="{Binding IsExportActive}" Command="{Binding NavigateToExportCommand}" ToolTip.Tip="Export &amp; Reports">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="📤" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Export &amp; Reports" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsEventCenterActive}" Command="{Binding NavigateToEventCenterCommand}" ToolTip.Tip="Event Center">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="🔔" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Event Center" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}" ToolTip.Tip="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="⚙️" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Settings" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="SidebarItem" Classes.active="{Binding IsAboutActive}" Command="{Binding NavigateToAboutCommand}" ToolTip.Tip="About">
                            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Left">
                                <TextBlock Text="ℹ️" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="About" IsVisible="{Binding IsSidebarExpanded}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER -->
                <StackPanel Grid.Row="2" Spacing="{DynamicResource Spacing.XS}" Margin="8,8" IsVisible="{Binding IsSidebarExpanded}">
                    <TextBlock Text="v1.0.0-Beta" Classes="Caption" Margin="12,8,12,0" Foreground="{DynamicResource Brush.TextDisabled}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="Transparent">
            <!-- Dynamic Page Content -->
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
