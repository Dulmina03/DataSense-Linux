<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DataSense/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://DataSense/Styles/Spacing.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <StyleInclude Source="avares://DataSense/Styles/Controls.axaml" />
    <StyleInclude Source="avares://DataSense/Styles/Typography.axaml" />
    <StyleInclude Source="avares://DataSense/Styles/Buttons.axaml" />
    <StyleInclude Source="avares://DataSense/Styles/Cards.axaml" />
    <StyleInclude Source="avares://DataSense/Styles/LiquidGlass.axaml" />
    <StyleInclude Source="avares://DataSense/Styles/States.axaml" />
</Styles>
