<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
    DATASENSE CENTRALIZED SEMANTIC THEME RESOURCE SYSTEM
    ====================================================
    All brushes are defined at the root ResourceDictionary level so that
    runtime ThemeService updates seamlessly propagate to all {DynamicResource} bindings.
    -->

    <!-- Backgrounds & Navigation (High Transparency Glassmorphism + Black/Blue Atmosphere) -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="#000000"/>
    <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#20020814"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#24061224"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#2E0A1A32"/>
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#14040C18"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#3810264A"/>
    <SolidColorBrush x:Key="Brush.GlassSurface" Color="#24061224"/>
    <SolidColorBrush x:Key="Brush.GlassSurfaceElevated" Color="#2E0A1A32"/>
    <SolidColorBrush x:Key="Brush.GlassHighlight" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.GlassShadow" Color="#20000000"/>

    <!-- Application Background Diagonal Atmospheric Gradient (Black ↘ Deep Blue Atmosphere) -->
    <LinearGradientBrush x:Key="Brush.AppBackgroundGradient" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#000000" Offset="0.0"/>
        <GradientStop Color="#020B18" Offset="0.25"/>
        <GradientStop Color="#04152D" Offset="0.50"/>
        <GradientStop Color="#062B5C" Offset="0.75"/>
        <GradientStop Color="#020812" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="Brush.Border" Color="#283C6699"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#18284568"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#454E80B8"/>
    <SolidColorBrush x:Key="Brush.GlassBorder" Color="#283C6699"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#20284568"/>

    <!-- Typography (High-Contrast Theme-Aware) -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F5F7FF"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CAD0E8"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8E98B8"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#545D78"/>
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF"/>

    <!-- Primary Accent (Electric Purple / Violet) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#A100FF"/>
    <SolidColorBrush x:Key="Brush.AccentBright" Color="#00E5FF"/>
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#FF007F"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#B833FF"/>
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="#D000FF"/>
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="#1D1D3A"/>
    <SolidColorBrush x:Key="Brush.AmbientGlow" Color="#4A00E0"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="Brush.Success" Color="#39FF88"/>
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#122E22"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFD166"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="#33141E"/>

    <!-- Download Palette -->
    <SolidColorBrush x:Key="Brush.Download" Color="#00D8F6"/>
    <SolidColorBrush x:Key="Brush.DownloadBright" Color="#00F0FF"/>
    <SolidColorBrush x:Key="Brush.DownloadMuted" Color="#00D8F6"/>
    <SolidColorBrush x:Key="Brush.DownloadGlow" Color="#00D8F6"/>
    <SolidColorBrush x:Key="Brush.DownloadSurface" Color="#0D2235"/>

    <!-- Upload Palette -->
    <SolidColorBrush x:Key="Brush.Upload" Color="#A855F7"/>
    <SolidColorBrush x:Key="Brush.UploadBright" Color="#D000FF"/>
    <SolidColorBrush x:Key="Brush.UploadDeep" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Brush.UploadGlow" Color="#A855F7"/>
    <SolidColorBrush x:Key="Brush.UploadSurface" Color="#25173B"/>

    <!-- Charts, Gridlines & Tooltips -->
    <SolidColorBrush x:Key="Brush.ChartGrid" Color="#303052"/>
    <SolidColorBrush x:Key="Brush.ChartAxis" Color="#8585AD"/>
    <SolidColorBrush x:Key="Brush.ChartTooltip" Color="#1D1D3A"/>
    <SolidColorBrush x:Key="Brush.ChartTooltipText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ChartSegmentOther" Color="#6E6E9B"/>

    <!-- Curated 12-Segment Process Palette & Semantic Aliases -->
    <SolidColorBrush x:Key="Brush.ChartSegment1" Color="#00F0FF"/>
    <SolidColorBrush x:Key="Brush.ChartSegment2" Color="#39FF88"/>
    <SolidColorBrush x:Key="Brush.ChartSegment3" Color="#FFD166"/>
    <SolidColorBrush x:Key="Brush.ChartSegment4" Color="#FF007F"/>
    <SolidColorBrush x:Key="Brush.ChartSegment5" Color="#A855F7"/>
    <SolidColorBrush x:Key="Brush.ChartSegment6" Color="#00D8F6"/>
    <SolidColorBrush x:Key="Brush.ChartSegment7" Color="#818CF8"/>
    <SolidColorBrush x:Key="Brush.ChartSegment8" Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.ChartSegment9" Color="#D000FF"/>
    <SolidColorBrush x:Key="Brush.ChartSegment10" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Brush.ChartSegment11" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="Brush.ChartSegment12" Color="#00E5FF"/>

    <SolidColorBrush x:Key="Brush.ProcessChart1" Color="#00F0FF"/>
    <SolidColorBrush x:Key="Brush.ProcessChart2" Color="#39FF88"/>
    <SolidColorBrush x:Key="Brush.ProcessChart3" Color="#FFD166"/>
    <SolidColorBrush x:Key="Brush.ProcessChart4" Color="#FF007F"/>
    <SolidColorBrush x:Key="Brush.ProcessChart5" Color="#A855F7"/>
    <SolidColorBrush x:Key="Brush.ProcessChart6" Color="#00D8F6"/>
    <SolidColorBrush x:Key="Brush.ProcessChart7" Color="#818CF8"/>
    <SolidColorBrush x:Key="Brush.ProcessChart8" Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.ProcessChart9" Color="#D000FF"/>
    <SolidColorBrush x:Key="Brush.ProcessChart10" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="Brush.ProcessChart11" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="Brush.ProcessChart12" Color="#00E5FF"/>

    <!-- Bar Chart Two-Color Gradients -->
    <LinearGradientBrush x:Key="Brush.DownloadBarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#22E3FF" Offset="0"/>
        <GradientStop Color="#0077A8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.UploadBarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#C56CFF" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>

    <!-- Floating Glow & Area Gradient Brushes -->
    <LinearGradientBrush x:Key="Brush.HeroDownloadGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#3800D8F6" Offset="0"/>
        <GradientStop Color="#0016162C" Offset="0.75"/>
        <GradientStop Color="#0016162C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeroUploadGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#38A855F7" Offset="0"/>
        <GradientStop Color="#0016162C" Offset="0.75"/>
        <GradientStop Color="#0016162C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HeroUsageGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#284A00E0" Offset="0"/>
        <GradientStop Color="#0016162C" Offset="0.75"/>
        <GradientStop Color="#0016162C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.ActiveNavGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#2EA100FF" Offset="0"/>
        <GradientStop Color="#08A100FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.DownloadAreaGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2200D8F6" Offset="0"/>
        <GradientStop Color="#0200D8F6" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.UploadAreaGradient" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#22A855F7" Offset="0"/>
        <GradientStop Color="#02A855F7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GradientDownload" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#00D8F6" Offset="0"/>
        <GradientStop Color="#00F0FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GradientUpload" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#A855F7" Offset="0"/>
        <GradientStop Color="#D000FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GradientVioletPink" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#A100FF" Offset="0"/>
        <GradientStop Color="#FF007F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GradientCyanPink" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#00F0FF" Offset="0"/>
        <GradientStop Color="#FF007F" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GradientAccent" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#A100FF" Offset="0"/>
        <GradientStop Color="#00E5FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- FluentTheme System Overrides -->
    <SolidColorBrush x:Key="SystemRegionBrush" Color="#0B0B16"/>
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#0B0B16"/>
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#16162C"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#16162C"/>
    <SolidColorBrush x:Key="SystemControlBackgroundChromeLowBrush" Color="#1D1D3A"/>
    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#16162C"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#C4C4E8"/>
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#8585AD"/>
</ResourceDictionary>
