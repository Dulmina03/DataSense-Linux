<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        
        <!-- DARK THEME (DEFAULT) -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="Brush.AppBackground" Color="#06080D"/>
            <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#0A0D14"/>
            <SolidColorBrush x:Key="Brush.Surface" Color="#111520"/>
            <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#171D2B"/>
            <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#202738"/>
            <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#141A26"/>
            <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#0E121C"/>
            
            <SolidColorBrush x:Key="Brush.Border" Color="#1C2333"/>
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="#283247"/>
            
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="Brush.TextDisabled" Color="#475569"/>
            
            <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#60A5FA"/>
            <SolidColorBrush x:Key="Brush.AccentSurface" Color="#1A3B82F6"/>
            
            <SolidColorBrush x:Key="Brush.Success" Color="#10B981"/>
            <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#1A10B981"/>
            <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
            <SolidColorBrush x:Key="Brush.DangerSurface" Color="#1AEF4444"/>
            
            <SolidColorBrush x:Key="Brush.Download" Color="#38BDF8"/>
            <SolidColorBrush x:Key="Brush.Upload" Color="#A855F7"/>

            <!-- Sophisticated 8-Segment Chart Palette (Harmonious with DataSense dark design) -->
            <SolidColorBrush x:Key="Brush.ChartSegment1" Color="#38BDF8"/> <!-- Electric Cyan -->
            <SolidColorBrush x:Key="Brush.ChartSegment2" Color="#A855F7"/> <!-- Sophisticated Violet -->
            <SolidColorBrush x:Key="Brush.ChartSegment3" Color="#6366F1"/> <!-- Indigo -->
            <SolidColorBrush x:Key="Brush.ChartSegment4" Color="#14B8A6"/> <!-- Teal -->
            <SolidColorBrush x:Key="Brush.ChartSegment5" Color="#F59E0B"/> <!-- Muted Amber -->
            <SolidColorBrush x:Key="Brush.ChartSegment6" Color="#3B82F6"/> <!-- Blue -->
            <SolidColorBrush x:Key="Brush.ChartSegment7" Color="#C084FC"/> <!-- Muted Purple / Lavender -->
            <SolidColorBrush x:Key="Brush.ChartSegment8" Color="#10B981"/> <!-- Emerald -->
            <SolidColorBrush x:Key="Brush.ChartSegmentOther" Color="#64748B"/> <!-- Slate / Muted Neutral -->

            <!-- FluentTheme System Overrides -->
            <SolidColorBrush x:Key="SystemRegionBrush" Color="#06080D"/>
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#06080D"/>
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlBackgroundChromeLowBrush" Color="#171D2B"/>
            <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#64748B"/>
        </ResourceDictionary>

        <!-- DARK THEME EXPLICIT KEY -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Brush.AppBackground" Color="#06080D"/>
            <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#0A0D14"/>
            <SolidColorBrush x:Key="Brush.Surface" Color="#111520"/>
            <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#171D2B"/>
            <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#202738"/>
            <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#141A26"/>
            <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#0E121C"/>
            
            <SolidColorBrush x:Key="Brush.Border" Color="#1C2333"/>
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="#283247"/>
            
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="Brush.TextDisabled" Color="#475569"/>
            
            <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#60A5FA"/>
            <SolidColorBrush x:Key="Brush.AccentSurface" Color="#1A3B82F6"/>
            
            <SolidColorBrush x:Key="Brush.Success" Color="#10B981"/>
            <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#1A10B981"/>
            <SolidColorBrush x:Key="Brush.Warning" Color="#F59E0B"/>
            <SolidColorBrush x:Key="Brush.Danger" Color="#EF4444"/>
            <SolidColorBrush x:Key="Brush.DangerSurface" Color="#1AEF4444"/>
            
            <SolidColorBrush x:Key="Brush.Download" Color="#38BDF8"/>
            <SolidColorBrush x:Key="Brush.Upload" Color="#A855F7"/>

            <!-- Sophisticated 8-Segment Chart Palette -->
            <SolidColorBrush x:Key="Brush.ChartSegment1" Color="#38BDF8"/> <!-- Electric Cyan -->
            <SolidColorBrush x:Key="Brush.ChartSegment2" Color="#A855F7"/> <!-- Sophisticated Violet -->
            <SolidColorBrush x:Key="Brush.ChartSegment3" Color="#6366F1"/> <!-- Indigo -->
            <SolidColorBrush x:Key="Brush.ChartSegment4" Color="#14B8A6"/> <!-- Teal -->
            <SolidColorBrush x:Key="Brush.ChartSegment5" Color="#F59E0B"/> <!-- Muted Amber -->
            <SolidColorBrush x:Key="Brush.ChartSegment6" Color="#3B82F6"/> <!-- Blue -->
            <SolidColorBrush x:Key="Brush.ChartSegment7" Color="#C084FC"/> <!-- Muted Purple / Lavender -->
            <SolidColorBrush x:Key="Brush.ChartSegment8" Color="#10B981"/> <!-- Emerald -->
            <SolidColorBrush x:Key="Brush.ChartSegmentOther" Color="#64748B"/> <!-- Slate / Muted Neutral -->

            <!-- FluentTheme System Overrides -->
            <SolidColorBrush x:Key="SystemRegionBrush" Color="#06080D"/>
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#06080D"/>
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlBackgroundChromeLowBrush" Color="#171D2B"/>
            <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#111520"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#94A3B8"/>
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#64748B"/>
        </ResourceDictionary>

        <!-- LIGHT THEME -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Brush.AppBackground" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="Brush.NavigationBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#CBD5E1"/>
            <SolidColorBrush x:Key="Brush.SurfaceMuted" Color="#F1F5F9"/>
            
            <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0"/>
            <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CBD5E1"/>
            
            <SolidColorBrush x:Key="Brush.TextPrimary" Color="#0F172A"/>
            <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569"/>
            <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B"/>
            <SolidColorBrush x:Key="Brush.TextDisabled" Color="#94A3B8"/>
            
            <SolidColorBrush x:Key="Brush.Accent" Color="#2563EB"/>
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#1D4ED8"/>
            <SolidColorBrush x:Key="Brush.AccentSurface" Color="#1A2563EB"/>
            
            <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
            <SolidColorBrush x:Key="Brush.SuccessSurface" Color="#1A059669"/>
            <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
            <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
            <SolidColorBrush x:Key="Brush.DangerSurface" Color="#1ADC2626"/>
            
            <SolidColorBrush x:Key="Brush.Download" Color="#0284C7"/>
            <SolidColorBrush x:Key="Brush.Upload" Color="#7C3AED"/>

            <!-- Sophisticated 8-Segment Chart Palette (Light theme tailored) -->
            <SolidColorBrush x:Key="Brush.ChartSegment1" Color="#0284C7"/> <!-- Cyan -->
            <SolidColorBrush x:Key="Brush.ChartSegment2" Color="#7C3AED"/> <!-- Violet -->
            <SolidColorBrush x:Key="Brush.ChartSegment3" Color="#4F46E5"/> <!-- Indigo -->
            <SolidColorBrush x:Key="Brush.ChartSegment4" Color="#0D9488"/> <!-- Teal -->
            <SolidColorBrush x:Key="Brush.ChartSegment5" Color="#D97706"/> <!-- Amber -->
            <SolidColorBrush x:Key="Brush.ChartSegment6" Color="#2563EB"/> <!-- Blue -->
            <SolidColorBrush x:Key="Brush.ChartSegment7" Color="#9333EA"/> <!-- Purple -->
            <SolidColorBrush x:Key="Brush.ChartSegment8" Color="#059669"/> <!-- Emerald -->
            <SolidColorBrush x:Key="Brush.ChartSegmentOther" Color="#64748B"/> <!-- Slate -->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
