<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <!-- Empty State Container -->
    <Style Selector="StackPanel.EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="{DynamicResource Spacing.LG}" />
        <Setter Property="Margin" Value="{DynamicResource Padding.Large}" />
    </Style>

    <Style Selector="TextBlock.EmptyStateIcon">
        <Setter Property="FontSize" Value="64" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.EmptyStateTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.EmptyStateDescription">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Skeleton Loading Block -->
    <Style Selector="Border.SkeletonBlock">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.5" />
            </Transitions>
        </Setter>
    </Style>
</Styles>
