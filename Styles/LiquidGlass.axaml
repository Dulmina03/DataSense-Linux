<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    DATASENSE TRUE LIQUID GLASS INTERACTION SYSTEM
    ==============================================
    Soft, translucent, glossy, reflective glass surface architecture.
    Provides physical glass depth, specular edge highlights, subtle inner glow,
    smooth material transitions, and dynamic theme/accent adaptation.
    -->

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 1. LIQUID GLASS SIDEBAR NAVIGATION RAIL                                   -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <Style Selector="Button.SidebarItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="Foreground" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <!-- SidebarItem: Hover (Translucent Reflective Glass Pill Emergence) -->
    <Style Selector="Button.SidebarItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- SidebarItem: Pressed State -->
    <Style Selector="Button.SidebarItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfacePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- SidebarItem: Active / Selected (Translucent Illuminated Glass Floating Pill) -->
    <Style Selector="Button.SidebarItem.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.ActiveNavGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderSelected}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.SidebarItem.active">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- SidebarItem: Active + Hover (Intensified Specular Reflection) -->
    <Style Selector="Button.SidebarItem.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.ActiveNavGradient}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 2. LIQUID GLASS SEGMENTED CONTAINER RAIL                                  -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <!-- Segmented Container Rail (Rounded Glass Trough) -->
    <Style Selector="Border.SegmentContainer">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.PillBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.PillBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #18000000" />
    </Style>

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 3. LIQUID GLASS PERIOD / SEGMENT BUTTONS (TODAY / 7 DAYS / MONTH)         -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <!-- Segmented / Period Button Base -->
    <Style Selector="Button.Segment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="Foreground" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Segment: Hover (Soft Glossy Specular Surface) -->
    <Style Selector="Button.Segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- Segment: Pressed State -->
    <Style Selector="Button.Segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfacePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- Segment: Active / Selected (Physical Floating Glass Pill with Accent Tint) -->
    <Style Selector="Button.Segment.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderSelected}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.Segment.active">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Segment: Active + Hover (Luminous Edge Reflection) -->
    <Style Selector="Button.Segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceSelectedHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 4. LIQUID GLASS STANDALONE BUTTONS & INTERACTIVE CONTROLS                 -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <!-- Standalone Liquid Glass Action Button -->
    <Style Selector="Button.LiquidGlass">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="Foreground" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.LiquidGlass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.LiquidGlass:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfacePressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
    </Style>
    <Style Selector="Button.LiquidGlass:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Liquid Glass Filter Pill Button -->
    <Style Selector="Button.FilterPill">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="Foreground" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.FilterPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style Selector="Button.FilterPill.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.FilterPill.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceSelectedHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBright}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 5. ACCESSIBILITY KEYBOARD FOCUS FOR LIQUID GLASS BUTTONS                  -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <!-- ────────────────────────────────────────────────────────────────────────── -->
    <!-- 4b. 3D WATER-DROP PERIOD SELECTOR BUTTONS (TODAY / 7 DAYS / MONTH)        -->
    <!--     Used exclusively in the Dashboard period analytics header              -->
    <!-- ────────────────────────────────────────────────────────────────────────── -->

    <!-- WaterDrop trough: TRANSPARENT background, only border + layered shadows  -->
    <!-- The dark PillBackground is NOT used here - we want clear glass            -->
    <Style Selector="Border.WaterDropContainer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#30FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="5,5" />
        <!-- 4-layer shadow: inner top glow, inner bottom shadow, outer ambient, secondary outer -->
        <Setter Property="BoxShadow" Value="inset 0 2 0 0 #45FFFFFF, inset 0 -3 8 0 #20000000, 0 8 32 0 #30000000, 0 2 8 0 #18000000" />
    </Style>

    <!-- WaterDropSegment Base: explicitly transparent so FluentTheme dark         -->
    <!-- background doesn't bleed through underneath our glass gradient            -->
    <Style Selector="Button.WaterDropSegment">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <!-- CRITICAL: Override Avalonia FluentTheme's :normal state which renders     -->
    <!-- its own dark ButtonNormalBackground through ContentPresenter. Without      -->
    <!-- this, all our transparent/gradient backgrounds sit on an opaque dark layer.-->
    <Style Selector="Button.WaterDropSegment:not(:pointerover):not(:pressed):not(.active) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.WaterDrop.Rest}" />
        <Setter Property="BorderBrush" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <!-- WaterDropSegment unselected content presenter — ghost glass whisper       -->
    <Style Selector="Button.WaterDropSegment /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.WaterDrop.Rest}" />
        <Setter Property="BorderBrush" Value="#18FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <!-- WaterDropSegment: Hover — specular band brightens, rim sharpens           -->
    <Style Selector="Button.WaterDropSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.WaterDrop.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WaterDrop.SpecularRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.WaterDropSegment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!-- WaterDropSegment: Pressed — squish inward feeling                         -->
    <Style Selector="Button.WaterDropSegment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfacePressed}" />
        <Setter Property="BorderBrush" Value="#35FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- WaterDropSegment: Active / Selected — full glass lens pill                -->
    <!--   Intense specular crown → clear glass body → concave inner shadow base   -->
    <!--   BorderThickness 1.5 = visible glass rim matching the reference image    -->
    <Style Selector="Button.WaterDropSegment.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.WaterDrop.Selected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.WaterDrop.SpecularRim}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.WaterDropSegment.active">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <!-- Depth: ContentPresenter gradient + glass rim border + container inner shadow -->
    </Style>

    <!-- WaterDropSegment: Active + Hover — specular crown blazes brighter         -->
    <Style Selector="Button.WaterDropSegment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Brush.WaterDrop.Selected}" />
        <Setter Property="BorderBrush" Value="#F0FFFFFF" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- Active + Hover: foreground stays TextPrimary from active style -->



    <Style Selector="Button.Segment:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.SidebarItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.LiquidGlass:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</Styles>
