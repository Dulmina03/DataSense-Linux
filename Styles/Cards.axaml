<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <!-- Base Panel / Glass Card -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #25000000" />
    </Style>

    <!-- Elevated Panel -->
    <Style Selector="Border.CardElevated">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 6 24 0 #2D000000" />
    </Style>

    <!-- Hero Panel (Large central focal point) -->
    <Style Selector="Border.CardHero">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Hero}" />
        <Setter Property="BoxShadow" Value="0 8 28 0 #30000000" />
    </Style>

    <!-- Interactive Panel -->
    <Style Selector="Border.CardInteractive">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #25000000" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.CardInteractive:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BoxShadow" Value="0 6 24 0 #35000000" />
    </Style>

    <!-- Status Cards -->
    <Style Selector="Border.CardSuccess">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.CardWarning">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.CardDanger">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #20000000" />
    </Style>

    <!-- NEW: Modern Analytics Surfaces -->
    <Style Selector="Border.HeroSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Hero}" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #30000000" />
    </Style>

    <Style Selector="Border.MetricSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Medium}" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.AnalyticsSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Large}" />
        <Setter Property="BoxShadow" Value="0 6 24 0 #28000000" />
    </Style>

    <!-- Status Pills and Indicators -->
    <Style Selector="Border.StatusPill">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    
    <!-- Legacy Badge Support -->
    <Style Selector="Border.Badge">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Ellipse.LiveIndicator">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <Style Selector="Border.HeroBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Process Analytics Table Row -->
    <Style Selector="Border.ProcessRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.ProcessRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
    </Style>
</Styles>
