<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        
    <!-- Base Panel / Glass Card -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 6 24 0 #25000000" />
    </Style>

    <!-- Elevated Panel -->
    <Style Selector="Border.CardElevated">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #30FFFFFF, 0 8 30 0 #30000000" />
    </Style>

    <!-- Hero Panel (Large central focal point) -->
    <Style Selector="Border.CardHero">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Hero}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #35FFFFFF, 0 12 36 0 #35000000" />
    </Style>

    <!-- Interactive Panel (Liquid Glass hover treatment) -->
    <Style Selector="Border.CardInteractive">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #22FFFFFF, 0 6 24 0 #25000000" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.22" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.CardInteractive:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #45FFFFFF, 0 10 32 0 #38000000, 0 0 16 0 #18A100FF" />
    </Style>

    <!-- Status Cards -->
    <Style Selector="Border.CardSuccess">
        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.CardWarning">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.CardDanger">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000" />
    </Style>

    <!-- NEW: Modern Analytics Surfaces -->
    <Style Selector="Border.HeroSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Hero}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #30FFFFFF, 0 10 36 0 #30000000" />
    </Style>

    <Style Selector="Border.MetricSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Medium}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 4 16 0 #20000000" />
    </Style>

    <Style Selector="Border.AnalyticsSurface">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="{DynamicResource Padding.Large}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #25FFFFFF, 0 8 28 0 #28000000" />
    </Style>

    <!-- Status Pills and Indicators -->
    <Style Selector="Border.StatusPill">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 2 8 0 #15000000" />
    </Style>
    
    <!-- Legacy Badge Support -->
    <Style Selector="Border.Badge">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #20FFFFFF, 0 2 8 0 #15000000" />
    </Style>

    <Style Selector="Ellipse.LiveIndicator">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
    </Style>
    
    <Style Selector="Border.HeroBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Process Analytics Table Row (Live Process Traffic) – Liquid Glass subtle hover -->
    <Style Selector="Border.ProcessRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.ProcessRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
    </Style>

    <!-- Application Historical Profile Row (Usage Breakdown) – Liquid Glass subtle hover -->
    <Style Selector="Border.AppRow">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Medium}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.AppRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brush.LiquidGlass.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LiquidGlass.BorderHover}" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #18FFFFFF, 0 4 12 0 #22000000" />
    </Style>
</Styles>
